                desc: 'Lv-00信任颜色实现',
                language: 'javascript',
                code: `const TrustColors = {
    GREEN: '#4caf50',           // TRUST_GREEN
    BLUE_UNEXPLORED: '#2196f3', // 未探索
    BLUE_RESOURCE: '#64b5f6',   // 资源受限
    BLUE_RANGE: '#90caf9',      // 超出范围
    GREEN_VERIFIED: '#66bb6a',  // 已证不可构造
    YELLOW: '#ffeb3b',          // 条件性不可构造
    LIGHT_ORANGE: '#ff9800',    // 非构造性oracle
    ORANGE_ORACLE: '#ffb74d',   // 爆炸原理
    AMBER: '#ffc107',           // 数值假设
    DARK_ORANGE: '#ff5722',     // 非构造性+数值假设
};

function getNodeColor(node) {
    switch (node.trustColor) {
        case 0: return TrustColors.GREEN;
        case 1: return TrustColors.BLUE_UNEXPLORED;
        case 2: return TrustColors.BLUE_RESOURCE;
        case 3: return TrustColors.BLUE_RANGE;
        case 4: return TrustColors.GREEN_VERIFIED;
        case 5: return TrustColors.YELLOW;
        case 6: return TrustColors.LIGHT_ORANGE;
        case 7: return TrustColors.ORANGE_ORACLE;
        case 8: return TrustColors.AMBER;
        case 9: return TrustColors.DARK_ORANGE;
        default: return '#9e9e9e';
    }
}`
            }
        ],
        snippets: [
            {
                id: 'c_memory',
                name: 'C内存管理',
                desc: 'Lv-00内存管理规范',
                language: 'c',
                code: `// Lv-00 内存管理规范

// 1. 创建后必须释放
SymbolicCoord* coord = symbolic_coord_create_rational(1, 2);
// ... 使用coord ...
symbolic_coord_destroy(coord);  // 必须释放

// 2. 图的创建和销毁
ConstraintGraph* graph = graph_create();
// ... 使用graph ...
graph_destroy(graph);

// 3. 字符串需要strdup后free
char* str = strdup("hello");
// ... 使用str ...
free(str);

// 4. 数组的分配
int* arr = malloc(n * sizeof(int));
// ... 使用arr ...
free(arr);`
            },
            {
                id: 'js_async',
                name: 'JS异步调用',
                desc: 'Promise风格的API调用',
                language: 'javascript',
                code: `// Promise风格
async function addPoint(x, y) {
    return new Promise((resolve, reject) => {
        try {
            const id = Module.ccall('web_graph_add_point', 'number',
                ['number', 'number', 'number', 'number', 'number'],
                [graphPtr, x, 1, y, 1]
            );
            resolve(id);
        } catch (err) {
            reject(err);
        }
    });
}

// 使用async/await
async function createTriangle() {
    try {
        const p1 = await addPoint(0, 0);
        const p2 = await addPoint(1, 0);
        const p3 = await addPoint(0.5, Math.sqrt(3)/2);
        const s1 = await addSegment(p1, p2);
        const s2 = await addSegment(p2, p3);
        const s3 = await addSegment(p3, p1);
        console.log('Triangle created!');
    } catch (err) {
        console.error('Failed:', err);
    }
}`
            }
        ]
    },

    currentCategory: 'wasm',
    currentTemplate: null,

    renderList() {
        const list = document.getElementById('templateList');
        const templates = this.registry[this.currentCategory] || [];

        list.innerHTML = templates.map(t =>
            '<div class="template-item" onclick="template.showDetail(\'' + t.id + '\')">' +
                '<div class="template-name">' + t.name + '</div>' +
                '<div class="template-desc">' + t.desc + '</div>' +
            '</div>'
        ).join('');
    },

    showDetail(id) {
        let tmpl = null;
        for (const category of Object.values(this.registry)) {
            tmpl = category.find(t => t.id === id);
            if (tmpl) break;
        }

        if (!tmpl) return;

        this.currentTemplate = tmpl;

        document.getElementById('previewTitle').textContent = tmpl.name;
        document.getElementById('previewCode').innerHTML = '<code>' + this._escapeHtml(tmpl.code) + '</code>';
        document.getElementById('templatePreview').style.display = 'block';
    },

    copyCode() {
        if (!this.currentTemplate) return;

        navigator.clipboard.writeText(this.currentTemplate.code).then(() => {
            if (typeof showStatus === 'function') showStatus('代码已复制到剪贴板');
        }).catch(() => {
            if (typeof showError === 'function') showError('复制失败');
        });
    },

    _escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

// ==================== APIReference 模块 ====================
const APIReference = {
    reference: {
        graph: [
            { name: 'graph_create', signature: 'ConstraintGraph* graph_create(void)', desc: '创建新的约束图' },
            { name: 'graph_destroy', signature: 'void graph_destroy(ConstraintGraph* g)', desc: '销毁约束图' },
            { name: 'graph_add_point', signature: 'AddNodeResult graph_add_point(ConstraintGraph *g, SymbolicCoord **coords, int coord_count)', desc: '添加点节点' },
            { name: 'graph_add_line_segment', signature: 'AddNodeResult graph_add_line_segment(ConstraintGraph *g, int p1, int p2)', desc: '添加线段' },
            { name: 'graph_add_region', signature: 'AddNodeResult graph_add_region(ConstraintGraph *g, int *boundary_points, int count)', desc: '添加区域' },
            { name: 'graph_normalize', signature: 'NormalizationResult* graph_normalize(ConstraintGraph *g, bool interactive)', desc: '归一化约束图' },
            { name: 'graph_get_node_count', signature: 'int graph_get_node_count(ConstraintGraph *g)', desc: '获取节点数量' },
            { name: 'graph_get_constraint_count', signature: 'int graph_get_constraint_count(ConstraintGraph *g)', desc: '获取约束数量' }
        ],
        constraint: [
            { name: 'graph_add_incidence', signature: 'AddConstraintResult graph_add_incidence(ConstraintGraph *g, int point_id, int line_id)', desc: '添加关联约束（点在直线上）' },
            { name: 'graph_add_betweenness', signature: 'AddConstraintResult graph_add_betweenness(ConstraintGraph *g, int p1, int p2, int p3)', desc: '添加之间约束（p2在p1和p3之间）' },
            { name: 'graph_add_intersection', signature: 'AddConstraintResult graph_add_intersection(ConstraintGraph *g, int line1_id, int line2_id, int point_id)', desc: '添加相交约束' },
            { name: 'graph_add_containment', signature: 'AddConstraintResult graph_add_containment(ConstraintGraph *g, int point_id, int region_id)', desc: '添加包含约束（点在区域内）' },
            { name: 'graph_add_connection', signature: 'AddConstraintResult graph_add_connection(ConstraintGraph *g, int node1_id, int node2_id)', desc: '添加连接约束' }
        ],
        coord: [
            { name: 'symbolic_coord_create_rational', signature: 'SymbolicCoord* symbolic_coord_create_rational(int64_t num, uint64_t den)', desc: '创建有理数坐标' },
            { name: 'symbolic_coord_create_algebraic', signature: 'SymbolicCoord* symbolic_coord_create_algebraic(...)', desc: '创建代数数坐标' },
            { name: 'symbolic_coord_equal', signature: 'bool symbolic_coord_equal(SymbolicCoord *a, SymbolicCoord *b)', desc: '判断两个坐标是否相等' },
            { name: 'symbolic_coord_serialize', signature: 'char* symbolic_coord_serialize(SymbolicCoord *coord)', desc: '序列化坐标为字符串' },
            { name: 'symbolic_coord_to_double', signature: 'double symbolic_coord_to_double(SymbolicCoord *coord)', desc: '转换为双精度浮点数' },
            { name: 'symbolic_coord_destroy', signature: 'void symbolic_coord_destroy(SymbolicCoord *coord)', desc: '释放坐标内存' }
        ],
        proof: [
            { name: 'proof_create_proposition', signature: 'Proposition* proof_create_proposition(const char *name)', desc: '创建命题' },
            { name: 'proof_set_pattern', signature: 'void proof_set_pattern(Proposition *prop, ConstraintGraph *pattern)', desc: '设置命题模式图' },
            { name: 'proof_unify', signature: 'UnifyResult proof_unify(ConstraintGraph *construction, Proposition *prop, bool strict)', desc: '合一检查' },
            { name: 'proof_step_forward', signature: 'ProofStepResult proof_step_forward(Proof *proof)', desc: '证明前进一步' },
            { name: 'proof_step_backward', signature: 'ProofStepResult proof_step_backward(Proof *proof)', desc: '证明后退一步' },
            { name: 'proof_export_latex', signature: 'char* proof_export_latex(Proof *proof)', desc: '导出为LaTeX' },
            { name: 'proof_export_coq', signature: 'char* proof_export_coq(Proof *proof)', desc: '导出为Coq脚本' }
        ],
        block: [
            { name: 'func_block_pack', signature: 'PackResult func_block_pack(ConstraintGraph *g, int *internal_nodes, int internal_count, int *input_ports, int input_count, int *output_ports, int output_count, ConstraintHandle *cross_boundary, int cross_count, FuncBlock **out_block)', desc: '打包函数块' },
            { name: 'func_block_instantiate', signature: 'InstantiateResult func_block_instantiate(ConstraintGraph *g, FuncBlock *block, int *arg_map, int arg_count)', desc: '例化函数块' },
            { name: 'func_block_compose', signature: 'ComposeResult func_block_compose(FuncBlock *f, FuncBlock *g, FuncBlock **out_composed)', desc: '组合函数块' },
            { name: 'func_block_product', signature: 'ProductResult func_block_product(FuncBlock *f, FuncBlock *g, FuncBlock **out_product)', desc: '函数块乘积' }
        ]
    },

    currentModule: 'graph',

    renderList() {
        const list = document.getElementById('apiList');
        const apis = this.reference[this.currentModule] || [];

        list.innerHTML = apis.map(api =>
            '<div class="api-item" onclick="api.showDetail(\'' + api.name + '\')">' +
                '<div class="api-name">' + api.name + '</div>' +
                '<div class="api-signature">' + api.signature + '</div>' +
                '<div class="api-desc">' + api.desc + '</div>' +
            '</div>'
        ).join('');
    },

    search(query) {
        if (!query) {
            this.renderList();
            return;
        }

        const lowerQuery = query.toLowerCase();
        const list = document.getElementById('apiList');

        let results = [];
        for (const [module, apis] of Object.entries(this.reference)) {
            const matched = apis.filter(api =>
                api.name.toLowerCase().includes(lowerQuery) ||
                api.desc.toLowerCase().includes(lowerQuery)
            );
            results.push(...matched.map(a => ({...a, module})));
        }

        list.innerHTML = results.map(api =>
            '<div class="api-item">' +
                '<div class="api-name">[' + api.module + '] ' + api.name + '</div>' +
                '<div class="api-signature">' + api.signature + '</div>' +
                '<div class="api-desc">' + api.desc + '</div>' +
            '</div>'
        ).join('');
    },

    showDetail(name) {
        let api = null;
        for (const apis of Object.values(this.reference)) {
            api = apis.find(a => a.name === name);
            if (api) break;
        }

        if (!api) return;

        const detail = '## ' + api.name + '\n\n**签名:**\n```c\n' + api.signature + '\n```\n\n**说明:** ' + api.desc + '\n\n参考 lv00.h 获取完整文档与参数约束。';

        AssistantEngine.addMessage('assistant', detail);
    }
};

// ==================== ConfigManager 模块 ====================
const ConfigManager = {
    save() {
        const provider = document.getElementById('aiProvider')?.value;
        const agent = document.getElementById('agentMode')?.value || AGENT_MODE_CODING;

        if (!provider) {
            const cfg = { provider: '', agent: agent, timestamp: Date.now() };
            localStorage.setItem('lv00_ai_config', JSON.stringify(cfg));
            this._updateStatus('本地模式', 'offline');
            this._showStatus('[OK] 已切换到本地模式（无需API密钥）', STATUS_OK);
            return;
        }

        let cfg = {
            provider: provider,
            agent: agent,
            timestamp: Date.now()
        };

        switch (provider) {
            case PROVIDER_DEEPSEEK:
                cfg.apiKey = document.getElementById('keyDeepSeek')?.value?.trim();
                cfg.model = document.getElementById('modelDeepSeek')?.value;
                cfg.baseUrl = 'https://api.deepseek.com';
                break;
            case PROVIDER_DASHSCOPE:
                cfg.apiKey = document.getElementById('keyDashScope')?.value?.trim();
                cfg.model = document.getElementById('modelDashScope')?.value;
                cfg.baseUrl = 'https://dashscope.aliyuncs.com/api/v1';
                break;
            case PROVIDER_OPENAI:
                cfg.apiKey = document.getElementById('keyOpenAI')?.value?.trim();
                cfg.model = document.getElementById('modelOpenAI')?.value;
                cfg.baseUrl = 'https://api.openai.com/v1';
                break;
            case PROVIDER_CUSTOM:
                cfg.apiKey = document.getElementById('keyCustom')?.value?.trim();
                cfg.model = document.getElementById('modelCustom')?.value?.trim();
                cfg.baseUrl = document.getElementById('customBaseUrl')?.value?.trim();
                break;
        }

        if (!cfg.apiKey) {
            this._showStatus('[ERROR] 请输入API密钥', STATUS_ERROR);
            return;
        }

        if (provider === PROVIDER_CUSTOM && !cfg.baseUrl) {
            this._showStatus('[ERROR] 请输入API Base URL', STATUS_ERROR);
            return;
        }

        localStorage.setItem('lv00_ai_config', JSON.stringify(cfg));

        this._showStatus('[OK] 设置已保存 (Agent: ' + agent + ')', STATUS_OK);
        this._updateStatus(provider.toUpperCase() + ' / ' + agent, 'online');

        console.log('[ConfigManager] API配置已保存:', provider, 'Agent:', agent);
    },

    load() {
        try {
            const saved = localStorage.getItem('lv00_ai_config');
            if (!saved) {
                this._updateStatus('本地模式', 'offline');
                return;
            }

            const cfg = JSON.parse(saved);

            if (cfg.agent) {
                const agentSelect = document.getElementById('agentMode');
                if (agentSelect) {
                    agentSelect.value = cfg.agent;
                    AssistantEngine.currentAgent = cfg.agent;
                }
            }

            const providerSelect = document.getElementById('aiProvider');
            if (providerSelect) {
                providerSelect.value = cfg.provider;
                this.onProviderChange();
            }

            switch (cfg.provider) {
                case PROVIDER_DEEPSEEK:
                    document.getElementById('keyDeepSeek').value = cfg.apiKey || '';
                    document.getElementById('modelDeepSeek').value = cfg.model || 'deepseek-coder';
                    break;
                case PROVIDER_DASHSCOPE:
                    document.getElementById('keyDashScope').value = cfg.apiKey || '';
                    document.getElementById('modelDashScope').value = cfg.model || 'qwen-coder-plus';
                    break;
                case PROVIDER_OPENAI:
                    document.getElementById('keyOpenAI').value = cfg.apiKey || '';
                    document.getElementById('modelOpenAI').value = cfg.model || 'gpt-4';
                    break;
                case PROVIDER_CUSTOM:
                    document.getElementById('keyCustom').value = cfg.apiKey || '';
                    document.getElementById('modelCustom').value = cfg.model || '';
                    document.getElementById('customBaseUrl').value = cfg.baseUrl || '';
                    break;
            }

            if (cfg.provider) {
                const agentLabel = cfg.agent || AGENT_MODE_CODING;
                this._updateStatus(cfg.provider.toUpperCase() + ' / ' + agentLabel, 'online');
            } else {
                this._updateStatus('本地模式', 'offline');
            }

            console.log('[ConfigManager] API配置已加载:', cfg.provider, 'Agent:', cfg.agent);

        } catch (err) {
            console.error('[ConfigManager] 加载配置失败:', err);
            this._updateStatus('本地模式', 'offline');
        }
    },

    clear() {
        localStorage.removeItem('lv00_ai_config');

        document.querySelectorAll('.provider-config input').forEach(input => {
            input.value = '';
        });

        document.getElementById('aiProvider').value = '';
        document.getElementById('agentMode').value = AGENT_MODE_CODING;
        AssistantEngine.currentAgent = AGENT_MODE_CODING;
        this.onProviderChange();

        this._updateStatus('本地模式', 'offline');
        this._showStatus('[OK] 配置已清除', STATUS_OK);

        console.log('[ConfigManager] API配置已清除');
    },

    async testConnection() {
        const provider = document.getElementById('aiProvider')?.value;

        if (!provider) {
            this._showStatus('[WARN] 请先选择AI提供商', STATUS_INFO);
            return;
        }

        this._showStatus('[...] 正在测试连接...', STATUS_INFO);
        this._updateStatus('测试中...', 'testing');

        const cfg = this.getAIConfig();
        if (!cfg || !cfg.apiKey) {
            this._showStatus('[ERROR] 请先输入API密钥', STATUS_ERROR);
            this._updateStatus('未配置', 'offline');
            return;
        }

        try {
            let baseUrl = cfg.baseUrl || '';
            let testUrl = baseUrl.replace(/\/+$/, '') + '/models';

            const response = await fetch(testUrl, {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + cfg.apiKey,
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                this._showStatus('[OK] 连接成功，API配置有效', STATUS_OK);
                this._updateStatus(provider.toUpperCase() + ' 已连接', 'online');
            } else {
                this._showStatus('[ERROR] 连接失败 (HTTP ' + response.status + ')，请检查密钥和网络', STATUS_ERROR);
                this._updateStatus('连接失败', 'offline');
            }

        } catch (err) {
            console.error('[ConfigManager] 测试连接失败:', err);
            this._showStatus('[ERROR] 连接错误: ' + err.message, STATUS_ERROR);
            this._updateStatus('连接错误', 'offline');
        }
    },

    exportData() {
        const cfg = this.getAIConfig();
        const exportData = {
            _meta: {
                version: '2.0',
                exportTime: new Date().toISOString(),
                application: 'Lv-00 Coding Assistant'
            },
            provider: cfg ? cfg.provider : '',
            agent: AssistantEngine.currentAgent,
            apiKey: cfg ? cfg.apiKey : '',
            model: cfg ? cfg.model : '',
            baseUrl: cfg ? cfg.baseUrl : ''
        };

        const json = JSON.stringify(exportData, null, 2);
        const blob = new Blob([json], { type: 'application/json;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'lv00-ai-config-' + new Date().toISOString().slice(0, 10) + '.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        this._showStatus('[OK] 配置已导出为JSON', STATUS_OK);
    },

    importData() {
        document.getElementById('configFileInput').click();
    },

    handleImport(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const data = JSON.parse(e.target.result);

                if (!data._meta || data._meta.application !== 'Lv-00 Coding Assistant') {
                    this._showStatus('[ERROR] 无效的配置文件格式', STATUS_ERROR);
                    return;
                }

                if (data.agent) {
                    const agentSelect = document.getElementById('agentMode');
                    if (agentSelect) {
                        agentSelect.value = data.agent;
                        AssistantEngine.currentAgent = data.agent;
                    }
                }

                if (data.provider) {
                    const providerSelect = document.getElementById('aiProvider');
                    if (providerSelect) {
                        providerSelect.value = data.provider;
                        this.onProviderChange();
                    }

                    switch (data.provider) {
                        case PROVIDER_DEEPSEEK:
                            if (data.apiKey) document.getElementById('keyDeepSeek').value = data.apiKey;
                            if (data.model) document.getElementById('modelDeepSeek').value = data.model;
                            break;
                        case PROVIDER_DASHSCOPE:
                            if (data.apiKey) document.getElementById('keyDashScope').value = data.apiKey;
                            if (data.model) document.getElementById('modelDashScope').value = data.model;
                            break;
                        case PROVIDER_OPENAI:
                            if (data.apiKey) document.getElementById('keyOpenAI').value = data.apiKey;
                            if (data.model) document.getElementById('modelOpenAI').value = data.model;
                            break;
                        case PROVIDER_CUSTOM:
                            if (data.apiKey) document.getElementById('keyCustom').value = data.apiKey;
                            if (data.model) document.getElementById('modelCustom').value = data.model;
                            if (data.baseUrl) document.getElementById('customBaseUrl').value = data.baseUrl;
                            break;
                    }
                }

                this.save();
                this._showStatus('[OK] 配置已从文件导入并保存', STATUS_OK);

            } catch (err) {
                console.error('[ConfigManager] 导入配置失败:', err);
                this._showStatus('[ERROR] 配置文件解析失败: ' + err.message, STATUS_ERROR);
            }
        };

        reader.readAsText(file);
        event.target.value = '';
    },

    getAIConfig() {
        try {
            const saved = localStorage.getItem('lv00_ai_config');
            return saved ? JSON.parse(saved) : null;
        } catch (err) {
            return null;
        }
    },

    toggleSettings() {
        const settings = document.getElementById('apiSettings');
        if (settings) {
            const isVisible = settings.style.display !== 'none';
            settings.style.display = isVisible ? 'none' : 'block';
        }
    },

    onProviderChange() {
        const provider = document.getElementById('aiProvider')?.value;

        document.querySelectorAll('.provider-config').forEach(el => {
            el.style.display = 'none';
        });

        if (provider) {
            const configEl = document.getElementById('config' + provider.charAt(0).toUpperCase() + provider.slice(1));
            if (configEl) {
                configEl.style.display = 'block';
            }
        }
    },

    toggleKeyVisibility(inputId) {
        const input = document.getElementById(inputId);
        if (input) {
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    },

    _showStatus(message, type) {
        const statusEl = document.getElementById('settingsStatus');
        if (statusEl) {
            statusEl.textContent = message;
            statusEl.className = 'settings-status ' + type;

            setTimeout(() => {
                statusEl.className = 'settings-status';
            }, 5000);
        }
    },

    _updateStatus(text, state) {
        const summary = document.getElementById('apiStatusSummary');
        if (summary) {
            const indicator = summary.querySelector('.status-indicator');
            const textEl = summary.querySelector('.status-text');

            if (indicator) {
                indicator.className = 'status-indicator ' + state;
            }
            if (textEl) {
                textEl.textContent = text;
                textEl.className = 'status-text ' + (state === 'online' ? 'connected' : '');
            }
        }
    }
};

// ==================== CodeAnalyzer 模块 ====================
const CodeAnalyzer = {
    _lastReviewReport: null,

    analyzeCode() {
        const code = document.getElementById('reviewCodeInput')?.value;
        const fileName = document.getElementById('reviewFileName')?.value?.trim() || '';

        if (!code || code.trim().length === 0) {
            config._showStatus('[ERROR] 请输入需要审查的代码', STATUS_ERROR);
            return;
        }

        const report = this._performAnalysis(code, fileName);
        this._displayReport(report);
    },

    _performAnalysis(code, fileName) {
        const lines = code.split('\n');
        const totalLines = lines.length;

        const language = this._detectLanguage(fileName, code);

        let codeLines = 0;
        let commentLines = 0;
        let blankLines = 0;
        let inBlockComment = false;

        for (const line of lines) {
            const trimmed = line.trim();

            if (trimmed.length === 0) {
                blankLines++;
                continue;
            }

            if (inBlockComment) {
                commentLines++;
                if (trimmed.includes('*/')) {
                    inBlockComment = false;
                }
                continue;
            }

            if (trimmed.startsWith('/*')) {
                commentLines++;
                if (!trimmed.includes('*/')) {
                    inBlockComment = true;
                }
                continue;
            }

            if (trimmed.startsWith('//') || trimmed.startsWith('#') || trimmed.startsWith('--')) {
                commentLines++;
                continue;
            }

            codeLines++;
        }

        const issues = this._detectIssues(lines, language);
        const score = this._calculateScore(issues, totalLines, commentLines);

        return {
            language: language,
            totalLines: totalLines,
            codeLines: codeLines,
            commentLines: commentLines,
            blankLines: blankLines,
            issues: issues,
            score: score,
            commentRatio: ((commentLines / totalLines) * 100).toFixed(1)
        };
    },

    _detectIssues(lines, language) {
        const issues = [];

        const secretPatterns = [
            { pattern: /(?:api[_-]?key|password|secret|token|auth)\s*[:=]\s*['"][^'"]{8,}/i, severity: 'critical', desc: '硬编码密钥/凭据' },
            { pattern: /sk-[a-zA-Z0-9]{20,}/, severity: 'critical', desc: '硬编码API密钥 (sk-前缀)' },
            { pattern: /Bearer\s+[a-zA-Z0-9._-]{20,}/, severity: 'critical', desc: '硬编码Bearer令牌' }
        ];

        lines.forEach((line, index) => {
            for (const sp of secretPatterns) {
                if (sp.pattern.test(line)) {
                    issues.push({
                        severity: sp.severity,
                        line: index + 1,
                        desc: sp.desc,
                        snippet: line.trim().substring(0, 80)
                    });
                }
            }
        });

        const todoPatterns = [
            { pattern: /TODO/i, severity: 'info', desc: 'TODO注释 -- 待办事项未完成' },
            { pattern: /FIXME/i, severity: 'warning', desc: 'FIXME注释 -- 已知问题待修复' },
            { pattern: /HACK/i, severity: 'warning', desc: 'HACK注释 -- 临时方案需重构' },
            { pattern: /XXX/i, severity: 'warning', desc: 'XXX注释 -- 需要关注的问题' }
        ];

        lines.forEach((line, index) => {
            for (const tp of todoPatterns) {
                if (tp.pattern.test(line)) {
                    issues.push({
                        severity: tp.severity,
                        line: index + 1,
                        desc: tp.desc,
                        snippet: line.trim().substring(0, 80)
                    });
                }
            }
        });

        lines.forEach((line, index) => {
            if (line.length > 120) {
                issues.push({
                    severity: 'info',
                    line: index + 1,
                    desc: '行过长 (' + line.length + ' 字符，建议不超过120)',
                    snippet: line.trim().substring(0, 60) + '...'
                });
            }
        });

        if (language === 'c' || language === 'cpp') {
            lines.forEach((line, index) => {
                if (/malloc|calloc|realloc/.test(line) && !/free/.test(lines[index] || '')) {
                    let hasFree = false;
                    for (let j = index + 1; j < Math.min(index + 6, lines.length); j++) {
                        if (/free\s*\(/.test(lines[j])) {
                            hasFree = true;
                            break;
                        }
                    }
                    if (!hasFree) {
                        issues.push({
                            severity: 'warning',
                            line: index + 1,
                            desc: '可能的内存泄漏: malloc/calloc/realloc 后未在附近发现 free()',
                            snippet: line.trim().substring(0, 80)
                        });
                    }
                }

                if (/=\s*(?:malloc|calloc|realloc|fopen)\s*\(/.test(line) && !/if\s*\(/.test(lines[Math.max(0, index - 1)] || '')) {
                    issues.push({
                        severity: 'warning',
                        line: index + 1,
                        desc: '未检查分配函数的返回值（可能为NULL）',
                        snippet: line.trim().substring(0, 80)
                    });
                }
            });
        }

        if (language === 'javascript' || language === 'typescript') {
            lines.forEach((line, index) => {
                if (/\bvar\s+/.test(line)) {
                    issues.push({
                        severity: 'info',
                        line: index + 1,
                        desc: '建议使用 const/let 替代 var',
                        snippet: line.trim().substring(0, 80)
                    });
                }

                if (/\beval\s*\(/.test(line)) {
                    issues.push({
                        severity: 'critical',
                        line: index + 1,
                        desc: '使用 eval() 存在安全风险',
                        snippet: line.trim().substring(0, 80)
                    });
                }

                if (/[^=!]==[^=]/.test(line) && !/===/.test(line)) {
                    issues.push({
                        severity: 'info',
                        line: index + 1,
                        desc: '建议使用 === 代替 == 进行严格比较',
                        snippet: line.trim().substring(0, 80)
                    });
                }
            });
        }

        const severityOrder = { critical: 0, warning: 1, info: 2 };
        issues.sort((a, b) => severityOrder[a.severity] - severityOrder[b.severity]);

        return issues;
    },

    _calculateScore(issues, totalLines, commentLines) {
        let score = 100;
        score -= issues.filter(i => i.severity === 'critical').length * 20;
        score -= issues.filter(i => i.severity === 'warning').length * 10;
        score -= issues.filter(i => i.severity === 'info').length * 3;

        const commentRatio = totalLines > 0 ? commentLines / totalLines : 0;
        if (commentRatio > 0.1 && commentRatio < 0.4) {
            score = Math.min(100, score + 5);
        }

        return Math.max(0, Math.min(100, score));
    },

    _detectLanguage(fileName, code) {
        const extMap = {
            '.c': 'c', '.h': 'c',
            '.cpp': 'cpp', '.cc': 'cpp', '.cxx': 'cpp', '.hpp': 'cpp', '.hxx': 'cpp',
            '.js': 'javascript', '.mjs': 'javascript', '.cjs': 'javascript',
            '.ts': 'typescript', '.tsx': 'typescript',
            '.py': 'python',
            '.java': 'java',
            '.rs': 'rust',
            '.go': 'go',
            '.html': 'html', '.htm': 'html',
            '.css': 'css', '.scss': 'css', '.less': 'css',
            '.json': 'json',
            '.md': 'markdown',
            '.sh': 'shell', '.bash': 'shell',
            '.sql': 'sql'
        };

        if (fileName) {
            const dotIndex = fileName.lastIndexOf('.');
            if (dotIndex !== -1) {
                const ext = fileName.substring(dotIndex).toLowerCase();
                if (extMap[ext]) return extMap[ext];
            }
        }

        if (/#include\s*[<"]/.test(code) || /EMSCRIPTEN_KEEPALIVE/.test(code)) return 'c';
        if (/function\s+\w+\s*\(/.test(code) && /const\s+\w+\s*=/.test(code) && !/#include/.test(code)) return 'javascript';
        if (/def\s+\w+\s*\(/.test(code) && /import\s+\w+/.test(code)) return 'python';
        if (/fn\s+\w+\s*</.test(code) || /let\s+mut\s+/.test(code)) return 'rust';
        if (/func\s+\w+\s*\(/.test(code) && /package\s+\w+/.test(code)) return 'go';
        if (/public\s+class\s+/.test(code) || /System\.out\.print/.test(code)) return 'java';

        return 'unknown';
    },

    _displayReport(report) {
        const resultEl = document.getElementById('reviewResult');
        resultEl.style.display = 'block';

        let scoreColor = '#4caf50';
        let scoreLabel = '优秀';
        if (report.score < 60) { scoreColor = '#ff4444'; scoreLabel = '需改进'; }
        else if (report.score < 80) { scoreColor = '#ff9800'; scoreLabel = '一般'; }
        else if (report.score < 90) { scoreColor = '#ffeb3b'; scoreLabel = '良好'; }

        document.getElementById('reviewScore').innerHTML =
            '<span style="color:' + scoreColor + ';">' + report.score + '</span>' +
            '<span style="font-size:12px;color:#888;margin-left:8px;">/ 100 (' + scoreLabel + ')</span>';

        document.getElementById('reviewStats').innerHTML =
            '<div class="stat-line"><span>语言</span><span>' + report.language + '</span></div>' +
            '<div class="stat-line"><span>总行数</span><span>' + report.totalLines + '</span></div>' +
            '<div class="stat-line"><span>代码行</span><span>' + report.codeLines + '</span></div>' +
            '<div class="stat-line"><span>注释行</span><span>' + report.commentLines + ' (' + report.commentRatio + '%)</span></div>' +
            '<div class="stat-line"><span>空行</span><span>' + report.blankLines + '</span></div>' +
            '<div class="stat-line"><span>发现问题</span><span>' + report.issues.length + '</span></div>';

        const issuesEl = document.getElementById('reviewIssues');
        if (report.issues.length === 0) {
            issuesEl.innerHTML = '<div style="color:#4caf50;font-size:11px;padding:8px;">[OK] 未发现明显问题</div>';
        } else {
            issuesEl.innerHTML = report.issues.map(issue =>
                '<div class="issue-item ' + issue.severity + '">' +
                    '<div>[' + issue.severity.toUpperCase() + '] ' + issue.desc + '</div>' +
                    '<div class="issue-line">Line ' + issue.line + ': ' + this._escapeHtml(issue.snippet) + '</div>' +
                '</div>'
            ).join('');
        }

        this._lastReviewReport = report;
    },

    copyReviewReport() {
        if (!this._lastReviewReport) return;

        const r = this._lastReviewReport;
        let md = '# 代码审查报告\n\n';
        md += '## 概要\n\n';
        md += '- 语言: ' + r.language + '\n';
        md += '- 质量评分: ' + r.score + ' / 100\n';
        md += '- 总行数: ' + r.totalLines + '\n';
        md += '- 代码行: ' + r.codeLines + '\n';
        md += '- 注释行: ' + r.commentLines + ' (' + r.commentRatio + '%)\n';
        md += '- 空行: ' + r.blankLines + '\n';
        md += '- 发现问题: ' + r.issues.length + '\n\n';

        if (r.issues.length > 0) {
            md += '## 问题列表\n\n';
            r.issues.forEach((issue, i) => {
                md += '### ' + (i + 1) + '. [' + issue.severity.toUpperCase() + '] ' + issue.desc + '\n\n';
                md += '- 行号: ' + issue.line + '\n';
                md += '- 代码: `' + issue.snippet + '`\n\n';
            });
        } else {
            md += '## 结论\n\n[OK] 未发现明显问题。\n';
        }

        navigator.clipboard.writeText(md).then(() => {
            if (typeof showStatus === 'function') showStatus('审查报告已复制到剪贴板');
        }).catch(() => {
            if (typeof showError === 'function') showError('复制失败');
        });
    },

    clearReview() {
        document.getElementById('reviewCodeInput').value = '';
        document.getElementById('reviewFileName').value = '';
        document.getElementById('reviewResult').style.display = 'none';
        this._lastReviewReport = null;
    },

    _escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

// ==================== HistoryTracker 模块 ====================
const HistoryTracker = {
    renderStats() {
        const rounds = Math.floor(AssistantEngine.chatHistory.filter(h => h.role === 'user').length);
        const totalWords = AssistantEngine.chatHistory.reduce((sum, h) => sum + (h.content ? h.content.length : 0), 0);

        document.getElementById('statRounds').textContent = rounds;
        document.getElementById('statWords').textContent = totalWords;
        document.getElementById('statAI').textContent = AssistantEngine.aiReplyCount;
        document.getElementById('statLocal').textContent = AssistantEngine.localReplyCount;

        const timelineEl = document.getElementById('historyTimeline');
        if (AssistantEngine.chatHistory.length === 0) {
            timelineEl.innerHTML = '<div class="history-empty">暂无对话记录</div>';
            return;
        }

        const userMessages = AssistantEngine.chatHistory.filter(h => h.role === 'user');
        const timelineHtml = userMessages.slice().reverse().map(um => {
            const time = um.timestamp ? new Date(um.timestamp) : null;
            const timeStr = time ? time.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '--:--:--';

            const umIndex = AssistantEngine.chatHistory.indexOf(um);
            const reply = umIndex < AssistantEngine.chatHistory.length - 1 ? AssistantEngine.chatHistory[umIndex + 1] : null;
            const sourceClass = reply && reply.source === 'ai' ? 'ai' : 'local';
            const sourceLabel = reply && reply.source === 'ai' ? 'AI' : 'LOCAL';

            return '<div class="history-item ' + sourceClass + '">' +
                '<div class="history-time">' + timeStr + ' [' + sourceLabel + ']</div>' +
                '<div class="history-text">' + this._escapeHtml(um.content.substring(0, 60)) + (um.content.length > 60 ? '...' : '') + '</div>' +
            '</div>';
        }).join('');

        timelineEl.innerHTML = timelineHtml;
    },

    exportData() {
        if (AssistantEngine.chatHistory.length === 0) {
            config._showStatus('[WARN] 暂无对话记录可导出', STATUS_INFO);
            return;
        }

        let md = '# Lv-00 对话记录导出\n\n';
        md += '导出时间: ' + new Date().toLocaleString('zh-CN') + '\n';
        md += '总消息数: ' + AssistantEngine.chatHistory.length + '\n';
        md += 'AI回复: ' + AssistantEngine.aiReplyCount + ' | 本地回复: ' + AssistantEngine.localReplyCount + '\n\n---\n\n';

        for (const msg of AssistantEngine.chatHistory) {
            const time = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString('zh-CN') : '';
            const source = msg.source || (msg.role === 'user' ? 'user' : 'local');
            const prefix = msg.role === 'user' ? '**[USER]**' : '**[' + source.toUpperCase() + ']**';

            md += prefix + ' (' + time + ')\n\n';
            md += msg.content + '\n\n---\n\n';
        }

        const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'lv00-chat-history-' + new Date().toISOString().slice(0, 10) + '.md';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        config._showStatus('[OK] 对话记录已导出为Markdown', STATUS_OK);
    },

    clearHistory() {
        AssistantEngine.chatHistory = [];
        AssistantEngine.aiReplyCount = 0;
        AssistantEngine.localReplyCount = 0;

        const chat = document.getElementById('assistantChat');
        const systemMsg = chat.querySelector('.chat-message.system');
        chat.innerHTML = '';
        if (systemMsg) chat.appendChild(systemMsg);

        this.renderStats();
        config._showStatus('[OK] 对话历史已清除', STATUS_OK);
    },

    _escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

// ==================== 全局命名空间 ====================
window.lv00Assistant = {
    // 核心引擎
    engine: AssistantEngine,
    // 子模块
    template: TemplateRegistry,
    api: APIReference,
    config: ConfigManager,
    analyzer: CodeAnalyzer,
    history: HistoryTracker,
    math: MathEngine,
    // 快捷方法代理
    sendMessage: (...args) => AssistantEngine.sendMessage(...args),
    quickQuery: (...args) => AssistantEngine.quickQuery(...args),
    addMessage: (...args) => AssistantEngine.addMessage(...args)
};

// ==================== 模块别名（向后兼容） ====================
const assistant = AssistantEngine;
const template = TemplateRegistry;
const api = APIReference;
const config = ConfigManager;
const analyzer = CodeAnalyzer;
const history = HistoryTracker;

// ==================== 初始化 ====================
AssistantEngine.init();
</script>
