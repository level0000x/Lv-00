<!-- Lv-00 编程助手面板 v2.0 -->
<!-- 集成到主界面的助手模块 -->
<!-- 融合: 统一LLM调用层 / SSE流式输出 / 代码审查 / 对话历史分析 / 多Agent模式 / 增强配置管理 -->

<div id="panelAssistant" class="module-panel panel-hidden">
    <!-- AI对话面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>[AI] 编程助手</span>
            <span style="font-size:10px;color:#666;">Lv-00 Coding Assistant v2.0</span>
        </div>

        <!-- 对话历史 -->
        <div id="assistantChat" class="chat-container">
            <div class="chat-message system">
                <div class="message-content">
                    Lv-00 编程辅助系统 v2.0<br>
                    Technical Note: 本系统为Lv-00符号几何引擎的编程辅助接口，提供以下功能域：<br>
                    &nbsp;&nbsp;1. WebAssembly绑定层开发 (lv00_web_bindings.c)<br>
                    &nbsp;&nbsp;2. Canvas 2D几何渲染器实现<br>
                    &nbsp;&nbsp;3. 核心API查询与交叉引用<br>
                    &nbsp;&nbsp;4. 形式化概念解析（符号坐标、约束图、归一化、合一检查）<br>
                    &nbsp;&nbsp;5. 代码审查与质量分析<br>
                    &nbsp;&nbsp;6. 多Agent模式（编程/审查/解释）<br>
                    <br>
                    请输入技术问题以开始交互。
                </div>
            </div>
        </div>

        <!-- 输入区域 -->
        <div class="chat-input-area">
            <textarea id="assistantInput" class="chat-input"
                placeholder="输入技术问题，例如：graph_normalize的幂等性证明策略"
                rows="2"></textarea>
            <button id="btnAssistantSend" class="btn btn-accent" style="margin-top:8px;width:100%;">
                发送 / Send
            </button>
        </div>

        <!-- 快捷操作 -->
        <div class="quick-actions">
            <button class="btn btn-sm" onclick="lv00Assistant.quickQuery('binding')">
                [Code] 生成绑定
            </button>
            <button class="btn btn-sm" onclick="lv00Assistant.quickQuery('renderer')">
                [Render] 渲染器
            </button>
            <button class="btn btn-sm" onclick="lv00Assistant.quickQuery('api')">
                [Ref] API查询
            </button>
            <button class="btn btn-sm" onclick="lv00Assistant.quickQuery('explain')">
                [Info] 解释概念
            </button>
            <button class="btn btn-sm" onclick="lv00Assistant.quickQuery('math')">
                [Math] 数学计算
            </button>
        </div>
    </div>

    <!-- 代码模板面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>代码模板</span>
            <span style="font-size:10px;color:#666;">Code Templates</span>
        </div>

        <div class="template-categories">
            <div class="category-tabs">
                <button class="category-tab active" data-category="wasm">WASM绑定</button>
                <button class="category-tab" data-category="canvas">Canvas</button>
                <button class="category-tab" data-category="ui">UI组件</button>
                <button class="category-tab" data-category="snippets">片段</button>
            </div>

            <div id="templateList" class="template-list">
                <!-- 动态生成 -->
            </div>
        </div>

        <!-- 模板预览 -->
        <div id="templatePreview" class="template-preview" style="display:none;">
            <div class="preview-header">
                <span id="previewTitle">模板标题</span>
                <button class="btn btn-sm" onclick="template.copyCode()">Copy</button>
            </div>
            <pre id="previewCode" class="code-preview"><code></code></pre>
        </div>
    </div>

    <!-- API参考面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>API参考</span>
            <span style="font-size:10px;color:#666;">API Reference</span>
        </div>

        <div class="api-search">
            <input type="text" id="apiSearchInput" class="input-field"
                placeholder="搜索API..." oninput="api.search(this.value)">
        </div>

        <div class="api-modules">
            <button class="api-module-btn active" data-module="graph">Graph</button>
            <button class="api-module-btn" data-module="constraint">Constraint</button>
            <button class="api-module-btn" data-module="coord">Coord</button>
            <button class="api-module-btn" data-module="proof">Proof</button>
            <button class="api-module-btn" data-module="block">Block</button>
        </div>

        <div id="apiList" class="api-list">
            <!-- 动态生成 -->
        </div>
    </div>

    <!-- 代码审查面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>代码审查</span>
            <span style="font-size:10px;color:#666;">Code Review</span>
        </div>

        <div class="review-input-area">
            <div class="setting-row">
                <label>文件名（可选，用于语言检测）</label>
                <input type="text" id="reviewFileName" class="input-field"
                    placeholder="example.c / main.js / style.css">
            </div>
            <div class="setting-row">
                <label>粘贴代码</label>
                <textarea id="reviewCodeInput" class="chat-input"
                    placeholder="在此粘贴需要审查的代码..."
                    rows="8"></textarea>
            </div>
            <div class="setting-actions">
                <button class="btn btn-accent" onclick="analyzer.analyzeCode()" style="flex:2;">
                    分析 / Analyze
                </button>
                <button class="btn" onclick="analyzer.clearReview()">
                    Clear
                </button>
            </div>
        </div>

        <!-- 审查结果 -->
        <div id="reviewResult" class="review-result" style="display:none;">
            <div class="review-header">
                <span>审查报告</span>
                <button class="btn btn-sm" onclick="analyzer.copyReviewReport()">Copy Report</button>
            </div>
            <div id="reviewScore" class="review-score"></div>
            <div id="reviewStats" class="review-stats"></div>
            <div id="reviewIssues" class="review-issues"></div>
        </div>
    </div>

    <!-- 对话历史面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>对话历史</span>
            <span style="font-size:10px;color:#666;">Chat History</span>
        </div>

        <div id="historyStats" class="history-stats">
            <div class="stat-row">
                <span class="stat-label">总对话轮数</span>
                <span id="statRounds" class="stat-value">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">总消息字数</span>
                <span id="statWords" class="stat-value">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">AI回复</span>
                <span id="statAI" class="stat-value">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">本地回复</span>
                <span id="statLocal" class="stat-value">0</span>
            </div>
        </div>

        <div id="historyTimeline" class="history-timeline">
            <div class="history-empty">暂无对话记录</div>
        </div>

        <div class="setting-actions" style="margin-top:8px;">
            <button class="btn btn-accent" onclick="history.exportData()" style="flex:2;">
                导出 Markdown
            </button>
            <button class="btn btn-danger" onclick="history.clearHistory()">
                清除历史
            </button>
        </div>
    </div>

    <!-- API密钥配置面板 -->
    <div class="panel">
        <div class="panel-title">
            <span>API配置</span>
            <span style="font-size:10px;color:#666;">API Settings</span>
            <button class="btn btn-sm" onclick="config.toggleSettings()" style="margin-left:auto;">
                Settings
            </button>
        </div>

        <div id="apiSettings" class="api-settings">
            <!-- Agent选择 -->
            <div class="setting-row">
                <label>Agent模式 / Agent Mode</label>
                <select id="agentMode" class="input-field" onchange="assistant.onAgentChange()">
                    <option value="coding-agent">coding-agent -- 编程助手（默认）</option>
                    <option value="review-agent">review-agent -- 代码审查员</option>
                    <option value="explain-agent">explain-agent -- 概念解释器</option>
                </select>
            </div>

            <!-- 提供商选择 -->
            <div class="setting-row">
                <label>AI提供商 / Provider</label>
                <select id="aiProvider" class="input-field" onchange="config.onProviderChange()">
                    <option value="">本地模式 (无需密钥)</option>
                    <option value="deepseek">DeepSeek (推荐)</option>
                    <option value="dashscope">阿里云 DashScope</option>
                    <option value="openai">OpenAI</option>
                    <option value="custom">自定义</option>
                </select>
            </div>

            <!-- DeepSeek配置 -->
            <div id="configDeepSeek" class="provider-config" style="display:none;">
                <div class="setting-row">
                    <label>DeepSeek API Key</label>
                    <div class="input-with-btn">
                        <input type="password" id="keyDeepSeek" class="input-field"
                            placeholder="sk-xxxxxxxxxxxxxxxx">
                        <button class="btn btn-sm" onclick="config.toggleKeyVisibility('keyDeepSeek')">Show</button>
                    </div>
                    <span class="setting-hint">获取地址: platform.deepseek.com</span>
                </div>
                <div class="setting-row">
                    <label>模型 / Model</label>
                    <select id="modelDeepSeek" class="input-field">
                        <option value="deepseek-coder">deepseek-coder (推荐)</option>
                        <option value="deepseek-chat">deepseek-chat</option>
                    </select>
                </div>
            </div>

            <!-- DashScope配置 -->
            <div id="configDashScope" class="provider-config" style="display:none;">
                <div class="setting-row">
                    <label>DashScope API Key</label>
                    <div class="input-with-btn">
                        <input type="password" id="keyDashScope" class="input-field"
                            placeholder="sk-xxxxxxxxxxxxxxxx">
                        <button class="btn btn-sm" onclick="config.toggleKeyVisibility('keyDashScope')">Show</button>
                    </div>
                    <span class="setting-hint">获取地址: dashscope.aliyun.com</span>
                </div>
                <div class="setting-row">
                    <label>模型 / Model</label>
                    <select id="modelDashScope" class="input-field">
                        <option value="qwen-coder-plus">qwen-coder-plus (推荐)</option>
                        <option value="qwen-coder-turbo">qwen-coder-turbo</option>
                        <option value="qwen-max">qwen-max</option>
                    </select>
                </div>
            </div>

            <!-- OpenAI配置 -->
            <div id="configOpenAI" class="provider-config" style="display:none;">
                <div class="setting-row">
                    <label>OpenAI API Key</label>
                    <div class="input-with-btn">
                        <input type="password" id="keyOpenAI" class="input-field"
                            placeholder="sk-xxxxxxxxxxxxxxxx">
                        <button class="btn btn-sm" onclick="config.toggleKeyVisibility('keyOpenAI')">Show</button>
                    </div>
                    <span class="setting-hint">获取地址: platform.openai.com</span>
                </div>
                <div class="setting-row">
                    <label>模型 / Model</label>
                    <select id="modelOpenAI" class="input-field">
                        <option value="gpt-4">GPT-4</option>
                        <option value="gpt-4-turbo">GPT-4 Turbo</option>
                        <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
                    </select>
                </div>
            </div>

            <!-- 自定义配置 -->
            <div id="configCustom" class="provider-config" style="display:none;">
                <div class="setting-row">
                    <label>API Base URL</label>
                    <input type="text" id="customBaseUrl" class="input-field"
                        placeholder="https://api.example.com/v1">
                </div>
                <div class="setting-row">
                    <label>API Key</label>
                    <div class="input-with-btn">
                        <input type="password" id="keyCustom" class="input-field"
                            placeholder="your-api-key">
                        <button class="btn btn-sm" onclick="config.toggleKeyVisibility('keyCustom')">Show</button>
                    </div>
                </div>
                <div class="setting-row">
                    <label>模型名称</label>
                    <input type="text" id="modelCustom" class="input-field"
                        placeholder="model-name">
                </div>
            </div>

            <!-- 操作按钮 -->
            <div class="setting-actions">
                <button class="btn btn-accent" onclick="config.save()">
                    Save
                </button>
                <button class="btn" onclick="config.testConnection()">
                    Test
                </button>
                <button class="btn btn-danger" onclick="config.clear()">
                    Clear
                </button>
            </div>

            <!-- 配置导入/导出 -->
            <div class="setting-actions" style="margin-top:6px;border-top:none;padding-top:0;">
                <button class="btn" onclick="config.exportData()" style="flex:1;">
                    导出配置
                </button>
                <button class="btn" onclick="config.importData()" style="flex:1;">
                    导入配置
                </button>
                <input type="file" id="configFileInput" accept=".json" style="display:none;" onchange="config.handleImport(event)">
            </div>

            <!-- 状态显示 -->
            <div id="settingsStatus" class="settings-status"></div>
        </div>

        <!-- 当前状态摘要 -->
        <div id="apiStatusSummary" class="api-status-summary">
            <span class="status-indicator offline"></span>
            <span class="status-text">本地模式</span>
        </div>
    </div>
</div>

<style>
/* 编程助手专用样式 */
.chat-container {
    max-height: 300px;
    overflow-y: auto;
    padding: 8px;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    margin-bottom: 8px;
}

.chat-message {
    margin-bottom: 12px;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 12px;
    line-height: 1.5;
}

.chat-message.user {
    background: #1a3a1a;
    margin-left: 20px;
    border-left: 3px solid #4caf50;
}

.chat-message.assistant {
    background: #1a1a2e;
    margin-right: 20px;
    border-left: 3px solid #2196f3;
}

.chat-message.system {
    background: #2a2a2a;
    border-left: 3px solid #888;
    color: #aaa;
}

.message-content {
    color: #c8c8c8;
}

.chat-input-area {
    margin-bottom: 8px;
}

.chat-input {
    width: 100%;
    background: #0d0d0d;
    border: 1px solid #333;
    color: #c8c8c8;
    padding: 8px;
    font-family: Consolas, monospace;
    font-size: 12px;
    resize: vertical;
    border-radius: 4px;
}

.chat-input:focus {
    outline: none;
    border-color: #4caf50;
}

.quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
}

.quick-actions .btn-sm {
    flex: 1;
    min-width: 70px;
    font-size: 10px;
    padding: 4px 6px;
}

/* 模板样式 */
.template-categories {
    margin-bottom: 8px;
}

.category-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
}

.category-tab {
    flex: 1;
    background: #1a1a1a;
    border: 1px solid #333;
    color: #888;
    padding: 4px 6px;
    font-size: 10px;
    cursor: pointer;
    transition: all 0.2s;
}

.category-tab:hover {
    background: #252525;
    color: #aaa;
}

.category-tab.active {
    background: #2a3a2a;
    border-color: #4caf50;
    color: #4caf50;
}

.template-list {
    max-height: 150px;
    overflow-y: auto;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
}

.template-item {
    padding: 8px 10px;
    border-bottom: 1px solid #1a1a1a;
    cursor: pointer;
    transition: background 0.2s;
}

.template-item:hover {
    background: #1a1a1a;
}

.template-item:last-child {
    border-bottom: none;
}

.template-name {
    font-size: 11px;
    color: #c8c8c8;
    font-weight: bold;
}

.template-desc {
    font-size: 10px;
    color: #666;
    margin-top: 2px;
}

.template-preview {
    margin-top: 8px;
    background: #0d0d0d;
    border: 1px solid #333;
    border-radius: 4px;
    overflow: hidden;
}

.preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    background: #1a1a1a;
    border-bottom: 1px solid #333;
    font-size: 11px;
    color: #aaa;
}

.code-preview {
    margin: 0;
    padding: 10px;
    font-size: 10px;
    line-height: 1.4;
    overflow-x: auto;
    max-height: 200px;
    overflow-y: auto;
}

.code-preview code {
    font-family: Consolas, 'Courier New', monospace;
    color: #c8c8c8;
}

/* API参考样式 */
.api-search {
    margin-bottom: 8px;
}

.api-modules {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 8px;
}

.api-module-btn {
    background: #1a1a1a;
    border: 1px solid #333;
    color: #888;
    padding: 4px 8px;
    font-size: 10px;
    cursor: pointer;
    border-radius: 3px;
    transition: all 0.2s;
}

.api-module-btn:hover {
    background: #252525;
    color: #aaa;
}

.api-module-btn.active {
    background: #2a2a3a;
    border-color: #2196f3;
    color: #2196f3;
}

.api-list {
    max-height: 200px;
    overflow-y: auto;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
}

.api-item {
    padding: 8px 10px;
    border-bottom: 1px solid #1a1a1a;
    cursor: pointer;
    transition: background 0.2s;
}

.api-item:hover {
    background: #1a1a1a;
}

.api-item:last-child {
    border-bottom: none;
}

.api-name {
    font-family: Consolas, monospace;
    font-size: 11px;
    color: #4caf50;
}

.api-signature {
    font-family: Consolas, monospace;
    font-size: 9px;
    color: #666;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.api-desc {
    font-size: 10px;
    color: #888;
    margin-top: 3px;
}

/* 代码高亮 */
.hljs-keyword { color: #c586c0; }
.hljs-string { color: #ce9178; }
.hljs-number { color: #b5cea8; }
.hljs-comment { color: #6a9955; }
.hljs-function { color: #dcdcaa; }
.hljs-type { color: #4ec9b0; }

/* API设置面板样式 */
.api-settings {
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 12px;
    margin-top: 8px;
}

.setting-row {
    margin-bottom: 12px;
}

.setting-row label {
    display: block;
    font-size: 11px;
    color: #888;
    margin-bottom: 4px;
}

.input-with-btn {
    display: flex;
    gap: 4px;
}

.input-with-btn .input-field {
    flex: 1;
}

.input-with-btn .btn-sm {
    padding: 4px 8px;
    min-width: 32px;
}

.setting-hint {
    display: block;
    font-size: 9px;
    color: #666;
    margin-top: 2px;
}

.provider-config {
    background: #141414;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    padding: 10px;
    margin-top: 8px;
}

.setting-actions {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #222;
}

.setting-actions .btn {
    flex: 1;
    font-size: 10px;
    padding: 6px 8px;
}

.btn-danger {
    background: #3a1a1a;
    border-color: #5a2a2a;
    color: #ff6b6b;
}

.btn-danger:hover {
    background: #4a2a2a;
}

.settings-status {
    margin-top: 10px;
    padding: 8px;
    border-radius: 4px;
    font-size: 11px;
    display: none;
}

.settings-status.success {
    display: block;
    background: #1a3a1a;
    border: 1px solid #2a5a2a;
    color: #4caf50;
}

.settings-status.error {
    display: block;
    background: #3a1a1a;
    border: 1px solid #5a2a2a;
    color: #ff6b6b;
}

.settings-status.info {
    display: block;
    background: #1a2a3a;
    border: 1px solid #2a4a5a;
    color: #64b5f6;
}

.api-status-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 8px 10px;
    background: #0d0d0d;
    border-radius: 4px;
    font-size: 11px;
}

.status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #666;
}

.status-indicator.online {
    background: #4caf50;
    box-shadow: 0 0 4px #4caf50;
}

.status-indicator.offline {
    background: #666;
}

.status-indicator.testing {
    background: #ff9800;
    animation: pulse 1s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.status-text {
    color: #888;
}

.status-text.connected {
    color: #4caf50;
}

/* 代码审查面板样式 */
.review-input-area {
    margin-bottom: 8px;
}

.review-result {
    margin-top: 8px;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    overflow: hidden;
}

.review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    background: #1a1a1a;
    border-bottom: 1px solid #333;
    font-size: 11px;
    color: #aaa;
}

.review-score {
    padding: 10px;
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    font-family: Consolas, monospace;
}

.review-stats {
    padding: 8px 10px;
    border-top: 1px solid #222;
    font-size: 11px;
    color: #888;
}

.review-stats .stat-line {
    display: flex;
    justify-content: space-between;
    padding: 2px 0;
}

.review-issues {
    max-height: 200px;
    overflow-y: auto;
    padding: 8px 10px;
    border-top: 1px solid #222;
}

.issue-item {
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    font-size: 11px;
    border-left: 3px solid #666;
}

.issue-item.critical {
    background: #2a1a1a;
    border-left-color: #ff4444;
    color: #ff6b6b;
}

.issue-item.warning {
    background: #2a2a1a;
    border-left-color: #ff9800;
    color: #ffb74d;
}

.issue-item.info {
    background: #1a1a2a;
    border-left-color: #2196f3;
    color: #64b5f6;
}

.issue-line {
    font-family: Consolas, monospace;
    font-size: 10px;
    color: #666;
    margin-top: 2px;
}

/* 对话历史面板样式 */
.history-stats {
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 8px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
    font-size: 11px;
}

.stat-label {
    color: #888;
}

.stat-value {
    color: #c8c8c8;
    font-family: Consolas, monospace;
}

.history-timeline {
    max-height: 200px;
    overflow-y: auto;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 4px;
    padding: 6px;
}

.history-empty {
    text-align: center;
    color: #666;
    font-size: 11px;
    padding: 20px;
}

.history-item {
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    background: #141414;
    border-left: 3px solid #444;
    font-size: 11px;
}

.history-item.ai {
    border-left-color: #2196f3;
}

.history-item.local {
    border-left-color: #ff9800;
}

.history-time {
    font-size: 9px;
    color: #666;
    font-family: Consolas, monospace;
}

.history-text {
    color: #aaa;
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* 打字指示器 */
.typing-indicator {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 0;
    color: #666;
    font-size: 11px;
}

.typing-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #444;
    animation: typingBounce 1.2s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-4px); }
}
</style>

<script>
// Lv-00 编程助手核心逻辑 v2.0
// 按照Lv-00项目命名规范重构

// ==================== 常量定义 ====================
const AGENT_MODE_CODING = 'coding-agent';
const AGENT_MODE_REVIEW = 'review-agent';
const AGENT_MODE_EXPLAIN = 'explain-agent';

const PROVIDER_DEEPSEEK = 'deepseek';
const PROVIDER_DASHSCOPE = 'dashscope';
const PROVIDER_OPENAI = 'openai';
const PROVIDER_CUSTOM = 'custom';

const STATUS_OK = 'ok';
const STATUS_ERROR = 'error';
const STATUS_INFO = 'info';

// ==================== MathEngine 数学工具模块 ====================
const MathEngine = {
    // 符号坐标计算
    symbolicCoord: {
        // 解析符号坐标表达式，如 "sqrt(2)/2", "1+sqrt(3)"
        parse(expr) {
            expr = expr.replace(/\s+/g, '');
            
            // 处理基本常量
            if (expr === 'pi' || expr === 'π') return { type: 'const', value: Math.PI, expr: 'π' };
            if (expr === 'e') return { type: 'const', value: Math.E, expr: 'e' };
            if (expr === 'phi' || expr === 'φ') return { type: 'const', value: (1 + Math.sqrt(5)) / 2, expr: 'φ' };
            
            // 处理 sqrt 函数
            const sqrtMatch = expr.match(/^sqrt\((.+)\)$/);
            if (sqrtMatch) {
                const inner = this.parse(sqrtMatch[1]);
                return {
                    type: 'sqrt',
                    inner: inner,
                    value: Math.sqrt(inner.value),
                    expr: `sqrt(${inner.expr})`
                };
            }
            
            // 处理分数
            const fracMatch = expr.match(/^(.+)\/(.+)$/);
            if (fracMatch) {
                const num = this.parse(fracMatch[1]);
                const den = this.parse(fracMatch[2]);
                return {
                    type: 'div',
                    num: num,
                    den: den,
                    value: num.value / den.value,
                    expr: `${num.expr}/${den.expr}`
                };
            }
            
            // 处理加减法
            const addMatch = expr.match(/^(.+)\+(.+)$/);
            if (addMatch) {
                const left = this.parse(addMatch[1]);
                const right = this.parse(addMatch[2]);
                return {
                    type: 'add',
                    left: left,
                    right: right,
                    value: left.value + right.value,
                    expr: `${left.expr}+${right.expr}`
                };
            }
            
            // 处理数值
            const num = parseFloat(expr);
            if (!isNaN(num)) {
                return { type: 'number', value: num, expr: expr };
            }
            
            return { type: 'unknown', value: NaN, expr: expr };
        },
        
        // 计算两点间距离
        distance(p1, p2) {
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            return Math.sqrt(dx * dx + dy * dy);
        },
        
        // 判断三点共线
        isCollinear(p1, p2, p3, epsilon = 1e-10) {
            const area = (p2.x - p1.x) * (p3.y - p1.y) - (p2.y - p1.y) * (p3.x - p1.x);
            return Math.abs(area) < epsilon;
        },
        
        // 计算三角形面积
        triangleArea(p1, p2, p3) {
            return Math.abs((p2.x - p1.x) * (p3.y - p1.y) - (p2.y - p1.y) * (p3.x - p1.x)) / 2;
        },
        
        // 计算多边形面积（鞋带公式）
        polygonArea(points) {
            let area = 0;
            const n = points.length;
            for (let i = 0; i < n; i++) {
                const j = (i + 1) % n;
                area += points[i].x * points[j].y;
                area -= points[j].x * points[i].y;
            }
            return Math.abs(area) / 2;
        }
    },
    
    // 几何计算
    geometry: {
        // 计算直线交点
        lineIntersection(p1, p2, p3, p4) {
            const x1 = p1.x, y1 = p1.y;
            const x2 = p2.x, y2 = p2.y;
            const x3 = p3.x, y3 = p3.y;
            const x4 = p4.x, y4 = p4.y;
            
            const denom = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
            if (Math.abs(denom) < 1e-10) return null; // 平行
            
            const x = ((x1 * y2 - y1 * x2) * (x3 - x4) - (x1 - x2) * (x3 * y4 - y3 * x4)) / denom;
            const y = ((x1 * y2 - y1 * x2) * (y3 - y4) - (y1 - y2) * (x3 * y4 - y3 * x4)) / denom;
            
            return { x, y };
        },
        
        // 计算点到直线距离
        pointToLineDistance(point, lineP1, lineP2) {
            const x0 = point.x, y0 = point.y;
            const x1 = lineP1.x, y1 = lineP1.y;
            const x2 = lineP2.x, y2 = lineP2.y;
            
            const num = Math.abs((y2 - y1) * x0 - (x2 - x1) * y0 + x2 * y1 - y2 * x1);
            const den = Math.sqrt((y2 - y1) ** 2 + (x2 - x1) ** 2);
            
            return num / den;
        },
        
        // 计算圆的切线点
        circleTangentPoints(center, radius, externalPoint) {
            const dx = externalPoint.x - center.x;
            const dy = externalPoint.y - center.y;
            const d = Math.sqrt(dx * dx + dy * dy);
            
            if (d < radius) return []; // 点在圆内，无切线
            
            const a = Math.atan2(dy, dx);
            const b = Math.acos(radius / d);
            
            return [
                {
                    x: center.x + radius * Math.cos(a + b),
                    y: center.y + radius * Math.sin(a + b)
                },
                {
                    x: center.x + radius * Math.cos(a - b),
                    y: center.y + radius * Math.sin(a - b)
                }
            ];
        },
        
        // 计算外接圆
        circumcircle(p1, p2, p3) {
            const d = 2 * (p1.x * (p2.y - p3.y) + p2.x * (p3.y - p1.y) + p3.x * (p1.y - p2.y));
            if (Math.abs(d) < 1e-10) return null; // 三点共线
            
            const ux = ((p1.x ** 2 + p1.y ** 2) * (p2.y - p3.y) +
                       (p2.x ** 2 + p2.y ** 2) * (p3.y - p1.y) +
                       (p3.x ** 2 + p3.y ** 2) * (p1.y - p2.y)) / d;
            const uy = ((p1.x ** 2 + p1.y ** 2) * (p3.x - p2.x) +
                       (p2.x ** 2 + p2.y ** 2) * (p1.x - p3.x) +
                       (p3.x ** 2 + p3.y ** 2) * (p2.x - p1.x)) / d;
            
            const center = { x: ux, y: uy };
            const radius = MathEngine.symbolicCoord.distance(center, p1);
            
            return { center, radius };
        }
    },
    
    // 矩阵运算（用于约束求解）
    matrix: {
        // 2x2矩阵乘法
        multiply2x2(a, b) {
            return [
                [a[0][0] * b[0][0] + a[0][1] * b[1][0], a[0][0] * b[0][1] + a[0][1] * b[1][1]],
                [a[1][0] * b[0][0] + a[1][1] * b[1][0], a[1][0] * b[0][1] + a[1][1] * b[1][1]]
            ];
        },
        
        // 2x2矩阵求逆
        inverse2x2(m) {
            const det = m[0][0] * m[1][1] - m[0][1] * m[1][0];
            if (Math.abs(det) < 1e-10) return null;
            
            return [
                [m[1][1] / det, -m[0][1] / det],
                [-m[1][0] / det, m[0][0] / det]
            ];
        },
        
        // 求解线性方程组 Ax = b (2x2)
        solve2x2(A, b) {
            const inv = this.inverse2x2(A);
            if (!inv) return null;
            
            return [
                inv[0][0] * b[0] + inv[0][1] * b[1],
                inv[1][0] * b[0] + inv[1][1] * b[1]
            ];
        }
    },
    
    // 公式格式化
    formatFormula(expr, result) {
        if (typeof result === 'number') {
            const rational = this._toRational(result);
            if (rational && Math.abs(rational.num) < 100 && Math.abs(rational.den) < 100) {
                return `${expr} = ${rational.num}/${rational.den} ≈ ${result.toFixed(6)}`;
            }
            return `${expr} = ${result.toFixed(10)}`;
        }
        return `${expr} = ${result}`;
    },
    
    // 浮点数转有理数近似
    _toRational(x, maxDenom = 1000) {
        let best = { num: Math.round(x), den: 1, err: Math.abs(x - Math.round(x)) };
        
        for (let d = 2; d <= maxDenom; d++) {
            const n = Math.round(x * d);
            const err = Math.abs(x - n / d);
            if (err < best.err) {
                best = { num: n, den: d, err: err };
            }
        }
        
        if (best.err < 1e-10) {
            const g = this._gcd(Math.abs(best.num), best.den);
            return { num: best.num / g, den: best.den / g };
        }
        return null;
    },
    
    _gcd(a, b) {
        return b === 0 ? a : this._gcd(b, a % b);
    },
    
    // 生成数学响应
    generateMathResponse(query) {
        const lower = query.toLowerCase();
        
        // 距离计算
        const distMatch = query.match(/点\s*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\)\s*和\s*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\)\s*之间的距离/);
        if (distMatch) {
            const p1 = { x: parseFloat(distMatch[1]), y: parseFloat(distMatch[2]) };
            const p2 = { x: parseFloat(distMatch[3]), y: parseFloat(distMatch[4]) };
            const dist = this.symbolicCoord.distance(p1, p2);
            return this.formatFormula(`distance((${p1.x},${p1.y}), (${p2.x},${p2.y}))`, dist);
        }
        
        // 三角形面积
        const areaMatch = query.match(/三角形.*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\)/);
        if (areaMatch) {
            const p1 = { x: parseFloat(areaMatch[1]), y: parseFloat(areaMatch[2]) };
            const p2 = { x: parseFloat(areaMatch[3]), y: parseFloat(areaMatch[4]) };
            const p3 = { x: parseFloat(areaMatch[5]), y: parseFloat(areaMatch[6]) };
            const area = this.symbolicCoord.triangleArea(p1, p2, p3);
            return this.formatFormula(`area((${p1.x},${p1.y}), (${p2.x},${p2.y}), (${p3.x},${p3.y}))`, area);
        }
        
        // 共线性检查
        const collMatch = query.match(/三点.*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*是否共线/);
        if (collMatch) {
            const p1 = { x: parseFloat(collMatch[1]), y: parseFloat(collMatch[2]) };
            const p2 = { x: parseFloat(collMatch[3]), y: parseFloat(collMatch[4]) };
            const p3 = { x: parseFloat(collMatch[5]), y: parseFloat(collMatch[6]) };
            const isColl = this.symbolicCoord.isCollinear(p1, p2, p3);
            return `三点(${p1.x},${p1.y}), (${p2.x},${p2.y}), (${p3.x},${p3.y}) ${isColl ? '共线' : '不共线'}`;
        }
        
        // 外接圆
        const circMatch = query.match(/外接圆.*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\).*\(\s*([\d.]+)\s*,\s*([\d.]+)\s*\)/);
        if (circMatch) {
            const p1 = { x: parseFloat(circMatch[1]), y: parseFloat(circMatch[2]) };
            const p2 = { x: parseFloat(circMatch[3]), y: parseFloat(circMatch[4]) };
            const p3 = { x: parseFloat(circMatch[5]), y: parseFloat(circMatch[6]) };
            const circle = this.geometry.circumcircle(p1, p2, p3);
            if (circle) {
                return `外接圆：圆心(${circle.center.x.toFixed(6)}, ${circle.center.y.toFixed(6)})，半径${circle.radius.toFixed(6)}`;
            }
            return '三点共线，不存在外接圆';
        }
        
        // 符号坐标解析
        const symMatch = query.match(/计算\s*([\w\d\+\-\*\/\(\)\.]+)\s*的值/);
        if (symMatch) {
            const parsed = this.symbolicCoord.parse(symMatch[1]);
            return this.formatFormula(parsed.expr, parsed.value);
        }
        
        return null;
    }
};

// ==================== AssistantEngine 模块 ====================
const AssistantEngine = {
    chatHistory: [],
    aiReplyCount: 0,
    localReplyCount: 0,
    currentAgent: AGENT_MODE_CODING,
    isStreaming: false,
    abortController: null,

    agentPrompts: {
        [AGENT_MODE_CODING]: `Technical Note: Lv-00 Symbolic Geometry Engine -- Coding Assistant Agent

Lv-00 is a formalized geometric construction system based on symbolic computation. The core engine is implemented in C11, compiled to browser-executable modules via WebAssembly (Emscripten), with HTML5 Canvas for geometric visualization.

Scope of Assistance:
1. WebAssembly binding layer development (lv00_web_bindings.c)
2. Canvas 2D geometric renderer implementation
3. Technical questions on symbolic coordinates, constraint graphs, normalization, unification
4. C/JavaScript code examples following Lv-00 coding conventions

Response Requirements:
- Precise language, avoid ambiguous expressions
- Code examples must include necessary annotations
- Cite API function signatures when referenced
- State time/space complexity for algorithms
- Use structured markdown with reference markers [Ref: xxx]`,

        [AGENT_MODE_REVIEW]: `Technical Note: Lv-00 Symbolic Geometry Engine -- Code Review Agent

You are a code review specialist for the Lv-00 project. Your role is to analyze submitted code for quality, correctness, and adherence to Lv-00 conventions.

Review Criteria:
1. Memory safety: proper allocation/deallocation patterns (C11)
2. API contract compliance: correct use of Lv-00 function signatures
3. Error handling: null checks, return value validation
4. Performance: algorithmic complexity, unnecessary allocations
5. Style: naming conventions (web_ prefix for exports, snake_case for C)
6. Security: no hardcoded credentials, no buffer overflows

Response Format:
- Severity levels: [CRITICAL], [WARNING], [INFO]
- Include line references where applicable
- Provide corrected code snippets for issues found
- Summarize with a quality score (0-100)`,

        [AGENT_MODE_EXPLAIN]: `Technical Note: Lv-00 Symbolic Geometry Engine -- Concept Explainer Agent

You are a technical concept explainer specializing in Lv-00's formal geometric foundations. Your role is to provide rigorous yet accessible explanations of core concepts.

Core Concepts to Explain:
1. Symbolic Coordinates (SymbolicCoord): exact arithmetic representation avoiding floating-point errors
2. Constraint Graphs (ConstraintGraph): graph structures encoding geometric relationships
3. Graph Normalization: idempotent transformation ensuring canonical graph form
4. Unification (proof_unify): pattern matching between construction graphs and proposition schemas
5. Proof System: forward/backward proof stepping with LaTeX/Coq export
6. Function Blocks (FuncBlock): abstraction mechanism for reusable geometric constructions

Explanation Requirements:
- Begin with formal definition, then provide intuition
- Use concrete examples with Lv-00 API calls
- Reference relevant theorems or properties
- Include complexity analysis where relevant
- Use [Ref: xxx] markers for cross-references`
    },

    init() {
        this.bindEvents();
        template.renderList();
        api.renderList();
        config.load();
        history.renderStats();
    },

    bindEvents() {
        document.getElementById('btnAssistantSend')?.addEventListener('click', () => {
            this.sendMessage();
        });

        document.getElementById('assistantInput')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                this.sendMessage();
            }
        });

        document.querySelectorAll('.category-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                template.currentCategory = tab.dataset.category;
                template.renderList();
                document.getElementById('templatePreview').style.display = 'none';
            });
        });

        document.querySelectorAll('.api-module-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.api-module-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                api.currentModule = btn.dataset.module;
                api.renderList();
            });
        });
    },

    async sendMessage() {
        if (this.isStreaming) return;

        const input = document.getElementById('assistantInput');
        const message = input.value.trim();

        if (!message) return;

        this.addMessage('user', message);
        this.chatHistory.push({ role: 'user', content: message, timestamp: Date.now(), source: 'user' });

        input.value = '';

        const cfg = config.getAIConfig();

        if (cfg) {
            const aiReply = await this._streamResponse(cfg, message);
            if (aiReply !== null && aiReply !== undefined && aiReply.length > 0) {
                this.chatHistory.push({ role: 'assistant', content: aiReply, timestamp: Date.now(), source: 'ai' });
                this.aiReplyCount++;
                history.renderStats();
                return;
            }
        }

        const localReply = this.generateLocalResponse(message);
        this.addMessage('assistant', localReply);
        this.chatHistory.push({ role: 'assistant', content: localReply, timestamp: Date.now(), source: 'local' });
        this.localReplyCount++;
        history.renderStats();
    },

    async _streamResponse(cfg, message) {
        this.isStreaming = true;

        const messages = [
            { role: 'system', content: this.agentPrompts[this.currentAgent] || this.agentPrompts[AGENT_MODE_CODING] }
        ];

        const recentHistory = this.chatHistory.slice(-10);
        for (const h of recentHistory) {
            messages.push({ role: h.role, content: h.content });
        }

        const chat = document.getElementById('assistantChat');
        const messageDiv = document.createElement('div');
        messageDiv.className = 'chat-message assistant';
        messageDiv.id = 'streamingMessage';

        messageDiv.innerHTML = '<div class="message-content"><span class="typing-indicator"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></span> <span class="typing-text">正在输入...</span></div>';
        chat.appendChild(messageDiv);
        chat.scrollTop = chat.scrollHeight;

        await new Promise(resolve => setTimeout(resolve, 300));

        const contentDiv = messageDiv.querySelector('.message-content');
        contentDiv.innerHTML = '';

        let result = null;
        try {
            result = await this.callLLM(cfg, messages);
        } catch (err) {
            console.error('[AssistantEngine] 流式调用异常:', err);
        }

        this.isStreaming = false;

        if (result === null || result.length === 0) {
            messageDiv.remove();
            return null;
        }

        contentDiv.innerHTML = this._formatMarkdown(result);
        messageDiv.removeAttribute('id');
        chat.scrollTop = chat.scrollHeight;

        return result;
    },

    async callLLM(cfg, messages) {
        if (!cfg || !cfg.provider || !cfg.apiKey) {
            return null;
        }

        this.abortController = new AbortController();

        try {
            if (cfg.provider === PROVIDER_DASHSCOPE) {
                return await this._callDashScopeStream(cfg, messages);
            } else {
                return await this._callOpenAICompatibleStream(cfg, messages);
            }
        } catch (err) {
            if (err.name === 'AbortError') {
                console.warn('[AssistantEngine] LLM调用被中止');
                return null;
            }
            console.error('[AssistantEngine] LLM调用失败:', err);
            return null;
        } finally {
            this.abortController = null;
        }
    },

    async _callOpenAICompatibleStream(cfg, messages) {
        const baseUrl = cfg.baseUrl || '';
        const endpoint = baseUrl.replace(/\/+$/, '') + '/chat/completions';

        const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + cfg.apiKey,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                model: cfg.model,
                messages: messages,
                temperature: 0.3,
                max_tokens: 2000,
                stream: true
            }),
            signal: this.abortController ? this.abortController.signal : undefined
        });

        if (!response.ok) {
            const errText = await response.text().catch(() => '');
            throw new Error('API错误: ' + response.status + ' ' + errText);
        }

        return await this._readStream(response);
    },

    async _callDashScopeStream(cfg, messages) {
        const baseUrl = cfg.baseUrl || 'https://dashscope.aliyuncs.com/api/v1';
        const endpoint = baseUrl.replace(/\/+$/, '') + '/services/aigc/text-generation/generation';

        const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + cfg.apiKey,
                'Content-Type': 'application/json',
                'X-DashScope-SSE': 'enable'
            },
            body: JSON.stringify({
                model: cfg.model,
                input: {
                    messages: messages
                },
                parameters: {
                    temperature: 0.3,
                    max_tokens: 2000,
                    incremental_output: true
                }
            }),
            signal: this.abortController ? this.abortController.signal : undefined
        });

        if (!response.ok) {
            const errText = await response.text().catch(() => '');
            throw new Error('API错误: ' + response.status + ' ' + errText);
        }

        return await this._readDashScopeStream(response);
    },

    async _readStream(response) {
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let fullContent = '';
        let buffer = '';

        try {
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                    const trimmed = line.trim();
                    if (!trimmed || trimmed === 'data: [DONE]') continue;
                    if (!trimmed.startsWith('data: ')) continue;

                    try {
                        const json = JSON.parse(trimmed.slice(6));
                        const delta = json.choices && json.choices[0] && json.choices[0].delta;
                        if (delta && delta.content) {
                            fullContent += delta.content;
                            this._appendStreamingContent(delta.content);
                        }
                    } catch (parseErr) {
                        // 忽略无法解析的行
                    }
                }
            }
        } finally {
            reader.releaseLock();
        }

        return fullContent || null;
    },

    async _readDashScopeStream(response) {
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let fullContent = '';
        let buffer = '';

        try {
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                    const trimmed = line.trim();
                    if (!trimmed) continue;
                    if (!trimmed.startsWith('data:')) continue;

                    try {
                        const jsonStr = trimmed.slice(5).trim();
                        const json = JSON.parse(jsonStr);
                        const output = json.output;
                        if (output && output.choices && output.choices[0] && output.choices[0].message) {
                            const content = output.choices[0].message.content;
                            if (content) {
                                fullContent += content;
                                this._appendStreamingContent(content);
                            }
                        }
                    } catch (parseErr) {
                        // 忽略无法解析的行
                    }
                }
            }
        } finally {
            reader.releaseLock();
        }

        return fullContent || null;
    },

    _appendStreamingContent(chunk) {
        const contentDiv = document.querySelector('#streamingMessage .message-content');
        if (!contentDiv) return;

        const typingEl = contentDiv.querySelector('.typing-indicator');
        if (typingEl) typingEl.remove();
        const typingText = contentDiv.querySelector('.typing-text');
        if (typingText) typingText.remove();

        const textNode = document.createTextNode(chunk);
        contentDiv.appendChild(textNode);

        const chat = document.getElementById('assistantChat');
        chat.scrollTop = chat.scrollHeight;
    },

    addMessage(role, content) {
        const chat = document.getElementById('assistantChat');
        const messageDiv = document.createElement('div');
        messageDiv.className = 'chat-message ' + role;

        let displayContent;
        if (role === 'assistant') {
            displayContent = this._formatMarkdown(content);
        } else {
            displayContent = this._escapeHtml(content).replace(/\n/g, '<br>');
        }

        messageDiv.innerHTML = '<div class="message-content">' + displayContent + '</div>';
        chat.appendChild(messageDiv);
        chat.scrollTop = chat.scrollHeight;
    },

    generateLocalResponse(message) {
        let response = '';
        const lowerMsg = message.toLowerCase();

        // 优先尝试数学计算响应
        const mathResponse = MathEngine.generateMathResponse(message);
        if (mathResponse) {
            return '## 数学计算结果\n\n' + mathResponse + '\n\n---\n*使用 MathEngine.symbolicCoord / MathEngine.geometry 进行计算*';
        }

        if (lowerMsg.includes('绑定') || lowerMsg.includes('binding') || lowerMsg.includes('wasm')) {
            response = '## WebAssembly绑定层规范 [Ref: lv00_web_bindings.c]\n\n### 1. 导出约定\n- 使用 `EMSCRIPTEN_KEEPALIVE` 宏标记导出函数\n- 函数命名前缀: `web_`\n- 首参数统一为 `void* graph`（指向 ConstraintGraph 实例）\n\n### 2. 返回值协议\n| 类型 | 策略 | 所有权 |\n|------|------|--------|\n| 数值 (int/double) | 直接返回 | -- |\n| 字符串 | `strdup()` 分配 | JS端调用 `free()` |\n| 结构体数组 | 通过指针参数写入 | 调用方预分配缓冲区 |\n\n### 3. 错误处理\n- 空指针检查: `if (!graph) return -1;`\n- 类型转换: `ConstraintGraph* g = (ConstraintGraph*)graph;`\n\n参考模板面板中的 "WASM绑定" 分类获取完整代码示例。';
        } else if (lowerMsg.includes('渲染') || lowerMsg.includes('renderer') || lowerMsg.includes('canvas')) {
            response = '## Canvas 2D几何渲染器 [Ref: GeometryRenderer]\n\n### 1. 坐标变换\n```\nscreenX = worldX * zoom + offsetX\nscreenY = worldY * zoom + offsetY\n```\n逆变换用于将鼠标事件映射回世界坐标。\n\n### 2. 渲染管线\n`clearRect() -> drawGrid() -> drawSegments() -> drawPoints()`\n\n- 使用 `requestAnimationFrame` 进行帧调度\n- 选中状态通过颜色映射区分（参考 TrustColors 系统）\n\n### 3. 交互模型\n- 工具状态机: select | point | segment | pan\n- 最近点查找: O(n) 线性扫描，阈值 0.3 世界单位\n\n参考模板面板中的 "Canvas" 分类获取完整实现。';
        } else if (lowerMsg.includes('api') || lowerMsg.includes('函数')) {
            response = '## Lv-00核心API模块索引\n\n| 模块 | 职域 | 核心函数数 |\n|------|------|-----------|\n| **Graph** | 约束图生命周期与节点管理 | 8 |\n| **Constraint** | 几何约束声明（关联、之间、相交、包含） | 5 |\n| **Coord** | 符号坐标的构造、判等、序列化 | 6 |\n| **Proof** | 命题定义、合一检查、证明步进与导出 | 7 |\n| **Block** | 函数块的打包、例化、组合与乘积 | 4 |\n\n使用下方API参考面板按模块浏览详细函数签名。';
        } else if (lowerMsg.includes('归一化') || lowerMsg.includes('normalization')) {
            response = '## 图归一化 (Graph Normalization) [Ref: graph_normalize]\n\n### 定义\n归一化是Lv-00保证约束图幂等性的核心变换过程。\n\n### 算法步骤\n1. **点合并**: 通过坐标哈希分组，使用 `coord_equal()` 精确判等后合并同构点\n2. **线段/区域合并**: 合并端点集相同的几何体\n3. **拓扑稳定化**: 对节点进行拓扑排序，固定遍历顺序\n\n### 函数签名\n```c\nNormalizationResult* graph_normalize(ConstraintGraph *g, bool interactive);\n```\n\n### 关键性质\n- **幂等性**: normalize(normalize(G)) == normalize(G)\n- **interactive=true**: 跨作用域合并需用户确认\n- 时间复杂度: O(n log n)（哈希分组）+ O(m)（约束遍历）\n\n[Ref: graph_normalize, coord_equal]';
        } else if (lowerMsg.includes('合一') || lowerMsg.includes('unification')) {
            response = '## 合一检查 (Unification) [Ref: proof_unify]\n\n### 定义\n合一检查是Lv-00证明系统的核心判定机制，验证构造图是否满足命题的模式约束。\n\n### 执行流程\n1. 归一化构造图 G_construction 和命题模式图 G_pattern\n2. 展开命题中的模板节点为正则形式\n3. 三层匹配:\n   - 端口匹配 (port matching)\n   - 约束匹配 (constraint matching)\n   - 坐标匹配 (coordinate matching)\n\n### 函数签名\n```c\nUnifyResult proof_unify(ConstraintGraph *construction,\n                        Proposition *prop,\n                        bool strict);\n```\n\n### 返回值语义\n| 枚举值 | 含义 |\n|--------|------|\n| UNIFY_OK | 完全合一 |\n| UNIFY_MISMATCH | 结构不匹配 |\n| UNIFY_INCOMPLETE | 部分匹配（存在未绑定变量）|\n\n### 严格模式 (strict=true)\n不调用代数求解器判定语义等价，仅进行结构级比较。\n\n[Ref: proof_unify, graph_normalize]';
        } else if (lowerMsg.includes('数学') || lowerMsg.includes('math') || lowerMsg.includes('计算') || lowerMsg.includes('几何')) {
            response = '## MathEngine 数学计算工具\n\nMathEngine 提供以下计算能力：\n\n### 符号坐标计算 (MathEngine.symbolicCoord)\n- `parse(expr)` - 解析符号表达式（支持 sqrt, pi, e, phi）\n- `distance(p1, p2)` - 两点间距离\n- `isCollinear(p1, p2, p3)` - 三点共线判断\n- `triangleArea(p1, p2, p3)` - 三角形面积\n- `polygonArea(points)` - 多边形面积（鞋带公式）\n\n### 几何计算 (MathEngine.geometry)\n- `lineIntersection(p1, p2, p3, p4)` - 直线交点\n- `pointToLineDistance(point, lineP1, lineP2)` - 点到直线距离\n- `circleTangentPoints(center, radius, externalPoint)` - 圆的切线点\n- `circumcircle(p1, p2, p3)` - 三点外接圆\n\n### 矩阵运算 (MathEngine.matrix)\n- `multiply2x2(a, b)` - 2x2矩阵乘法\n- `inverse2x2(m)` - 2x2矩阵求逆\n- `solve2x2(A, b)` - 求解线性方程组\n\n### 使用示例\n输入："点 (0,0) 和 (3,4) 之间的距离"\n输入："三角形 (0,0) (3,0) (0,4) 的面积"\n输入："计算 sqrt(2)/2 的值"';
        } else {
            response = '## Lv-00编程辅助系统 -- 功能索引\n\n### [Code] 代码生成\n- WebAssembly绑定层 (C11 <-> JavaScript)\n- Canvas 2D几何渲染器\n- UI交互处理器\n\n### [Math] 数学计算\n- 符号坐标解析与计算\n- 几何量计算（距离、面积、共线性）\n- 矩阵运算（2x2）\n\n### [Ref] 文档查询\n- API函数签名与语义说明\n- 核心数据结构定义\n- 可复用代码模板\n\n### [Info] 概念解析\n- 符号坐标系统 (SymbolicCoord)\n- 约束图 (ConstraintGraph)\n- 图归一化 (Normalization)\n- 合一检查 (Unification)\n- 证明系统 (Proof System)\n- 函数块 (FuncBlock)\n\n请输入具体技术问题以获取结构化回复。';
        }

        return response;
    },

    quickQuery(type) {
        const questions = {
            binding: '如何为C函数创建WebAssembly绑定？请给出规范说明。',
            renderer: '请给出Canvas几何渲染器的架构设计和核心实现。',
            api: '列出Lv-00所有核心API模块及其函数签名。',
            explain: '详细解释图归一化的算法原理和幂等性保证。',
            math: 'MathEngine 数学计算工具使用说明。'
        };

        document.getElementById('assistantInput').value = questions[type];
        this.sendMessage();
    },

    onAgentChange() {
        const agentSelect = document.getElementById('agentMode');
        if (agentSelect) {
            this.currentAgent = agentSelect.value;
            console.log('[AssistantEngine] Agent切换为:', this.currentAgent);
        }
    },

    _formatMarkdown(text) {
        let html = this._escapeHtml(text);

        html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(match, lang, code) {
            return '<pre style="background:#0a0a0a;padding:8px;border-radius:3px;overflow-x:auto;margin:6px 0;font-size:10px;line-height:1.4;"><code>' + code.trim() + '</code></pre>';
        });

        html = html.replace(/`([^`]+)`/g, '<code style="background:#1a1a1a;padding:1px 4px;border-radius:2px;font-size:10px;">$1</code>');

        html = html.replace(/^### (.+)$/gm, '<strong style="color:#4caf50;font-size:12px;">$1</strong>');
        html = html.replace(/^## (.+)$/gm, '<strong style="color:#2196f3;font-size:13px;">$1</strong>');

        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        html = html.replace(/^\|(.+)\|$/gm, function(match) {
            const cells = match.split('|').filter(c => c.trim());
            if (cells.every(c => /^[\s-:]+$/.test(c))) return '';
            return '<span style="color:#888;">' + cells.join(' | ') + '</span>';
        });

        html = html.replace(/^- (.+)$/gm, '<span style="color:#aaa;">&nbsp;&nbsp;- $1</span>');
        html = html.replace(/^\d+\. (.+)$/gm, '<span style="color:#aaa;">&nbsp;&nbsp;$&</span>');

        html = html.replace(/\n/g, '<br>');

        return html;
    },

    _escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

