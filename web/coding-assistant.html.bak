    }

    async addPoint(x, y) {
        if (!this.ready) await this.init();

        return new Promise((resolve, reject) => {
            try {
                const id = this.module.ccall(
                    'web_graph_add_point',
                    'number',
                    ['number', 'number', 'number', 'number', 'number'],
