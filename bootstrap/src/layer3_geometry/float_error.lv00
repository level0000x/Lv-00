// bootstrap: float_error — 浮点误差分析: epsilon=1e-12, 误差传播

Real eps = 1e-12;
Value x, y, z;

Constraint Near(x, y) iff |x - y| < eps;       // epsilon等值判定
Constraint SumErr(x, y) => eps_xy = eps*(|x|+|y|); // 加法误差传播
Constraint MulErr(x, y) => eps_xy = eps*(|x*y| + |x|*eps_y + |y|*eps_x); // 乘法误差
Constraint KahanSum(a, b, c, d) with compensation;

Prove;
Normalize;
