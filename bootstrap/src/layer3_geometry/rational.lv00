// bootstrap: rational — 有理数精确: num/den + gcd + 规范化

Rational r1 = 3/4, r2 = 5/6;

Constraint Rational(n, d) iff d != 0;          // 有理数构造
Constraint r = Reduce(num/den) via gcd;         // 约分化简
Constraint Sum = Reduce(r1 + r2);               // 精确加法
Constraint Mul = Reduce(r1 * r2);               // 精确乘法
Constraint Canonical(r) = (num/g, den/g) where g = gcd(num,den);

Prove;
Normalize;
