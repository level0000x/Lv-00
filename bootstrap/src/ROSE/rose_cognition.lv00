// bootstrap: rose_cognition — ROSÉ 认知架构 7 阶段循环

// 7 阶段认知点
Point stage_Observe = (0, 6);    // 观察：感知输入
Point stage_Reflect = (1, 5);    // 反思：内省状态
Point stage_Orient  = (2, 4);    // 定向：上下文评估
Point stage_Select  = (3, 3);    // 选择：决策规划
Point stage_Execute = (4, 2);    // 执行：动作输出
Point stage_Verify  = (5, 1);    // 验证：结果检查
Point stage_Learn   = (6, 0);    // 学习：经验内化

// 循环有向边
Constraint cycle(Observe, Reflect, Orient, Select, Execute, Verify, Learn, Observe);
Constraint feedback(Verify, Reflect);   // 验证失败反馈到反思
Constraint reinforce(Verify, Learn);    // 验证通过进入学习

Prove;
Normalize;
