// bootstrap: error_codes — 错误码系统

// 错误码层级
Point err_none = (0, 4);         // 0: 无错误
Point err_syntax = (1, 3);       // 1xx: 语法错误
Point err_semantic = (2, 2);     // 2xx: 语义错误
Point err_runtime = (3, 1);      // 3xx: 运行时错误
Point err_internal = (4, 0);     // 4xx: 内部错误

// 错误传播
Constraint err_propagate(err_syntax, err_none);     // 语法错误可修复后清空
Constraint err_propagate(err_semantic, err_syntax);  // 语义错误基于语法
Constraint err_propagate(err_runtime, err_semantic); // 运行时错误基于语义
Constraint err_critical(err_internal);                // 内部错误为严重级别

// 错误恢复
Point recovery_point = (2, 4);
Constraint error_recovery(err_syntax, recovery_point);   // 语法错误可恢复
Constraint error_recovery(err_semantic, recovery_point); // 语义错误可恢复

Prove;
Normalize;
