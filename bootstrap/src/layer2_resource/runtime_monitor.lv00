// bootstrap: runtime_monitor — 运行时监控

// 监控指标
Point metric_memory = (0, 3);      // 内存使用量
Point metric_cpu = (1, 2);         // CPU 占用
Point metric_latency = (2, 1);     // 延迟分布
Point metric_throughput = (3, 0);  // 吞吐量

// 监控阈值
Constraint alert_memory(metric_memory) < CFG_MEMORY_POOL_SIZE;
Constraint alert_latency(metric_latency) < CFG_SOLVER_TIMEOUT;
Constraint alert_throughput(metric_throughput) > 0;

// 监控生命周期
Point monitor_start = (-1, 3);
Point monitor_stop = (4, -1);
Constraint monitor_collect(monitor_start, metric_memory, metric_cpu, metric_latency, metric_throughput);
Constraint monitor_report(metric_memory, metric_cpu, metric_latency, metric_throughput);

Prove;
Normalize;
