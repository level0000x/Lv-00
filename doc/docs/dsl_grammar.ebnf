(*
 * Lv-00 几何元语言语法规范 (EBNF)
 * 
 * 版本: 3.5.0
 * 日期: 2026-05-29
 * 状态: 已锁定（向后兼容）
 * 
 * 本文档基于 LV00_LANGUAGE_SPEC.md 中的 BNF 语法整理，
 * 用于自举编译器的解析器生成。
 *)

(* ============================================================
 * 1. 词法元素 (Lexical Elements)
 * ============================================================ *)

(* 1.1 字符集 *)
Letter          = "A" .. "Z" | "a" .. "z" | UnicodeLetter ;
Digit           = "0" .. "9" ;
UnicodeLetter   = ? any Unicode letter ? ;
Character       = ? any Unicode character ? ;
Newline         = "\n" | "\r\n" ;

(* 1.2 空白与注释 *)
Whitespace      = " " | "\t" | "\r" | "\n" ;
LineComment     = "//" , { Character - Newline } , Newline ;
BlockComment    = "/*" , { Character } , "*/" ;
Ignored         = Whitespace | LineComment | BlockComment ;

(* 1.3 标识符 *)
Identifier      = Letter , { Letter | Digit | "_" } ;
QualifiedName   = Identifier , { "." , Identifier } ;

(* 1.4 数值字面量 *)
Number          = Integer | Rational | Decimal ;
Integer         = Digit , { Digit } ;
Rational        = Integer , "/" , Integer ;
Decimal         = Integer , "." , Digit , { Digit } ;

(* 1.5 字符串字面量 *)
String          = '"' , { StringChar } , '"' ;
StringChar      = ( Character - '"' ) | EscapeSequence ;
EscapeSequence  = "\\n" | "\\t" | "\\r" | "\\\"" | "\\\\" ;

(* ============================================================
 * 2. 关键字 (Keywords)
 * ============================================================ *)

(* 类型关键字 *)
KW_Point        = "Point" ;
KW_Line         = "Line" ;
KW_Circle       = "Circle" ;
KW_Segment      = "Segment" ;
KW_Ray          = "Ray" ;
KW_Angle        = "Angle" ;
KW_Triangle     = "Triangle" ;
KW_Polygon      = "Polygon" ;
KW_Scalar       = "Scalar" ;
KW_Bool         = "Bool" ;
KW_Proposition  = "Proposition" ;
KW_Proof        = "Proof" ;

(* 语句关键字 *)
KW_Let          = "Let" ;
KW_Constraint   = "Constraint" ;
KW_Assume       = "Assume" ;
KW_Assert       = "Assert" ;
KW_Prove        = "Prove" ;
KW_Compute      = "Compute" ;
KW_Normalize    = "Normalize" ;
KW_Export       = "Export" ;
KW_Import       = "Import" ;
KW_Module       = "module" ;
KW_Axiom        = "Axiom" ;
KW_Theorem      = "Theorem" ;
KW_by           = "by" ;
KW_apply        = "apply" ;
KW_normalize    = "normalize" ;
KW_contradiction = "contradiction" ;
KW_qed          = "qed" ;
KW_return       = "return" ;

(* 定义关键字 (v3.5.0) *)
KW_Define       = "Define" ;
KW_Macro        = "Macro" ;
KW_Extend       = "Extend" ;
KW_Syntax       = "Syntax" ;
KW_operator     = "operator" ;
KW_keyword      = "keyword" ;
KW_function     = "function" ;
KW_maps         = "maps" ;
KW_to           = "to" ;
KW_precedence   = "precedence" ;
KW_as           = "as" ;

(* 逻辑关键字 *)
KW_forall       = "forall" | "∀" ;
KW_exists       = "exists" | "∃" ;
KW_not          = "not" | "¬" ;
KW_and          = "and" | "∧" ;
KW_or           = "or" | "∨" ;
KW_implies      = "implies" | "->" | "→" ;
KW_iff          = "iff" | "<->" | "↔" ;
KW_true         = "true" ;
KW_false        = "false" ;
KW_bottom       = "bottom" | "⊥" ;

(* 版本控制 *)
KW_version      = "#version" ;

(* ============================================================
 * 3. 符号 (Symbols)
 * ============================================================ *)

(* 3.1 标点符号 *)
SYM_Semicolon   = ";" ;
SYM_Colon       = ":" ;
SYM_Comma       = "," ;
SYM_Dot         = "." ;
SYM_LParen      = "(" ;
SYM_RParen      = ")" ;
SYM_LBrace      = "{" ;
SYM_RBrace      = "}" ;
SYM_LBracket    = "[" ;
SYM_RBracket    = "]" ;
SYM_Arrow       = "->" ;
SYM_DoubleArrow = "=>" ;

(* 3.2 运算符 *)
OP_Assign       = "=" ;
OP_Equal        = "==" | "=" ;
OP_NotEqual     = "!=" | "≠" ;
OP_Less         = "<" ;
OP_LessEqual    = "<=" ;
OP_Greater      = ">" ;
OP_GreaterEqual = ">=" ;
OP_Plus         = "+" ;
OP_Minus        = "-" ;
OP_Multiply     = "*" ;
OP_Divide       = "/" ;
OP_Power        = "^" ;

(* 3.3 逻辑符号（Unicode 替代） *)
SYM_Forall      = "∀" ;
SYM_Exists      = "∃" ;
SYM_Not         = "¬" ;
SYM_And         = "∧" ;
SYM_Or          = "∨" ;
SYM_Implies     = "→" ;
SYM_Iff         = "↔" ;
SYM_Bottom      = "⊥" ;
SYM_Derivable   = "|-" | "⊢" ;
SYM_Models      = "|=" | "⊨" ;
SYM_Rewrite     = "⇝" ;
SYM_Therefore   = "∴" ;
SYM_Parallel    = "∥" ;
SYM_Perpendicular = "⊥" ;
SYM_Congruent   = "≅" ;
SYM_Similar     = "~" ;
SYM_In          = "∈" ;

(* ============================================================
 * 4. 程序结构 (Program Structure)
 * ============================================================ *)

Program             = [ VersionDecl ] , { ImportDecl } , { Statement } ;

VersionDecl         = KW_version , VersionNumber ;
VersionNumber       = Integer , "." , Integer , "." , Integer ;

ImportDecl          = KW_Import , QualifiedName , [ KW_as , Identifier ] , SYM_Semicolon ;

Statement           = DeclarationStmt
                    | ConstraintStmt
                    | AssumeStmt
                    | AssertStmt
                    | ProveStmt
                    | LetStmt
                    | ComputeStmt
                    | NormalizeStmt
                    | ExportStmt
                    | AxiomStmt
                    | TheoremStmt
                    | DefineStmt
                    | MacroStmt
                    | ExtendStmt
                    ;

(* ============================================================
 * 5. 类型系统 (Type System)
 * ============================================================ *)

Type                = EntityType | FunctionType | SetType ;

EntityType          = KW_Point
                    | KW_Line
                    | KW_Circle
                    | KW_Segment
                    | KW_Ray
                    | KW_Angle
                    | KW_Triangle
                    | KW_Polygon
                    | KW_Scalar
                    | KW_Bool
                    | KW_Proposition
                    | KW_Proof
                    ;

FunctionType        = SYM_LParen , [ TypeList ] , SYM_RParen , SYM_Arrow , Type ;
TypeList            = Type , { SYM_Comma , Type } ;

SetType             = "Set" , "<" , Type , ">" ;

(* ============================================================
 * 6. 几何声明 (Geometric Declarations)
 * ============================================================ *)

DeclarationStmt     = EntityType , IdentifierList , SYM_Semicolon ;
IdentifierList      = Identifier , { SYM_Comma , Identifier } ;

(* ============================================================
 * 7. 绑定与构造 (Binding and Construction)
 * ============================================================ *)

LetStmt             = KW_Let , Identifier , SYM_Colon , Type , OP_Assign , Expr , SYM_Semicolon ;

(* ============================================================
 * 8. 约束语句 (Constraint Statements)
 * ============================================================ *)

ConstraintStmt      = KW_Constraint , ConstraintExpr , SYM_Semicolon ;

ConstraintExpr      = RelationExpr
                    | MetricExpr , CompareOp , MetricExpr
                    | ConstraintExpr , LogicalAnd , ConstraintExpr
                    ;

RelationExpr        = RelationName , SYM_LParen , [ ArgList ] , SYM_RParen ;

RelationName        = "collinear"
                    | "parallel"
                    | "perpendicular"
                    | "congruent"
                    | "tangent"
                    | "incident"
                    | "between"
                    | "on"
                    | "inside"
                    | "outside"
                    ;

CompareOp           = OP_Equal | OP_NotEqual | OP_Less | OP_LessEqual | OP_Greater | OP_GreaterEqual ;
LogicalAnd          = KW_and | SYM_And ;

ArgList             = Expr , { SYM_Comma , Expr } ;

(* ============================================================
 * 9. 逻辑判断语句 (Logical Judgment Statements)
 * ============================================================ *)

AssumeStmt          = KW_Assume , LogicExpr , SYM_Semicolon ;
AssertStmt          = KW_Assert , LogicExpr , SYM_Semicolon ;
ProveStmt           = KW_Prove , LogicExpr , SYM_Semicolon ;

AxiomStmt           = KW_Axiom , Identifier , SYM_Colon , LogicExpr , SYM_Semicolon ;
TheoremStmt         = KW_Theorem , Identifier , SYM_Colon , LogicExpr , [ ProofBlock ] ;

ProofBlock          = SYM_LBrace , { ProofCommand } , SYM_RBrace ;
ProofCommand        = ( KW_by | KW_apply ) , Identifier , SYM_Semicolon
                    | KW_normalize , SYM_Semicolon
                    | KW_contradiction , SYM_Semicolon
                    | KW_qed , SYM_Semicolon
                    ;

(* ============================================================
 * 10. 逻辑表达式 (Logical Expressions)
 * ============================================================ *)

LogicExpr           = IffExpr ;

IffExpr             = ImpliesExpr , { ( KW_iff | SYM_Iff ) , ImpliesExpr } ;
ImpliesExpr         = OrExpr , { ( KW_implies | SYM_Implies ) , OrExpr } ;
OrExpr              = AndExpr , { ( KW_or | SYM_Or ) , AndExpr } ;
AndExpr             = NotExpr , { ( KW_and | SYM_And ) , NotExpr } ;
NotExpr             = ( KW_not | SYM_Not ) , NotExpr
                    | QuantifiedExpr
                    | PredicateExpr
                    ;

QuantifiedExpr      = Quantifier , BinderList , SYM_Dot , LogicExpr ;
Quantifier          = KW_forall | KW_exists ;
BinderList          = Binder , { SYM_Comma , Binder } ;
Binder              = Identifier , SYM_Colon , Type ;

PredicateExpr       = RelationExpr
                    | MetricExpr , CompareOp , MetricExpr
                    | KW_true
                    | KW_false
                    | KW_bottom
                    ;

SYM_Dot             = "." ;

(* ============================================================
 * 11. 运算表达式 (Arithmetic Expressions)
 * ============================================================ *)

Expr                = LogicExpr | MetricExpr | GeometryExpr | Identifier | Literal ;

MetricExpr          = AddExpr ;

AddExpr             = MulExpr , { ( OP_Plus | OP_Minus ) , MulExpr } ;
MulExpr             = PowExpr , { ( OP_Multiply | OP_Divide ) , PowExpr } ;
PowExpr             = UnaryExpr , [ OP_Power , UnaryExpr ] ;
UnaryExpr           = ( OP_Plus | OP_Minus ) , UnaryExpr | PrimaryExpr ;

PrimaryExpr         = Literal
                    | Identifier
                    | FunctionCall
                    | MeasureExpr
                    | SYM_LParen , Expr , SYM_RParen
                    ;

Literal             = Number | String | KW_true | KW_false ;

FunctionCall        = Identifier , SYM_LParen , [ ArgList ] , SYM_RParen ;

MeasureExpr         = MeasureName , SYM_LParen , ArgList , SYM_RParen ;

MeasureName         = "length"
                    | "distance"
                    | "angle"
                    | "measure"
                    | "area"
                    | "radius"
                    ;

(* ============================================================
 * 12. 几何表达式 (Geometric Expressions)
 * ============================================================ *)

GeometryExpr        = PointExpr | LineExpr | CircleExpr | SegmentExpr | RayExpr | TriangleExpr ;

PointExpr           = "point" , SYM_LParen , MetricExpr , SYM_Comma , MetricExpr , SYM_RParen ;
LineExpr            = "line" , SYM_LParen , Expr , SYM_Comma , Expr , SYM_RParen ;
CircleExpr          = "circle" , SYM_LParen , Expr , SYM_Comma , MetricExpr , SYM_RParen ;
SegmentExpr         = "segment" , SYM_LParen , Expr , SYM_Comma , Expr , SYM_RParen ;
RayExpr             = "ray" , SYM_LParen , Expr , SYM_Comma , Expr , SYM_RParen ;
TriangleExpr        = "triangle" , SYM_LParen , Expr , SYM_Comma , Expr , SYM_Comma , Expr , SYM_RParen ;

(* ============================================================
 * 13. 命令式演算语句 (Imperative Computation Statements)
 * ============================================================ *)

ComputeStmt         = KW_Compute , Expr , SYM_Semicolon ;

NormalizeStmt       = KW_Normalize , ( Identifier | "all" ) , SYM_Semicolon ;

ExportStmt          = KW_Export , ExportTarget , KW_as , ExportFormat , [ String ] , SYM_Semicolon ;
ExportTarget        = Identifier | "proof" | "graph" | "theory" ;
ExportFormat        = "json" | "latex" | "tikz" | "lean" | "coq" | "text" ;

(* ============================================================
 * 14. 自定义扩展语句 (v3.5.0 新增)
 * ============================================================ *)

DefineStmt          = KW_Define , Identifier , SYM_LParen , [ ParamList ] , SYM_RParen , 
                      [ SYM_Arrow , Type ] , SYM_LBrace , { Statement } , SYM_RBrace ;

ParamList           = Param , { SYM_Comma , Param } ;
Param               = Identifier , SYM_Colon , Type ;

MacroStmt           = KW_Macro , Identifier , OP_Assign , Expr , SYM_Semicolon ;

ExtendStmt          = KW_Extend , KW_Syntax , SYM_LBrace , { SyntaxExtension } , SYM_RBrace ;

SyntaxExtension     = OperatorDef | KeywordDef | FunctionDef ;

OperatorDef         = KW_operator , String , KW_as , Identifier , KW_precedence , Integer ;
KeywordDef          = KW_keyword , String , KW_maps , KW_to , Identifier ;
FunctionDef         = Identifier , SYM_LParen , [ TypeList ] , SYM_RParen , SYM_Arrow , Type ;

(* ============================================================
 * 15. 注释与文档 (Comments and Documentation)
 * ============================================================ *)

(* 行注释：// 注释内容 *)
(* 块注释：/* 注释内容 */ *)
(* 文档注释：/** 文档内容 */ - 用于生成 API 文档 *)

(* ============================================================
 * 16. 优先级表 (Operator Precedence)
 * ============================================================ *)

(* 从高到低：
 * 1. 函数调用、度量表达式、括号
 * 2. 幂运算 ^
 * 3. 一元 + -
 * 4. 乘法 * 除法 /
 * 5. 加法 + 减法 -
 * 6. 比较运算符 = != < <= > >=
 * 7. 逻辑非 not ¬
 * 8. 逻辑与 and ∧
 * 9. 逻辑或 or ∨
 * 10. 蕴含 implies →
 * 11. 等价 iff ↔
 *)

(* ============================================================
 * 17. 示例 (Examples)
 * ============================================================ *)

(*
 * 示例 1: 等腰三角形声明与证明目标
 * 
 * #version 3.5.0
 * Point A, B, C;
 * Constraint length(A,B) = length(A,C);
 * Prove angle(A,B,C) = angle(B,C,A);
 *)

(*
 * 示例 2: 自定义函数
 * 
 * #version 3.5.0
 * Define midpoint(A: Point, B: Point) -> Point {
 *     Let M : Point = point((A.x + B.x)/2, (A.y + B.y)/2);
 *     return M;
 * }
 *)

(*
 * 示例 3: 语法扩展
 * 
 * #version 3.5.0
 * Extend Syntax {
 *     operator "~>" as "leads_to" precedence 100;
 *     keyword "orthocenter" maps to "orthocenter";
 * }
 *)

(* ============================================================
 * 18. 与自举原语的映射 (Mapping to Bootstrap Primitives)
 * ============================================================ *)

(*
 * Lv-00 DSL 语句 → 13 个最小原语
 * 
 * DeclarationStmt (Point A, B, C)  → geo-create-node
 * ConstraintStmt                  → geo-create-constraint
 * LetStmt (几何构造)              → geo-create-node + geo-create-constraint
 * ProveStmt                       → geo-prove
 * ComputeStmt                     → geo-solve
 * NormalizeStmt                   → geo-normalize
 * ExportStmt                      → geo-export
 * DefineStmt (函数块打包)         → geo-pack
 * FunctionCall (预设函数)         → geo-instantiate
 * TheoremStmt                     → geo-prove + geo-export
 *)

(* ============================================================
 * 19. 版本历史 (Version History)
 * ============================================================ *)

