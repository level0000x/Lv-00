@PACKAGE_INIT@

# ---- Lv-00 CMake 包配置文件 ----
# 由 CMake 的 configure_package_config_file() 自动生成
# 使用方式：
#   find_package(lv 3.5.0 REQUIRED)
#   target_link_libraries(myapp lv::lv)

include(CMakeFindDependencyMacro)

# ---- 版本兼容性检查 ----
set(PACKAGE_VERSION "@PROJECT_VERSION@")
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()

# ---- 提供导入目标 ----
# 前置依赖：lv_static/lv_shared 接口含 Threads::Threads（导出 targets 需先解析）
find_package(Threads REQUIRED)

if(NOT TARGET lv::lv)
    include("${CMAKE_CURRENT_LIST_DIR}/lv-targets.cmake" OPTIONAL RESULT_VARIABLE _lv_targets_file)
    if(_lv_targets_file)
        # 导出目标名为 lv::lv_static / lv::lv_shared；统一别名 lv::lv（默认优先 shared）
        if(TARGET lv::lv_shared)
            add_library(lv::lv ALIAS lv::lv_shared)
        elseif(TARGET lv::lv_static)
            add_library(lv::lv ALIAS lv::lv_static)
        endif()
    endif()
    if(NOT TARGET lv::lv)
        # 回退：如果未找到 targets 文件，尝试直接链接库
        add_library(lv::lv UNKNOWN IMPORTED)
        set_target_properties(lv::lv PROPERTIES
            IMPORTED_LOCATION "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@lv@CMAKE_STATIC_LIBRARY_SUFFIX@"
            INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@"
        )
    endif()
endif()

# ---- K18/F96：shared 库使用时定义 lv_USE_SHARED（Windows dllimport） ----
if(TARGET lv::lv)
    get_target_property(_lv_target_type lv::lv TYPE)
    if(NOT _lv_target_type STREQUAL "STATIC_LIBRARY")
        set_property(TARGET lv::lv APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS lv_USE_SHARED)
    endif()
endif()

# ---- GMP 依赖 ----
# 项目自身用 find_path/find_library 定位 GMP（无 FindGMP.cmake 模块），
# find_dependency(GMP) 在消费方会失败。此处同样用 find_library 定位并挂到
# lv::lv 接口链接；找不到时置空（消费方若链接报错需自行提供 gmp）。
if(NOT TARGET lv::lv)
    # targets 未加载（罕见回退路径），下面不附加 GMP
else()
    find_library(lv_GMP_LIBRARY gmp)
    if(lv_GMP_LIBRARY)
        set_property(TARGET lv::lv APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${lv_GMP_LIBRARY}")
    endif()
endif()

# ---- 设置全局变量（向后兼容） ----
set(lv_FOUND TRUE)
set(lv_VERSION "${PACKAGE_VERSION}")
set(lv_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@")
set(lv_LIBRARIES lv::lv)
