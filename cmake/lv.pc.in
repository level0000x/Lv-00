prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_LIBDIR@
includedir=@CMAKE_INSTALL_INCLUDEDIR@

Name: lv
Description: Lv-00 - Geometric Meta-Language for Theoretical Mathematics
Version: @PROJECT_VERSION@
URL: https://github.com/lv-project/lv

Libs: -L${libdir} -llv
Cflags: -I${includedir}
Requires: gmp
