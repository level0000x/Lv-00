{
  "project": {
    "name": "Lv-00 UI",
    "version": "1.0.0",
    "description": "几何元语言多模态交互界面 — 全自动生成系统",
    "root": "lv00-ui/"
  },
  "architecture": {
    "layers": [
      { "id": "L1", "name": "裸核引擎", "lang": "C11", "form": "liblv00_core.so", "notes": "已存在，通过 C ABI 调用" },
      { "id": "L2", "name": "编辑控制器", "lang": "C++17", "form": "liblv00_editor.a", "notes": "撤销栈 + 增量日志 + L1 封装" },
      { "id": "L3", "name": "多模态投影引擎", "lang": "TypeScript", "form": "TypeScript 模块", "notes": "6 种投影方法 + 选择管理" },
      { "id": "L4", "name": "模态视图组件", "lang": "TypeScript+React", "form": "6 个独立 NPM 包", "notes": "M1~M6" },
      { "id": "L5", "name": "外壳适配器", "lang": "TypeScript/C++", "form": "Qt 应用 + VSCode 插件", "notes": "两种外壳" },
      { "id": "L6", "name": "共享视觉语言", "lang": "TypeScript/CSS", "form": "静态常量模块", "notes": "颜色/图标/Z-Index/线型" }
    ],
    "dataFlow": "用户 → L4 模态视图 → Command → L3 SceneController → L2 EditorController → L1 内核 → Delta → L2 → L3 → L4 重新渲染",
    "keyPrinciples": [
      "单向数据流：所有修改必须经过 L2 → L1",
      "增量 Delta：L1 只返回变化部分",
      "推送+轮询混合：L2 回调通知 L3，L3 主动拉取"
    ]
  },
  "tasks": [
    { "id": "task_01", "name": "项目骨架", "output": ["package.json", "tsconfig.json", "目录结构"], "deps": [], "status": "done" },
    { "id": "task_02", "name": "协议定义", "output": "packages/protocol/src/index.ts", "deps": ["task_01"], "status": "done" },
    { "id": "task_03", "name": "Mock 内核", "output": "packages/mock-kernel/src/index.ts", "deps": ["task_02"], "status": "done" },
    { "id": "task_04", "name": "L3 场景控制器", "output": "packages/scene-controller/src/index.ts", "deps": ["task_02"], "status": "done" },
    { "id": "task_05", "name": "M1 几何画布", "output": "packages/modal-canvas/src/CanvasView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_06", "name": "M2 文本编辑器", "output": "packages/modal-text/src/TextView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_07", "name": "M3 属性表格", "output": "packages/modal-table/src/TableView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_08", "name": "M4 依赖树", "output": "packages/modal-tree/src/TreeView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_09", "name": "M5 终端", "output": "packages/modal-terminal/src/TerminalView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_10", "name": "M6 拓扑视图", "output": "packages/modal-topology/src/TopologyView.tsx", "deps": ["task_04"], "status": "done" },
    { "id": "task_11", "name": "L6 视觉语言", "output": "packages/visual-language/src/index.ts", "deps": ["task_01"], "status": "done" },
    { "id": "task_12", "name": "Qt 独立应用", "output": "shells/qt-standalone/", "deps": ["task_04", "task_11"], "status": "done" },
    { "id": "task_13", "name": "VSCode 插件", "output": "shells/vscode-extension/", "deps": ["task_04", "task_11"], "status": "done" },
    { "id": "task_14", "name": "集成测试", "output": "tests/", "deps": ["task_01","task_02","task_03","task_04","task_05","task_06","task_07","task_08","task_09","task_10","task_11","task_12","task_13"], "status": "done" }
  ],
  "visualSpec": {
    "darkTheme": {
      "background": "#0a0a0a",
      "panel": "#111111",
      "border": "#222222",
      "text": "#c8c8c8",
      "textDim": "#666666",
      "accent": "#4caf50",
      "warning": "#ff9800",
      "error": "#f44336"
    },
    "trustColors": {
      "GREEN": { "hex": "#22C55E", "desc": "全构造" },
      "LIGHT_GREEN": { "hex": "#86EFAC", "desc": "标准化构造" },
      "YELLOW": { "hex": "#EAB308", "desc": "约束求解" },
      "ORANGE": { "hex": "#FB923C", "desc": "数值近似" },
      "DARK_ORANGE": { "hex": "#EA580C", "desc": "非构造性+假设" },
      "RED": { "hex": "#EF4444", "desc": "矛盾节点" },
      "GRAY": { "hex": "#9CA3AF", "desc": "未初始化" },
      "BLUE": { "hex": "#3B82F6", "desc": "用户输入" },
      "PURPLE": { "hex": "#A855F7", "desc": "形式化验证" },
      "CYAN": { "hex": "#06B6D4", "desc": "互操作/FFI" }
    },
    "zIndex": {
      "CANVAS_GRID": 1,
      "CANVAS_OBJECTS": 2,
      "CANVAS_HIGHLIGHT": 5,
      "TOOLBAR": 10,
      "CONTEXT_MENU": 50,
      "TOOLTIP": 100,
      "MODAL_OVERLAY": 200,
      "MODAL_CONTENT": 1000,
      "NOTIFICATION": 2000
    },
    "lineStyles": {
      "SOLID": { "dashArray": [], "width": 2 },
      "DASHED": { "dashArray": [8, 6], "width": 1.5 },
      "DOTTED": { "dashArray": [3, 5], "width": 1 }
    },
    "panelLayout": {
      "leftSidebar": "260px",
      "rightSidebar": "260px",
      "mainArea": "flex:1",
      "padding": "12px 14px"
    }
  },
  "techStack": {
    "L4": {
      "framework": "React 18 + TypeScript",
      "build": "Vite",
      "state": "Zustand",
      "math": "KaTeX"
    },
    "M1_canvas": "HTML Canvas 2D",
    "M2_text": "Monaco Editor",
    "M3_table": "AG Grid Community",
    "M4_tree": "Custom React Tree",
    "M5_terminal": "Xterm.js",
    "M6_topology": "React Flow",
    "L5a_qt": "Qt 6.5+ (QWidgets + QOpenGLWidget)",
    "L5b_vscode": "VSCode Extension API + node-addon-api",
    "communication": "WebSocket / stdio JSON-RPC",
    "serialization": "JSON (调试) / FlatBuffers (生产)"
  }
}
