        category "TOPOLOGY"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "X \\text{ 是 } T_0 \\Leftrightarrow \\forall x \\neq y, \"
                       \"\\exists U \\in \\mathcal{T}: (x \\in U, y \\notin U) \\lor (y \\in U, x \\notin U)"
        complexity "O(|X|² |\\mathcal{T}|)"
        constructive true
        reversible false
    }

    preset "t1_space_test" {
