        category "TOPOLOGY"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "X \\text{ 是 } T_2 \\Leftrightarrow \\forall x \\neq y, \\exists U, V \\in \\mathcal{T}: x \\in U, y \\in V, U ∩ V = \\emptyset"
        complexity "O(|X|² |\\mathcal{T}|²)"
        constructive true
        reversible false
    }

    preset "t3_space_test" {
        description "判定是否是 T3 (正则) 空间"
        category "TOPOLOGY"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "X \\text{ 正则} \\Leftrightarrow T_1 + \\forall x, \\forall \\text{闭集} F \\not\\ni x, \\exists U, V \\in \\mathcal{T}: x \\in U, F \\subseteq V, U ∩ V = \\emptyset"
        complexity "O(|X|² |\\mathcal{T}|²)"
        constructive true
        reversible false
    }

    preset "t4_space_test" {
