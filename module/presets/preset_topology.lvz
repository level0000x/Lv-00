        math_def "\\mathcal{T}_{X×Y} = \\text{由 } \\{U × V : U \\in \\mathcal{T}_X, V \\in \\mathcal{T}_Y\\} \\text{ 生成}"
        complexity "O(|\\mathcal{T}_X| × |\\mathcal{T}_Y|)"
        constructive true
        reversible false
    }

    preset "subspace_topology" {
