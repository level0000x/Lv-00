        category "TOPOLOGY"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "X \\text{ 正规} \\Leftrightarrow T_1 + \\forall \\text{闭集} E, F \\text{ 不相交}, \\exists U, V \\in \\mathcal{T}: E \\subseteq U, F \\subseteq V, U ∩ V = \\emptyset"
        complexity "O(|X|² |\\mathcal{T}|²)"
        constructive true
        reversible false
    }

