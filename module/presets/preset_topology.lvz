        constructive true
        reversible false
    }

    preset "boundary" {
        description "计算集合的边界"
        category "TOPOLOGY"
        inputs 2 "SPACE" "SET"
        output "SET"
        math_def "\\partial A = \\bar{A} \\setminus A^\\circ"
        complexity "O(|\\mathcal{T}|)"
        constructive true
        reversible false
    }

    preset "neighborhood_test" {
