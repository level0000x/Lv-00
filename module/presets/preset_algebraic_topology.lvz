    }

    preset "at_barycentric_subdivision" {
        description "重心重分：计算单纯复形的重心重分 Sd(K)，细化网格但保持几何实现"
        category "TOPOLOGY"
        inputs 1 "STRUCTURE"
        output "STRUCTURE"
        math_def "\\operatorname{Sd}(K), \\quad |\\operatorname{Sd}(K)| = |K|"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "at_simplicial_approx" {
        description "单纯逼近：构造连续映射的单纯逼近 g: K -> L 满足 |g| ≈ f"
        category "TOPOLOGY"
        inputs 1 "FUNCTION"
        output "FUNCTION"
        math_def "g: K \\to L \\text{ 是 } f: |K| \\to |L| \\text{ 的单纯逼近}"
