lvz 1

presets {

    preset "prop_and" {
        description "命题合取：P ∧ Q，当且仅当 P 和 Q 均为真时结果为真"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\land Q \\equiv \\begin{cases} \\text{T} & P = \\text{T} \\land Q = \\text{T} \\\\ \\text{F} & \\text{otherwise} \\end{cases}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "prop_or" {
        description "命题析取：P ∨ Q，当 P 或 Q 至少一个为真时结果为真"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\lor Q \\equiv \\begin{cases} \\text{F} & P = \\text{F} \\land Q = \\text{F} \\\\ \\text{T} & \\text{otherwise} \\end{cases}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "prop_not" {
        description "命题否定：¬P，当 P 为真时结果为假，反之亦然"
        category "LOGIC"
        inputs 1 "BOOLEAN"
        output "BOOLEAN"
        math_def "\\lnot P \\equiv \\begin{cases} \\text{F} & P = \\text{T} \\\\ \\text{T} & P = \\text{F} \\end{cases}"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "prop_implies" {
        description "命题蕴涵：P → Q，等价于 ¬P ∨ Q，仅在 P 真且 Q 假时为假"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\to Q \\equiv \\lnot P \\lor Q \\equiv \\begin{cases} \\text{F} & P = \\text{T}, Q = \\text{F} \\\\ \\text{T} & \\text{otherwise} \\end{cases}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "prop_iff" {
        description "命题等价：P ↔ Q，当 P 和 Q 真值相同时结果为真"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\leftrightarrow Q \\equiv (P \\to Q) \\land (Q \\to P)"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "prop_xor" {
        description "命题异或：P ⊕ Q，当 P 和 Q 恰好一个为真时结果为真"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\oplus Q \\equiv (P \\lor Q) \\land \\lnot(P \\land Q)"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "prop_nand" {
        description "命题与非：P ↑ Q ≡ ¬(P ∧ Q)，Sheffer竖线，功能完备联结词"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\uparrow Q \\equiv \\lnot(P \\land Q)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "prop_nor" {
        description "命题或非：P ↓ Q ≡ ¬(P ∨ Q)，Peirce箭头，功能完备联结词"
        category "LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\downarrow Q \\equiv \\lnot(P \\lor Q)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "prop_tautology_check" {
        description "重言式判定：判定命题公式是否对所有真值指派均为真"
        category "LOGIC"
        inputs 1 "EXPRESSION"
        output "BOOLEAN"
        math_def "\\varphi \\text{ 是重言式} \\Leftrightarrow \\forall v \\in \\{0,1\\}^n: v(\\varphi) = \\text{T}"
        complexity "O(2^n)，n 为命题变元数"
        constructive true
        reversible false
    }

    preset "prop_contradiction_check" {
