lvz 1

presets {

    preset "linalg_matrix_create" {
        description "矩阵创建：根据行数和列数创建 m x n 零矩阵"
        category "LINEAR_ALGEBRA"
        inputs 2 "INTEGER" "INTEGER"
        output "MATRIX"
        math_def "O_{m \\times n} = (o_{ij});_{1 \\le i \\le m, 1 \\le j \\le n}"
        complexity "O(mn)"
        constructive true
        reversible false
    }

    preset "linalg_matrix_add" {
        description "矩阵加法：计算两个同阶矩阵的和 C = A + B，对应元素相加"
        category "LINEAR_ALGEBRA"
        inputs 2 "MATRIX" "MATRIX"
        output "MATRIX"
        math_def "C_{ij} = A_{ij} + B_{ij}"
        complexity "O(n^2);"
        constructive true
        reversible true
    }

    preset "linalg_matrix_subtract" {
        description "矩阵减法：计算两个同阶矩阵的差 C = A - B，对应元素相减"
        category "LINEAR_ALGEBRA"
        inputs 2 "MATRIX" "MATRIX"
        output "MATRIX"
        math_def "C_{ij} = A_{ij} - B_{ij}"
        complexity "O(n^2);"
        constructive true
        reversible true
    }

    preset "linalg_matrix_multiply" {
        description "矩阵乘法：计算两个矩阵的乘积 C = A * B，行与列的点积"
        category "LINEAR_ALGEBRA"
        inputs 2 "MATRIX" "MATRIX"
        output "MATRIX"
        math_def "C_{ij} = \\sum_{k=1}^{n} A_{ik} \\cdot B_{kj}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_matrix_scale" {
        description "矩阵标量乘法：计算标量与矩阵的乘积 B = k * A"
        category "LINEAR_ALGEBRA"
        inputs 2 "SCALAR" "MATRIX"
        output "MATRIX"
        math_def "B_{ij} = k \\cdot A_{ij}"
        complexity "O(n^2);"
        constructive true
        reversible true
    }

    preset "linalg_matrix_transpose" {
        description "矩阵转置：将矩阵的行与列互换，得到转置矩阵 A^T"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "(A^T);_{ij} = A_{ji}"
        complexity "O(n^2)"
        constructive true
        reversible true
    }

    preset "linalg_matrix_trace" {
        description "矩阵迹：计算方阵主对角线元素之和 tr(A); = sum(a_ii)"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "SCALAR"
        math_def "\\text{tr}(A) = \\sum_{i=1}^{n} a_{ii}"
        complexity "O(n)"
        constructive false
        reversible false
    }

    preset "linalg_matrix_negate" {
        description "矩阵取负：计算矩阵的负矩阵 B = -A，每个元素取反"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "B_{ij} = -A_{ij}"
        complexity "O(n^2);"
        constructive true
        reversible true
    }

    preset "linalg_determinant_2x2" {
        description "2x2行列式：det(A); = ad - bc"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "SCALAR"
        math_def "\\det\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix} = ad - bc"
        complexity "O(1)"
        constructive false
        reversible false
    }

    preset "linalg_determinant_3x3" {
        description "3x3行列式：按第一行展开计算 det(A);"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "SCALAR"
        math_def "\\det(A) = a(ei-fh) - b(di-fg) + c(dh-eg)"
        complexity "O(1)"
        constructive false
        reversible false
    }

    preset "linalg_determinant_n" {
        description "n阶行列式：使用LU分解或余子式展开计算方阵的行列式"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "SCALAR"
        math_def "\\det(A); = \\sum_{\\sigma \\in S_n} \\text{sgn}(\\sigma) \"
                       \"\\prod_{i=1}^{n} a_{i,\\sigma(i)}"
        complexity "O(n^3)"
        constructive false
        reversible false
    }

    preset "linalg_inverse_2x2" {
        description "2x2逆矩阵：A^{-1} = (1/det(A);) * adj(A)"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "A^{-1} = \\frac{1}{ad-bc} \\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix}"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "linalg_inverse_3x3" {
        description "3x3逆矩阵：使用伴随矩阵法计算 A^{-1} = adj(A);/det(A)"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "A^{-1} = \\frac{\\text{adj}(A)}{\\det(A)}"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "linalg_adjugate" {
        description "伴随矩阵：计算方阵的伴随矩阵 adj(A);，元素为代数余子式的转置"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "\\text{adj}(A)_{ij} = C_{ji} = (-1)^{i+j} M_{ji}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "linalg_lu_decomposition" {
        description "LU分解：将方阵分解为下三角矩阵 L 和上三角矩阵 U 的乘积 A = LU"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "TUPLE"
        math_def "A = LU, \\quad L \\text{ 为下三角矩阵}, U \\text{ 为上三角矩阵}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_qr_decomposition" {
        description "QR分解：将矩阵分解为正交矩阵 Q 和上三角矩阵 R 的乘积 A = QR"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "TUPLE"
        math_def "A = QR, \\quad Q^T Q = I, \\quad R \\text{ 为上三角矩阵}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_cholesky" {
        description "Cholesky分解：将正定对称矩阵分解为 A = L * L^T"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "A = LL^T, \\quad A \\text{ 正定对称}, L \\text{ 下三角矩阵}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_eigenvalues_2x2" {
        description "2x2矩阵特征值：求解特征方程 det(A - lambda*I); = 0"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "LIST"
        math_def "\\lambda = \\frac{\\text{tr}(A) \\pm \\sqrt{\\text{tr}(A)^2 - 4\\det(A)}}{2}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "linalg_eigenvectors_2x2" {
        description "2x2矩阵特征向量：计算对应于给定特征值的特征向量"
        category "LINEAR_ALGEBRA"
        inputs 2 "MATRIX" "SCALAR"
        output "LIST"
        math_def "Av = \\lambda v, \\quad v \\neq 0"
        complexity "O(1);"
        constructive true
        reversible false
    }

    preset "linalg_vector_space_test" {
        description "向量空间判定：验证集合在给定加法和标量乘法下是否满足向量空间公理"
        category "LINEAR_ALGEBRA"
        inputs 3 "SET" "FUNCTION" "FUNCTION"
        output "BOOLEAN"
        math_def "V \\text{ 是向量空间} \\Leftrightarrow \"
                       \"\\text{封闭性 + 交换律 + 结合律 + 存在零元/逆元 + 分配律}"
        complexity "O(n^2);"
        constructive false
        reversible false
    }

    preset "linalg_linear_independence" {
        description "线性无关判定：验证向量组 {v1,...,vk} 是否线性无关"
        category "LINEAR_ALGEBRA"
        inputs 1 "LIST"
        output "BOOLEAN"
        math_def "\\sum_{i=1}^{k} c_i v_i = 0 \\Rightarrow c_1 = \\cdots = c_k = 0"
        complexity "O(n^3);"
        constructive false
        reversible false
    }

    preset "linalg_span" {
        description "生成空间：计算向量组 {v1,...,vk} 的线性生成空间 span{v1,...,vk}"
        category "LINEAR_ALGEBRA"
        inputs 1 "LIST"
        output "SET"
        math_def "\\text{span}\\{v_1, \\ldots, v_k\\} = \"
                       \"\\left\\{\\sum_{i=1}^{k} c_i v_i : c_i \\in \\mathbb{F}\\right\\}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_basis" {
        description "基：计算向量空间的一组基（极大线性无关组）"
        category "LINEAR_ALGEBRA"
        inputs 1 "SET"
        output "LIST"
        math_def "\\mathcal{B} = \\{e_1, \\ldots, e_n\\}, \\quad \"
                       \"\\text{线性无关且 } \\text{span}(\\mathcal{B}); = V"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "linalg_dimension" {
        description "维数：计算向量空间的维数 dim(V);（基中元素个数）"
        category "LINEAR_ALGEBRA"
        inputs 1 "SET"
        output "INTEGER"
        math_def "\\dim(V) = |\\mathcal{B}|, \\quad \"
                       \"\\text{所有基的元素个数相同}"
        complexity "O(n^3)"
        constructive false
        reversible false
    }

    preset "linalg_linear_map_test" {
        description "线性映射判定：验证映射 T 是否满足 T(u+v); = T(u)+T(v) 和 T(cv) = cT(v)"
        category "LINEAR_ALGEBRA"
        inputs 1 "FUNCTION"
        output "BOOLEAN"
        math_def "T(\\alpha u + \\beta v) = \\alpha T(u) + \\beta T(v)"
        complexity "O(n^2)"
        constructive false
        reversible false
    }

    preset "linalg_kernel" {
        description "核空间：计算线性映射的核 ker(T); = {v : T(v) = 0} 的基"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "LIST"
        math_def "\\ker(T) = \\{v \\in V : T(v) = 0\\}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "linalg_image" {
        description "像：计算线性映射的像空间 Im(T); = {T(v) : v in V} 的基"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "LIST"
        math_def "\\text{Im}(T) = \\{T(v) : v \\in V\\} = \"
                       \"\\text{span}\\{T(e_1), \\ldots, T(e_n)\\}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "linalg_rank_nullity" {
        description "秩-零化度定理：验证 rank(T); + nullity(T) = dim(V)"
        category "LINEAR_ALGEBRA"
        inputs 1 "MATRIX"
        output "BOOLEAN"
        math_def "\\text{rank}(T) + \\text{nullity}(T) = \\dim(V)"
        complexity "O(n^3)"
        constructive false
        reversible false
    }

    preset "linalg_inner_product" {
        description "内积：计算内积空间中两个向量的内积 <u, v>"
        category "LINEAR_ALGEBRA"
        inputs 2 "VECTOR" "VECTOR"
        output "SCALAR"
        math_def "\\langle u, v \\rangle = \\sum_{i=1}^{n} u_i \\overline{v_i}"
        complexity "O(n);"
        constructive true
        reversible true
    }

    preset "linalg_gram_schmidt" {
        description "Gram-Schmidt正交化：将线性无关向量组转化为正交向量组"
        category "LINEAR_ALGEBRA"
        inputs 1 "LIST"
        output "LIST"
        math_def "u_k = v_k - \\sum_{i=1}^{k-1} \"
                       \"\\frac{\\langle v_k, u_i \\rangle}{\\langle u_i, u_i \\rangle} u_i"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_orthogonal_complement" {
        description "正交补：计算子空间 W 的正交补 W^perp"
        category "LINEAR_ALGEBRA"
        inputs 1 "SET"
        output "SET"
        math_def "W^\\perp = \\{v : \\langle v, w \\rangle = 0, \\forall w \\in W\\}"
        complexity "O(n^3);"
        constructive true
        reversible false
    }

    preset "linalg_projection" {
        description "子空间投影：计算向量 v 在子空间 W 上的正交投影 proj_W(v);"
        category "LINEAR_ALGEBRA"
        inputs 2 "VECTOR" "SET"
        output "VECTOR"
        math_def "\\text{proj}_W(v) = \\sum_{i=1}^{k} \"
                       \"\\frac{\\langle v, e_i \\rangle}{\\langle e_i, e_i \\rangle} e_i"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

}
