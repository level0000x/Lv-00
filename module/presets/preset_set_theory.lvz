lvz 1

presets {

    preset "set_union" {
        description "并集：A ∪ B = {x : x ∈ A ∨ x ∈ B}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A \\cup B = \\{x : x \\in A \\lor x \\in B\\}"
        complexity "O(|A| + |B|)"
        constructive true
        reversible false
    }

    preset "set_intersection" {
        description "交集：A ∩ B = {x : x ∈ A ∧ x ∈ B}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A \\cap B = \\{x : x \\in A \\land x \\in B\\}"
        complexity "O(min(|A|, |B|))"
        constructive true
        reversible false
    }

    preset "set_difference" {
        description "差集：A \\ B = {x : x ∈ A ∧ x ∉ B}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A \\setminus B = \\{x : x \\in A \\land x \\notin B\\}"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "set_complement" {
        description "补集：A^c = U \\ A = {x ∈ U : x ∉ A}，相对于全集 U"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A^c = U \\setminus A = \\{x \\in U : x \\notin A\\}"
        complexity "O(|U|)"
        constructive true
        reversible true
    }

    preset "set_symmetric_difference" {
        description "对称差：A △ B = (A \\ B) ∪ (B \\ A)"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A \\triangle B = (A \\setminus B) \\cup (B \\setminus A)"
        complexity "O(|A| + |B|)"
        constructive true
        reversible true
    }

    preset "set_cartesian_product" {
        description "笛卡尔积：A × B = {(a, b) : a ∈ A, b ∈ B}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A \\times B = \\{(a, b) : a \\in A, b \\in B\\}"
        complexity "O(|A| \\cdot |B|)"
        constructive true
        reversible false
    }

    preset "set_power_set" {
        description "幂集：P(A) = {S : S ⊆ A}，A 的所有子集构成的集合"
        category "SET_THEORY"
        inputs 1 "SET"
        output "SET"
        math_def "\\mathcal{P}(A) = \\{S : S \\subseteq A\\}, \\quad |\\mathcal{P}(A)| = 2^{|A|}"
        complexity "O(2^{|A|})"
        constructive true
        reversible false
    }

    preset "set_subset_check" {
        description "子集判定：A ⊆ B，判定 A 中每个元素是否都属于 B"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "A \\subseteq B \\Leftrightarrow \\forall x \\in A, x \\in B"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "set_equality_check" {
        description "集合相等判定：A = B 当且仅当 A ⊆ B 且 B ⊆ A（外延公理）"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "A = B \\Leftrightarrow A \\subseteq B \\land B \\subseteq A \\quad \\text{（外延公理）}"
        complexity "O(|A| + |B|)"
        constructive true
        reversible true
    }

    preset "set_empty_check" {
        description "空集判定：A = ∅，判定集合是否不含任何元素"
        category "SET_THEORY"
        inputs 1 "SET"
        output "BOOLEAN"
        math_def "A = \\emptyset \\Leftrightarrow \\lnot \\exists x: x \\in A"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "relation_compose" {
        description "关系复合：R ∘ S = {(a, c) : ∃b, (a,b)∈S ∧ (b,c)∈R}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "R \\circ S = \\{(a, c) : \\exists b, (a,b) \\in S \\land (b,c) \\in R\\}"
        complexity "O(|S| \\cdot |R|)"
        constructive true
        reversible false
    }

    preset "relation_inverse" {
        description "逆关系：R^{-1} = {(b, a) : (a, b) ∈ R}"
        category "SET_THEORY"
        inputs 1 "SET"
        output "SET"
        math_def "R^{-1} = \\{(b, a) : (a, b) \\in R\\}"
        complexity "O(|R|)"
        constructive true
        reversible true
    }

    preset "relation_reflexive_check" {
        description "自反性判定：R 是自反的当且仅当 ∀a ∈ A, (a, a) ∈ R"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "R \\text{ 自反} \\Leftrightarrow \\forall a \\in A, (a, a) \\in R"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "relation_symmetric_check" {
        description "对称性判定：R 是对称的当且仅当 (a,b) ∈ R ⇒ (b,a) ∈ R"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "R \\text{ 对称} \\Leftrightarrow \\forall a, b \\in A, (a,b) \\in R \\Rightarrow (b,a) \\in R"
        complexity "O(|R|)"
        constructive true
        reversible false
    }

    preset "relation_transitive_check" {
        description "传递性判定：R 是传递的当且仅当 (a,b)∈R ∧ (b,c)∈R ⇒ (a,c)∈R"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "R \\text{ 传递} \\Leftrightarrow \\forall a, b, c: (a,b) \\in R \\land (b,c) \\in R \\Rightarrow \"
                       \"(a,c) \\in R"
        complexity "O(|R|^2)"
        constructive true
        reversible false
    }

    preset "relation_equivalence_check" {
        description "等价关系判定：R 是等价关系当且仅当自反 ∧ 对称 ∧ 传递"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "R \\text{ 是等价关系} \\Leftrightarrow \\text{自反}(R) \\land \\text{对称}(R) \\land \\text{传递}(R)"
        complexity "O(|A|^2 \\cdot |R|)"
        constructive true
        reversible false
    }

    preset "equivalence_class" {
        description "等价类：[a]_R = {x ∈ A : (a, x) ∈ R}"
        category "SET_THEORY"
        inputs 3 "SET" "SET" "ANY"
        output "SET"
        math_def "[a]_R = \\{x \\in A : (a, x) \\in R\\}"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "quotient_set" {
        description "商集：A/R = {[a]_R : a ∈ A}，所有等价类构成的集合"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "A/R = \\{[a]_R : a \\in A\\}, \\quad \\pi: A \\to A/R, \\; a \\mapsto [a]_R"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "function_compose" {
        description "函数复合：g ∘ f，(g ∘ f)(x) = g(f(x))"
        category "SET_THEORY"
        inputs 2 "FUNCTION" "FUNCTION"
        output "FUNCTION"
        math_def "(g \\circ f)(x) = g(f(x)), \\quad \\text{要求 } \\text{cod}(f) = \\text{dom}(g)"
        complexity "O(n)，n 为定义域大小"
        constructive true
        reversible false
    }

    preset "function_inverse_check" {
        description "逆函数判定：f 存在逆函数当且仅当 f 是双射"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "BOOLEAN"
        math_def "f^{-1} \\text{ 存在} \\Leftrightarrow f \\text{ 是双射}, \\quad f \\circ f^{-1} = \\text{id}_B"
        complexity "O(|A| + |B|)"
        constructive true
        reversible false
    }

    preset "function_injective_check" {
        description "单射判定：f 是单射当且仅当 f(a1) = f(a2) ⇒ a1 = a2"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "BOOLEAN"
        math_def "f \\text{ 单射} \\Leftrightarrow \\forall a_1, a_2 \\in A, f(a_1) = f(a_2) \\Rightarrow a_1 = a_2"
        complexity "O(|A| \\log |A|)"
        constructive true
        reversible false
    }

    preset "function_surjective_check" {
        description "满射判定：f 是满射当且仅当 ∀b ∈ B, ∃a ∈ A, f(a) = b"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "BOOLEAN"
        math_def "f \\text{ 满射} \\Leftrightarrow \\forall b \\in B, \\exists a \\in A, f(a) = b \\Leftrightarrow f(A) = B"
        complexity "O(|A| + |B|)"
        constructive true
        reversible false
    }

    preset "function_bijective_check" {
        description "双射判定：f 是双射当且仅当 f 既是单射又是满射"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "BOOLEAN"
        math_def "f \\text{ 双射} \\Leftrightarrow f \\text{ 单射} \\land f \\text{ 满射}"
        complexity "O(|A| \\log |A| + |B|)"
        constructive true
        reversible false
    }

    preset "function_image" {
        description "像：f(S) = {f(x) : x ∈ S}，S 为定义域的子集"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "SET"
        math_def "f(S) = \\{f(x) : x \\in S \\subseteq A\\}"
        complexity "O(|S|)"
        constructive true
        reversible false
    }

    preset "function_preimage" {
        description "原像：f^{-1}(T) = {x ∈ A : f(x) ∈ T}，T 为陪域的子集"
        category "SET_THEORY"
        inputs 3 "FUNCTION" "SET" "SET"
        output "SET"
        math_def "f^{-1}(T) = \\{x \\in A : f(x) \\in T \\subseteq B\\}"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "function_fixpoint" {
        description "不动点：计算函数 f 的不动点集合 {x ∈ A : f(x) = x}"
        category "SET_THEORY"
        inputs 2 "FUNCTION" "SET"
        output "SET"
        math_def "\\text{Fix}(f) = \\{x \\in A : f(x) = x\\}"
        complexity "O(|A|)"
        constructive true
        reversible false
    }

    preset "order_check" {
        description "偏序关系判定：≤ 是偏序当且仅当自反 ∧ 反对称 ∧ 传递"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "BOOLEAN"
        math_def "\\le \\text{ 是偏序} \\Leftrightarrow \\text{自反} \\land \\text{反对称} \\land \\text{传递}"
        complexity "O(|A|^2 \\cdot |R|)"
        constructive true
        reversible false
    }

    preset "order_min" {
        description "最小元：在偏序集子集 S 中查找最小元 m（∀x ∈ S, m ≤ x）"
        category "SET_THEORY"
        inputs 3 "SET" "SET" "SET"
        output "ANY"
        math_def "\\min S = m \\Leftrightarrow m \\in S \\land \\forall x \\in S, m \\le x"
        complexity "O(|S|^2)"
        constructive true
        reversible false
    }

    preset "order_max" {
        description "最大元：在偏序集子集 S 中查找最大元 M（∀x ∈ S, x ≤ M）"
        category "SET_THEORY"
        inputs 3 "SET" "SET" "SET"
        output "ANY"
        math_def "\\max S = M \\Leftrightarrow M \\in S \\land \\forall x \\in S, x \\le M"
        complexity "O(|S|^2)"
        constructive true
        reversible false
    }

    preset "order_supremum" {
        description "上确界（最小上界）：sup(S)，S 的最小上界"
        category "SET_THEORY"
        inputs 3 "SET" "SET" "SET"
        output "ANY"
        math_def "\\sup S = \\min\\{u \\in A : \\forall x \\in S, x \\le u\\}"
        complexity "O(|S|^2)"
        constructive true
        reversible false
    }

    preset "order_infimum" {
        description "下确界（最大下界）：inf(S)，S 的最大下界"
        category "SET_THEORY"
        inputs 3 "SET" "SET" "SET"
        output "ANY"
        math_def "\\inf S = \\max\\{l \\in A : \\forall x \\in S, l \\le x\\}"
        complexity "O(|S|^2)"
        constructive true
        reversible false
    }

    preset "zfc_pairing" {
        description "ZFC配对公理：对任意集合 a, b，存在集合 {a, b}"
        category "SET_THEORY"
        inputs 2 "SET" "SET"
        output "SET"
        math_def "\\forall a, \\forall b, \\exists c, \\forall x: x \\in c \\Leftrightarrow x = a \\lor x = b"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "zfc_union" {
        description "ZFC并集公理：对任意集合族 A，存在集合 ∪A = {x : ∃Y ∈ A, x ∈ Y}"
        category "SET_THEORY"
        inputs 1 "SET"
        output "SET"
        math_def "\\forall A, \\exists B, \\forall x: x \\in B \\Leftrightarrow \\exists Y \\in A, x \\in Y"
        complexity "O(|A| \\cdot \\max|Y|)"
        constructive true
        reversible false
    }

    preset "zfc_power_set" {
        description "ZFC幂集公理：对任意集合 A，存在集合 P(A) = {S : S ⊆ A}"
        category "SET_THEORY"
        inputs 1 "SET"
        output "SET"
        math_def "\\forall A, \\exists B, \\forall S: S \\in B \\Leftrightarrow S \\subseteq A"
        complexity "O(2^{|A|})"
        constructive true
        reversible false
    }

    preset "zfc_replacement" {
        description "ZFC替换公理模式：若 φ(x,y) 是函数性质，则 {y : ∃x ∈ A, φ(x,y)} 是集合"
        category "SET_THEORY"
        inputs 2 "SET" "EXPRESSION"
        output "SET"
        math_def "(\\forall x \\exists! y \\, \\varphi(x,y)) \\Rightarrow \\forall A \\exists B \\forall y (y \\in \"
                       \"B \\Leftrightarrow \\exists x \\in A \\, \\varphi(x,y))"
        complexity "O(|A|)"
        constructive false
        reversible false
    }

}
