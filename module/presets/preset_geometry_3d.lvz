    }

    preset "project_point_plane" {
        description "计算点在平面上的投影"
        category "GEOMETRY"
        inputs 4 "POINT" "POINT" "POINT" "POINT"
        output "POINT"
        math_def "点 P 在平面 π 上的垂足"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "project_point_line_3d" {
        description "计算点在空间直线上的投影"
        category "GEOMETRY"
        inputs 3 "POINT" "POINT" "POINT"
        output "POINT"
        math_def "点 P 在直线 L 上的垂足"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "project_line_plane" {
        description "计算直线在平面上的投影"
        category "GEOMETRY"
        inputs 4 "POINT" "POINT" "POINT" "POINT"
        output "LINE"
        math_def "直线 L 在平面 π 上的正交投影"
        complexity "O(1)"
        constructive true
        reversible false
    }

}
