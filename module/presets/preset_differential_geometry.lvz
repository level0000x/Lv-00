# =============================================================================
# Lv-00 Presets: Differential Geometry
# =============================================================================
#
# Auto-generated from C preset files.
#
# =============================================================================

lvz 1

presets {

    preset "dg_arc_length_param" {
        description "弧长参数化：将参数曲线 gamma(t) 转化为弧长参数化 gamma(s)，满足 |gamma'(s)| = 1"
        category "ANALYSIS"
        inputs 1 "PATH"
        output "PATH"
        math_def "s = \\int_{t_0}^t |\\gamma'(\\tau)|\\,d\\tau, \\quad |\\gamma'(s)| = 1"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "dg_frenet_frame" {
        description "Frenet标架：计算空间曲线在给定参数处的Frenet标架(T, N, B)，构成右手正交标架"
        category "ANALYSIS"
        inputs 2 "PATH" "SCALAR"
        output "TUPLE"
        math_def "T = \\frac{\\gamma'}{|\\gamma'|}, \\quad \"
                \"N = \\frac{T'}{|T'|}, \\quad \"
                \"B = T \\times N"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_curvature" {
        description "曲率计算：计算空间曲线在给定参数处的曲率 kappa = |gamma' × gamma''| / |gamma'|^3"
        category "ANALYSIS"
        inputs 2 "PATH" "SCALAR"
        output "SCALAR"
        math_def "\\kappa(t) = \\frac{|\\gamma'(t) \\times \\gamma''(t)|}{|\\gamma'(t)|^3}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_torsion" {
        description "挠率计算：计算空间曲线在给定参数处的挠率 tau = (gamma' × gamma'') · gamma''' / |gamma' × gamma''|^2"
        category "ANALYSIS"
        inputs 2 "PATH" "SCALAR"
        output "SCALAR"
        math_def "\\tau(t) = \\frac{(\\gamma' \\times \\gamma'') \\cdot \\gamma'''}{|\\gamma' \\times \\gamma''|^2}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_bertrand_curve" {
        description "Bertrand曲线：判定两条空间曲线是否构成Bertrand曲线对（具有共同主法线）"
        category "ANALYSIS"
        inputs 2 "PATH" "PATH"
        output "BOOLEAN"
        math_def "\\exists \\lambda, \\mu \\in \\mathbb{R}: \\lambda\\kappa(t) + \\mu\\tau(t) = 1"
        complexity "O(n)"
        constructive false
        reversible false
    }

    preset "dg_first_fundamental_form" {
        description "第一基本形式：计算曲面的第一基本形式系数(E, F, G)，刻画内蕴度量"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "TUPLE"
        math_def "I = E\\,du^2 + 2F\\,du\\,dv + G\\,dv^2, \\quad \"
                \"E = \\mathbf{r}_u\\cdot\\mathbf{r}_u, \\quad \"
                \"F = \\mathbf{r}_u\\cdot\\mathbf{r}_v, \\quad \"
                \"G = \\mathbf{r}_v\\cdot\\mathbf{r}_v"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "dg_second_fundamental_form" {
        description "第二基本形式：计算曲面的第二基本形式系数(L, M, N)，刻画外蕴弯曲"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "TUPLE"
        math_def "II = L\\,du^2 + 2M\\,du\\,dv + N\\,dv^2, \\quad \"
                \"L = \\mathbf{r}_{uu}\\cdot\\mathbf{n}, \\quad \"
                \"M = \\mathbf{r}_{uv}\\cdot\\mathbf{n}, \\quad \"
                \"N = \\mathbf{r}_{vv}\\cdot\\mathbf{n}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "dg_gauss_curvature" {
        description "Gauss曲率：计算曲面在给定点处的Gauss曲率 K = (LN - M^2)/(EG - F^2)"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "SCALAR"
        math_def "K = \\frac{LN - M^2}{EG - F^2} = \\kappa_1 \\kappa_2"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_mean_curvature" {
        description "平均曲率：计算曲面在给定点处的平均曲率 H = (kappa1 + kappa2)/2"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "SCALAR"
        math_def "H = \\frac{EN - 2FM + GL}{2(EG - F^2)} = \\frac{\\kappa_1 + \\kappa_2}{2}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_principal_curvatures" {
        description "主曲率：计算曲面在给定点处的主曲率对 (k1, k2)，即法曲率的极值"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "TUPLE"
        math_def "\\kappa_{1,2} = H \\pm \\sqrt{H^2 - K}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_weingarten_map" {
        description "Weingarten映射：计算曲面的形状算子 S = I^{-1}·II，特征值为主曲率"
        category "ANALYSIS"
        inputs 1 "SURFACE"
        output "MATRIX"
        math_def "S = \\begin{pmatrix} E & F \\\\ F & G \\end{pmatrix}^{-1}\"
                \"\\begin{pmatrix} L & M \\\\ M & N \\end{pmatrix}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "dg_levi_civita_connection" {
        description "Levi-Civita联络：从度量张量构造无挠且与度量相容的唯一联络"
        category "ANALYSIS"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "\\Gamma_{ij}^k = \\frac{1}{2}g^{kl}\"
                \"(\\partial_i g_{lj} + \\partial_j g_{li} - \\partial_l g_{ij})"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "dg_riemann_curvature" {
        description "Riemann曲率张量：从Christoffel符号计算Riemann曲率张量 R^{i}_{jkl}"
        category "ANALYSIS"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "R^{i}_{jkl} = \\partial_k \\Gamma^{i}_{jl} - \"
                \"\\partial_l \\Gamma^{i}_{jk} + \"
                \"\\Gamma^{i}_{mk}\\Gamma^{m}_{jl} - \"
                \"\\Gamma^{i}_{ml}\\Gamma^{m}_{jk}"
        complexity "O(n^4)"
        constructive true
        reversible false
    }

    preset "dg_ricci_curvature" {
        description "Ricci曲率：由Riemann曲率张量缩并得到Ricci曲率张量 R_{ij} = R^{k}_{ikj}"
        category "ANALYSIS"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "R_{ij} = R^{k}_{ikj}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "dg_sectional_curvature" {
        description "截面曲率：计算流形在给定二维截面方向(X, Y)的截面曲率 K(X,Y)"
        category "ANALYSIS"
        inputs 3 "MATRIX" "VECTOR" "VECTOR"
        output "SCALAR"
        math_def "K(X, Y) = \\frac{R(X,Y,Y,X)}{|X|^2|Y|^2 - \\langle X,Y \\rangle^2}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "dg_scalar_curvature" {
        description "标量曲率：计算标量曲率 R = g^{ij} R_{ij}（Ricci曲率的迹）"
        category "ANALYSIS"
        inputs 2 "MATRIX" "MATRIX"
        output "SCALAR"
        math_def "R = g^{ij} R_{ij}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_geodesic_equation" {
        description "测地线方程：建立并求解曲面上给定初值条件的测地线微分方程"
        category "ANALYSIS"
        inputs 3 "SURFACE" "POINT" "VECTOR"
        output "PATH"
        math_def "\\frac{d^2 u^k}{dt^2} + \"
                \"\\Gamma_{ij}^k \\frac{du^i}{dt}\\frac{du^j}{dt} = 0"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_exponential_map" {
        description "指数映射：计算切向量 v 在指数映射 exp_p(v) 下的像点"
        category "ANALYSIS"
        inputs 2 "POINT" "VECTOR"
        output "POINT"
        math_def "\\exp_p(v) = \\gamma_v(1), \\quad \"
                \"\\gamma_v(0) = p, \\quad \\gamma_v'(0) = v"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_jacobi_field" {
        description "Jacobi场：计算沿测地线的Jacobi向量场，满足 Jacobi 方程 D^2J/dt^2 + R(J,dot(gamma))dot(gamma) = 0"
        category "ANALYSIS"
        inputs 2 "PATH" "VECTOR"
        output "VECTOR"
        math_def "\\frac{D^2 J}{dt^2} + R(J, \\dot{\\gamma})\\dot{\\gamma} = 0"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_conjugate_points" {
        description "共轭点：计算沿测地线的共轭点位置（使Jacobi场首次消失的参数值）"
        category "ANALYSIS"
        inputs 1 "PATH"
        output "SCALAR"
        math_def "\\exists J \\neq 0: J(0) = 0, \\; J(t_0) = 0"
        complexity "O(n^2)"
        constructive false
        reversible false
    }

    preset "dg_tensor_product" {
        description "张量积：计算两个张量的张量积 T ⊗ S，构造高阶张量"
        category "ANALYSIS"
        inputs 2 "MATRIX" "MATRIX"
        output "MATRIX"
        math_def "(T \\otimes S)^{i_1\\ldots i_p j_1\\ldots j_q}_{k_1\\ldots k_r l_1\\ldots l_s} = \"
                \"T^{i_1\\ldots i_p}_{k_1\\ldots k_r} S^{j_1\\ldots j_q}_{l_1\\ldots l_s}"
        complexity "O(n^4)"
        constructive true
        reversible false
    }

    preset "dg_covariant_derivative" {
        description "协变导数：计算张量场的协变导数 ∇_k T，联络修正偏导数"
        category "ANALYSIS"
        inputs 2 "MATRIX" "MATRIX"
        output "MATRIX"
        math_def "\\nabla_k T^{i}_{j} = \\partial_k T^{i}_{j} + \\Gamma^{i}_{kl}T^{l}_{j} - \\Gamma^{l}_{kj}T^{i}_{l}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "dg_lie_derivative" {
        description "Lie导数：计算张量场沿向量场X的Lie导数 L_X T，度量无穷小变化率"
        category "ANALYSIS"
        inputs 2 "MATRIX" "VECTOR"
        output "MATRIX"
        math_def "\\mathcal{L}_X T = \\lim_{t\\to 0}\\frac{\\phi_t^* T - T}{t}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_exterior_derivative" {
        description "外微分：计算微分形式的外微分 dω，满足 d² = 0"
        category "ANALYSIS"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "d\\omega = \\sum \\frac{\\partial \\omega_{i_1\\ldots i_k}}{\\partial x^j} \"
                \"dx^j \\wedge dx^{i_1} \\wedge \\cdots \\wedge dx^{i_k}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "dg_hodge_star" {
        description "Hodge星算子：计算微分形式的Hodge对偶 *ω，将k-形式映射为(n-k)-形式"
        category "ANALYSIS"
        inputs 1 "MATRIX"
        output "MATRIX"
        math_def "*\\omega = \\frac{\\sqrt{|\\det g|}}{k!(n-k)!} \"
                \"\\varepsilon_{i_1\\ldots i_n} \"
                \"\\omega^{i_1\\ldots i_k} dx^{i_{k+1}} \\wedge \\cdots \\wedge dx^{i_n}"
        complexity "O(n!)"
        constructive true
        reversible true
    }

}
