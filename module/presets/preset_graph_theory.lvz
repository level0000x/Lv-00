# =============================================================================
# Lv-00 Presets: Graph Theory
# =============================================================================
#
# Auto-generated from C preset files.
#
# =============================================================================

lvz 1

presets {

    preset "graph_construct" {
        description "由顶点集 V 和边集 E 构造图 G = (V, E)"
        category "GRAPH_THEORY"
        inputs 2 "SET" "SET"
        output "GRAPH"
        math_def "G = (V, E), V = \\{v_1, v_2, \\ldots, v_n\\}, E \\subseteq V \\times V"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_adjacency_matrix" {
        description "计算图的邻接矩阵 A(G)，其中 A_{ij} 表示顶点 i 与 j 之间的边数"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "MATRIX"
        math_def "A(G)_{ij} = \\begin{cases} 1 & \\text{若 } (v_i, v_j) \\in E \\\\ 0 & \\text{否则} \\end{cases}"
        complexity "O(|V|^2)"
        constructive true
        reversible false
    }

    preset "graph_degree_sequence" {
        description "计算图的度序列，按非递增顺序排列"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SEQUENCE"
        math_def "d(G) = (d_1, d_2, \\ldots, d_n), d_1 \\ge d_2 \\ge \\cdots \\ge d_n"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_subgraph_test" {
        description "判定图 H 是否是图 G 的子图（V(H) ⊆ V(G), E(H) ⊆ E(G)）"
        category "GRAPH_THEORY"
        inputs 2 "GRAPH" "GRAPH"
        output "BOOLEAN"
        math_def "H \\le G \\Leftrightarrow V(H) \\subseteq V(G) \\wedge E(H) \\subseteq E(G)"
        complexity "O(|V_H| + |E_H|)"
        constructive true
        reversible false
    }

    preset "graph_complement" {
        description "计算图的补图 \\bar{G}，其中 \bar{G} 包含 G 中不存在的所有边"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "GRAPH"
        math_def "\\bar{G} = (V, \\bar{E}), \\bar{E} = \\{uv : u,v \\in V, uv \\notin E, u \\ne v\\}"
        complexity "O(|V|^2)"
        constructive true
        reversible false
    }

    preset "graph_connected_components" {
        description "计算图的所有连通分量（基于BFS/DFS遍历）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "LIST"
        math_def "G = C_1 \\cup C_2 \\cup \\cdots \\cup C_k, C_i \\text{ 连通}"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_connectivity_test" {
        description "判定无向图是否连通（任意两顶点间存在路径）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 连通} \\Leftrightarrow \\forall u,v \\in V, \\exists \\text{ 路径 } u \\to v"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_scc" {
        description "计算有向图的所有强连通分量（Kosaraju算法）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "LIST"
        math_def "\\text{SCC}(G) = \\{C_1, C_2, \\ldots, C_k\\}, C_i \\text{ 强连通}"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_articulation_points" {
        description "检测图中的所有割点（关节点），删除后增加连通分量数"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "v \\text{ 是割点} \\Leftrightarrow c(G - v) > c(G)"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_bridges" {
        description "检测图中的所有桥（割边），删除后增加连通分量数"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "e \\text{ 是桥} \\Leftrightarrow c(G - e) > c(G)"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_shortest_path" {
        description "Dijkstra单源最短路径算法，计算从源点到目标点的最短路径"
        category "GRAPH_THEORY"
        inputs 3 "GRAPH" "INTEGER" "INTEGER"
        output "SEQUENCE"
        math_def "d(s, t) = \\min\\{\\sum_{e \\in P} w(e) : P \\text{ 是 } s \\to t \\text{ 的路径}\\}"
        complexity "O((|V| + |E|) \\log |V|)"
        constructive true
        reversible false
    }

    preset "graph_mst" {
        description "Kruskal最小生成树算法，计算连通加权图的最小生成树"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "GRAPH"
        math_def "T = \\arg\\min_{T'' \\subseteq E} \\sum_{e \\in T''} w(e), |T''| = |V| - 1"
        complexity "O(|E| \\log |E|)"
        constructive true
        reversible false
    }

    preset "graph_euler_path_test" {
        description "判定图是否存在欧拉路径或欧拉回路（经过每条边恰好一次）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 有欧拉回路} \\Leftrightarrow G \\text{ 连通且所有顶点度为偶数}"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_hamiltonian_test" {
        description "判定图是否存在哈密顿路径（经过每个顶点恰好一次）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 有哈密顿路径} \\Leftrightarrow \\exists P = v_1 v_2 \\cdots v_n, V(P) = V(G)"
        complexity "O(n! \\cdot n)"
        constructive true
        reversible false
    }

    preset "graph_cycle_detect" {
        description "检测图中是否存在环（基于DFS回溯边检测）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 有环} \\Leftrightarrow \\exists v_1, v_2, \\ldots, v_k: v_1 = v_k, |E(P)| = k"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_chromatic_number" {
        description "计算图的色数 chi(G)，即顶点着色所需的最少颜色数"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "INTEGER"
        math_def "\\chi(G) = \\min\\{k : \\exists \\text{ 合法的 } k \\text{-着色}\\}"
        complexity "O(2.44^{\\chi(G)} \\cdot |V|)"
        constructive true
        reversible false
    }

    preset "graph_vertex_coloring" {
        description "贪心顶点着色算法，用 k 种颜色对图的顶点着色"
        category "GRAPH_THEORY"
        inputs 2 "GRAPH" "INTEGER"
        output "FUNCTION"
        math_def "f: V \\to \\{1, 2, \\ldots, k\\}, f(u) \\ne f(v) \\text{ 若 } uv \\in E"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_edge_coloring" {
        description "贪心边着色算法，用 k 种颜色对图的边着色"
        category "GRAPH_THEORY"
        inputs 2 "GRAPH" "INTEGER"
        output "FUNCTION"
        math_def "f: E \\to \\{1, 2, \\ldots, k\\}, f(e_1) \\ne f(e_2) \\text{ 若 } e_1, e_2 \\text{ 相邻}"
        complexity "O(|V| \\cdot |E|)"
        constructive true
        reversible false
    }

    preset "graph_planarity_test" {
        description "判定图是否是平面图（可在平面上绘制且边不相交）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 平面} \\Leftrightarrow |E| \\le 3|V| - 6 \\text{（|V| \\ge 3 时必要条件）}"
        complexity "O(|V|)"
        constructive true
        reversible false
    }

    preset "graph_four_color_verify" {
        description "验证四色定理对给定平面图成立（构造4-着色方案）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "\\chi(G) \\le 4, \\forall \\text{ 平面图 } G"
        complexity "O(|V|^2)"
        constructive true
        reversible false
    }

    preset "graph_maximum_matching" {
        description "计算图的最大匹配（基于增广路算法）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "M^* = \\arg\\max_{M \\subseteq E} |M|, M \\text{ 中边两两不邻}"
        complexity "O(|V| \\cdot |E|)"
        constructive true
        reversible false
    }

    preset "graph_perfect_matching_test" {
        description "判定图是否存在完美匹配（每个顶点恰好被一条匹配边覆盖）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 有完美匹配} \\Leftrightarrow |M^*| = |V|/2"
        complexity "O(|V| \\cdot |E|)"
        constructive true
        reversible false
    }

    preset "graph_independent_set" {
        description "计算图的最大独立集（集合中任意两顶点不相邻）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "\\alpha(G) = \\max\\{|S| : S \\subseteq V, \\forall u,v \\in S, uv \\notin E\\}"
        complexity "O(1.1996^{|V|})"
        constructive true
        reversible false
    }

    preset "graph_vertex_cover" {
        description "计算图的最小顶点覆盖（每条边至少有一个端点在覆盖中）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "\\tau(G) = \\min\\{|C| : C \\subseteq V, \\forall uv \\in E, u \\in C \\lor v \\in C\\}"
        complexity "O(1.2738^{\\tau(G)} \\cdot |V|)"
        constructive true
        reversible false
    }

    preset "graph_dominating_set" {
        description "计算图的最小支配集（每个顶点要么在集合中，要么与集合中顶点相邻）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "SET"
        math_def "\\gamma(G) = \\min\\{|D| : \\forall v \\in V, v \\in D \\lor \\exists u \\in D, uv \\in E\\}"
        complexity "O(1.4969^{|V|})"
        constructive true
        reversible false
    }

    preset "graph_complete" {
        description "构造 n 阶完全图 K_n（每对顶点之间都有边相连）"
        category "GRAPH_THEORY"
        inputs 1 "INTEGER"
        output "GRAPH"
        math_def "K_n = (V, E), |V| = n, |E| = \\binom{n}{2}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "graph_bipartite_test" {
        description "判定图是否是二部图（顶点集可划分为两个独立集）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 二部} \\Leftrightarrow \\chi(G) \\le 2 \\Leftrightarrow G \\text{ 无奇数环}"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_tree_test" {
        description "判定图是否是树（连通且无环的无向图）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "BOOLEAN"
        math_def "G \\text{ 是树} \\Leftrightarrow G \\text{ 连通且 } |E| = |V| - 1"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_dual" {
        description "计算平面图的对偶图 G*（面与顶点互换）"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "GRAPH"
        math_def "G^* = (F, E^*), F \\text{ 是 } G \\text{ 的面集}"
        complexity "O(|V| + |E|)"
        constructive true
        reversible false
    }

    preset "graph_isomorphism_test" {
        description "判定两个图是否同构（存在保持邻接关系的双射）"
        category "GRAPH_THEORY"
        inputs 2 "GRAPH" "GRAPH"
        output "BOOLEAN"
        math_def "G \\cong H \\Leftrightarrow \\exists \\varphi: V(G) \\to V(H) \\text{ 双射}, \"
                       \"uv \\in E(G) \\Leftrightarrow \\varphi(u)\\varphi(v) \\in E(H)"
        complexity "O(|V|! \\cdot |V|^2)"
        constructive true
        reversible false
    }

    preset "graph_automorphism_group" {
        description "计算图的自同构群 Aut(G)，即保持图结构的所有顶点置换"
        category "GRAPH_THEORY"
        inputs 1 "GRAPH"
        output "GROUP"
        math_def "\\text{Aut}(G) = \\{\\sigma \\in S_{|V|} : uv \\in E \\Leftrightarrow \\sigma(u)\\sigma(v) \\in E\\}"
        complexity "O(|V|! \\cdot |V|^2)"
        constructive true
        reversible false
    }

}
