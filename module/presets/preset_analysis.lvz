    }

    preset "completion" {
        description "构造度量空间的完备化"
        category "ANALYSIS"
        inputs 1 "SPACE"
        output "SPACE"
        math_def "\\hat{X} = \\{\\text{柯西序列等价类}\\}"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "compactness_test" {
        description "判定函数空间是否紧致（Arzelà-Ascoli 定理）"
        category "ANALYSIS"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "\\mathcal{F} \\text{ 紧致} \\Leftrightarrow \\text{一致有界且等度连续}"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "metric_space_test" {
        description "判定二元函数是否构成度量"
        category "ANALYSIS"
        inputs 2 "SET" "FUNCTION"
        output "BOOLEAN"
        math_def "d \\text{ 是度量} \\Leftrightarrow d(x,y) \\ge 0, d(x,y)=0 \\Leftrightarrow x=y, \"
                       \"d(x,y)=d(y,x), d(x,z) \\le d(x,y)+d(y,z)"
        complexity "O(|X|³)"
        constructive true
        reversible false
    }

    preset "cauchy_sequence_test" {
        description "判定序列是否是柯西序列"
        category "ANALYSIS"
        inputs 2 "SEQUENCE" "FUNCTION"
        output "BOOLEAN"
        math_def "\\{x_n\\} \\text{ 柯西} \\Leftrightarrow \\forall \\epsilon, \\exists N: \"
                       \"m,n > N \\Rightarrow d(x_m, x_n) < \\epsilon"
        complexity "O(n²)"
        constructive true
        reversible false
    }

    preset "complete_space_test" {
        description "判定度量空间是否完备"
        category "ANALYSIS"
        inputs 1 "SPACE"
        output "BOOLEAN"
        math_def "X \\text{ 完备} \\Leftrightarrow \\text{每个柯西序列收敛}"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "contraction_mapping" {
        description "判定映射是否是压缩映射"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "T \\text{ 是压缩映射} \\Leftrightarrow d(Tx, Ty) \\le k \\cdot d(x,y), k < 1"
        complexity "O(|X|²)"
        constructive true
        reversible false
    }

    preset "fixed_point_theorem" {
        description "应用 Banach 不动点定理求不动点"
        category "ANALYSIS"
        inputs 1 "FUNCTION"
        output "SET"
        math_def "T \\text{ 压缩} \\Rightarrow \\exists! x^*: Tx^* = x^*"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "gamma_function" {
        description "计算 Γ 函数值"
        category "ANALYSIS"
        inputs 1 "SCALAR"
        output "SCALAR"
        math_def "\\Gamma(z) = \\int_0^{\\infty} t^{z-1} e^{-t} \\, dt"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "beta_function" {
        description "计算 B 函数值"
        category "ANALYSIS"
        inputs 2 "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "B(a, b) = \\int_0^1 t^{a-1} (1-t)^{b-1} \\, dt = \\frac{\\Gamma(a)\\Gamma(b)}{\\Gamma(a+b)}"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "zeta_function" {
        description "计算黎曼 ζ 函数值"
        category "ANALYSIS"
        inputs 1 "SCALAR"
        output "SCALAR"
        math_def "\\zeta(s) = \\sum_{n=1}^{\\infty} \\frac{1}{n^s}, \\quad \\text{Re}(s) > 1"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "error_function" {
        description "计算误差函数 erf(x)"
        category "ANALYSIS"
        inputs 1 "SCALAR"
        output "SCALAR"
        math_def "\\text{erf}(x) = \\frac{2}{\\sqrt{\\pi}} \\int_0^x e^{-t^2} \\, dt"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "directional_derivative" {
        description "计算函数在某点沿某方向的方向导数"
        category "ANALYSIS"
        inputs 3 "FUNCTION" "VECTOR" "SCALAR"
        output "DERIVATIVE"
        math_def "D_{\\mathbf{v}} f(a) = \\lim_{h \\to 0} \\frac{f(a + h\\mathbf{v}) - f(a)}{h} = \"
                       \"\\nabla f(a) \\cdot \\mathbf{v}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "mean_value_theorem" {
        description "应用积分中值定理求中值点"
        category "ANALYSIS"
        inputs 3 "FUNCTION" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "\\exists c \\in [a,b]: \\int_a^b f(x) \\, dx = f(c)(b-a)"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "infinite_limit" {
        description "计算函数在无穷远处的极限"
        category "ANALYSIS"
        inputs 1 "FUNCTION"
        output "LIMIT"
        math_def "\\lim_{x \\to \\infty} f(x) = L"
