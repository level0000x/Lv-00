        complexity "O(2^{|\\Gamma|})"
        constructive true
        reversible false
    }

    preset "logic_resolution" {
        description "归结原理：将公式集转化为子句集，通过归结消解推导空子句以证明不可满足性"
        category "MATH_LOGIC"
        inputs 1 "SEQUENCE"
        output "BOOLEAN"
        math_def "S \\vdash_{\\text{Res}} \\Box \\Leftrightarrow S \\text{ 不可满足}"
        complexity "O(n^k)，n 为子句数"
        constructive true
        reversible false
    }

    preset "logic_tableau_method" {
        description "语义表方法：通过系统性地分解公式构建反证树，判定公式的可满足性"
        category "MATH_LOGIC"
        inputs 1 "FORMULA"
        output "BOOLEAN"
        math_def "\\lnot \\varphi \\text{ 的表封闭} \\Leftrightarrow \\varphi \\text{ 有效}"
        complexity "O(2^n)，n 为子公式数"
        constructive true
