    }

    preset "logic_model_check" {
        description "模型判定：判定结构 M 是否为公式集 Γ 的模型（M ⊨ Γ）"
        category "MATH_LOGIC"
        inputs 2 "STRUCTURE" "SEQUENCE"
        output "BOOLEAN"
        math_def "M \\models \\Gamma \\Leftrightarrow \\forall \\varphi \\in \\Gamma, M \\models \\varphi"
        complexity "O(|\\Gamma| \\cdot |M|)"
        constructive true
