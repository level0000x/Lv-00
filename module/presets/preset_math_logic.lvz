lvz 1

presets {

    preset "logic_conjunction" {
        description "命题合取：P ∧ Q，当且仅当 P 和 Q 均为真时结果为真"
        category "MATH_LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\land Q"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_disjunction" {
        description "命题析取：P ∨ Q，当且仅当 P 或 Q 至少一个为真时结果为真"
        category "MATH_LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\lor Q"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_negation" {
        description "命题否定：¬P，当 P 为真时结果为假，反之亦然"
        category "MATH_LOGIC"
        inputs 1 "BOOLEAN"
        output "BOOLEAN"
        math_def "\\lnot P"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "logic_implication" {
        description "命题蕴含：P → Q，等价于 ¬P ∨ Q"
        category "MATH_LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\to Q \\equiv \\lnot P \\lor Q"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_biconditional" {
        description "命题等价：P ↔ Q，当 P 和 Q 真值相同时结果为真"
        category "MATH_LOGIC"
        inputs 2 "BOOLEAN" "BOOLEAN"
        output "BOOLEAN"
        math_def "P \\leftrightarrow Q \\equiv (P \\to Q) \\land (Q \\to P)"
        complexity "O(1)"
        constructive true
        reversible true
    }

    preset "logic_tautology_test" {
        description "判定命题公式是否为永真式（对所有真值指派均为真）"
        category "MATH_LOGIC"
        inputs 1 "FORMULA"
        output "BOOLEAN"
        math_def "\\varphi \\text{ 是永真式} \\Leftrightarrow \\forall v: v(\\varphi) = \\text{T}"
        complexity "O(2^n)，n 为命题变元数"
        constructive true
        reversible false
    }

    preset "logic_satisfiability_test" {
        description "判定命题公式是否可满足（存在使其为真的真值指派）"
        category "MATH_LOGIC"
        inputs 1 "FORMULA"
        output "BOOLEAN"
        math_def "\\varphi \\text{ 可满足} \\Leftrightarrow \\exists v: v(\\varphi) = \\text{T}"
        complexity "O(2^n)，n 为命题变元数"
        constructive true
        reversible false
    }

    preset "logic_universal_instantiation" {
        description "全称实例化：从 ∀x P(x) 推出 P(c)，c 为论域中任意元素"
        category "MATH_LOGIC"
        inputs 2 "FORMULA" "ANY"
        output "FORMULA"
        math_def "\\forall x \\, P(x) \\vdash P(c)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_existential_generalization" {
        description "存在泛化：从 P(c) 推出 ∃x P(x)，c 为论域中某个元素"
        category "MATH_LOGIC"
        inputs 2 "FORMULA" "ANY"
        output "FORMULA"
        math_def "P(c) \\vdash \\exists x \\, P(x)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_universal_generalization" {
        description "全称泛化：从 P(c) 推出 ∀x P(x)，要求 c 为任意常量且未被特殊假定"
        category "MATH_LOGIC"
        inputs 2 "FORMULA" "ANY"
        output "FORMULA"
        math_def "P(c) \\vdash \\forall x \\, P(x), \\quad c \\text{ 为任意常量}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_existential_instantiation" {
        description "存在实例化：从 ∃x P(x) 引入 P(c)，c 为此前未出现的新常量"
        category "MATH_LOGIC"
        inputs 2 "FORMULA" "ANY"
        output "FORMULA"
        math_def "\\exists x \\, P(x) \\vdash P(c), \\quad c \\text{ 为新常量}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "logic_natural_deduction" {
        description "自然演绎系统：基于引入规则（∧I, ∨I, →I, ∀I, ∃I）和消去规则（∧E, ∨E, →E, ∀E, ∃E）的证明"
        category "MATH_LOGIC"
        inputs 2 "FORMULA" "SEQUENCE"
