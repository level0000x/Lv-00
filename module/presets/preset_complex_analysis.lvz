        category "ANALYSIS"
        inputs 2 "TUPLE" "TUPLE"
        output "TUPLE"
        math_def "T_1 \\circ T_2(z) = T_1(T_2(z))"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "mobius_inverse" {
        description "Mobius变换逆：T^{-1}(w) = (dw - b) / (-cw + a)"
        category "ANALYSIS"
        inputs 1 "TUPLE"
        output "TUPLE"
        math_def "T^{-1}(w) = \\frac{dw - b}{-cw + a}"
