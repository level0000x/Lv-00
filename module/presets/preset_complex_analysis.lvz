lvz 1

presets {

    preset "complex_function_eval" {
        description "复变函数求值：给定复变函数 f 和复数 z，计算 f(z)"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "w = f(z), \\quad z \\in \\mathbb{C}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "complex_limit" {
        description "复极限：计算 lim(z->z0) f(z)，z 沿任意路径趋近 z0"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "L = \\lim_{z \\to z_0} f(z), \\quad z \\in \\mathbb{C}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "complex_continuity_check" {
        description "复连续性判定：f 在 z0 处连续当且仅当 lim(z->z0) f(z) = f(z0)"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "f \\text{ 在 } z_0 \\text{ 连续} \\Leftrightarrow \"
                \"\\lim_{z \\to z_0} f(z) = f(z_0)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "complex_differentiable_check" {
        description "复可微性判定：验证 Cauchy-Riemann 条件及偏导数连续性"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "f'(z_0) = \\lim_{\\Delta z \\to 0} \"
                \"\\frac{f(z_0 + \\Delta z) - f(z_0)}{\\Delta z} \\text{ 存在}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "complex_derivative" {
        description "复导数：f'(z0) = lim(Dz->0) [f(z0+Dz) - f(z0)] / Dz"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "f'(z_0) = \\lim_{\\Delta z \\to 0} \"
                \"\\frac{f(z_0 + \\Delta z) - f(z_0)}{\\Delta z}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "cauchy_riemann_check" {
        description "Cauchy-Riemann方程验证：ux=vy, uy=-vx"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "\\frac{\\partial u}{\\partial x} = \\frac{\\partial v}{\\partial y}, \"
                \"\\quad \\frac{\\partial u}{\\partial y} = -\\frac{\\partial v}{\\partial x}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "harmonic_function_check" {
        description "调和函数判定：Delta(u) = u_xx + u_yy = 0"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "\\Delta u = \\frac{\\partial^2 u}{\\partial x^2} + \"
                \"\\frac{\\partial^2 u}{\\partial y^2} = 0"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "harmonic_conjugate" {
        description "调和共轭：给定调和函数 u，求 v 使得 f = u + iv 解析"
        category "ANALYSIS"
        inputs 1 "FUNCTION"
        output "FUNCTION"
        math_def "f(z) = u(x,y) + iv(x,y) \\text{ 解析}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "analytic_function_check" {
        description "解析函数判定：f 在 z0 的某邻域内处处复可微"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "BOOLEAN"
        math_def "f \\text{ 在 } z_0 \\text{ 解析} \\Leftrightarrow \"
                \"f \\text{ 在 } z_0 \\text{ 的某邻域内复可微}"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "entire_function_check" {
        description "整函数判定：f(z) 在复平面 C 上处处解析"
        category "ANALYSIS"
        inputs 1 "FUNCTION"
        output "BOOLEAN"
        math_def "f \\text{ 是整函数} \\Leftrightarrow \"
                \"f \\text{ 在 } \\mathbb{C} \\text{ 上处处解析}"
        complexity "O(\\infty)"
        constructive true
        reversible false
    }

    preset "complex_line_integral" {
        description "复线积分：int_gamma f(z) dz，沿有向曲线 gamma 的复积分"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "PATH"
        output "SCALAR"
        math_def "\\int_{\\gamma} f(z) \\, dz = \\int_a^b f(\\gamma(t)) \\gamma'(t) \\, dt"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "cauchy_integral_formula" {
        description "Cauchy积分公式：f(z0) = (1/2*pi*i) oint f(z)/(z-z0) dz"
        category "ANALYSIS"
        inputs 3 "FUNCTION" "SCALAR" "PATH"
        output "SCALAR"
        math_def "f(z_0) = \\frac{1}{2\\pi i} \\oint_{\\gamma} \"
                \"\\frac{f(z)}{z - z_0} \\, dz"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "cauchy_integral_derivative" {
        description "Cauchy积分公式求导：f^(n)(z0) = n!/(2*pi*i) oint f(z)/(z-z0)^(n+1) dz"
        category "ANALYSIS"
        inputs 4 "FUNCTION" "SCALAR" "PATH" "INTEGER"
        output "SCALAR"
        math_def "f^{(n)}(z_0) = \\frac{n!}{2\\pi i} \\oint_{\\gamma} \"
                \"\\frac{f(z)}{(z - z_0)^{n+1}} \\, dz"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "cauchy_theorem" {
        description "Cauchy定理验证：f 在 gamma 及其内部解析 => oint_gamma f(z) dz = 0"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "PATH"
        output "BOOLEAN"
        math_def "\\oint_{\\gamma} f(z) \\, dz = 0"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "morera_theorem" {
        description "Morera定理验证：f 连续且沿任意三角形积分为零 => f 解析"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "REGION"
        output "BOOLEAN"
        math_def "\\oint_{\\Delta} f(z) \\, dz = 0, \\forall \\Delta \\subset \\Omega \"
                \"\\Rightarrow f \\text{ 在 } \\Omega \\text{ 内解析}"
        complexity "O(\\infty)"
        constructive true
        reversible false
    }

    preset "winding_number" {
        description "绕数：n(gamma, z0) = (1/2*pi*i) oint_gamma dz/(z-z0)"
        category "ANALYSIS"
        inputs 2 "PATH" "SCALAR"
        output "INTEGER"
        math_def "n(\\gamma, z_0) = \\frac{1}{2\\pi i} \"
                \"\\oint_{\\gamma} \\frac{dz}{z - z_0}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "residue_integral" {
        description "留数积分：oint_gamma f(z) dz = 2*pi*i * sum Res(f, zk)"
        category "ANALYSIS"
        inputs 3 "FUNCTION" "TUPLE" "PATH"
        output "SCALAR"
        math_def "\\oint_{\\gamma} f(z) \\, dz = \"
                \"2\\pi i \\sum_{k} \\text{Res}(f, z_k)"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "contour_integral_param" {
        description "围道积分参数化：int_gamma f(z) dz = int_a^b f(gamma(t)) gamma'(t) dt"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "PATH"
        output "EXPRESSION"
        math_def "\\int_{\\gamma} f(z) \\, dz = \"
                \"\\int_a^b f(\\gamma(t)) \\, \\gamma'(t) \\, dt"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "taylor_series_complex" {
        description "复Taylor级数：f(z) = sum f^(n)(z0)/n! * (z-z0)^n"
        category "ANALYSIS"
        inputs 3 "FUNCTION" "SCALAR" "INTEGER"
        output "TUPLE"
        math_def "f(z) = \\sum_{n=0}^{\\infty} \"
                \"\\frac{f^{(n)}(z_0)}{n!} (z - z_0)^n"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "laurent_series" {
        description "Laurent级数：f(z) = sum a_n (z-z0)^n，n 从 -inf 到 +inf"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "TUPLE"
        math_def "f(z) = \\sum_{n=-\\infty}^{\\infty} a_n (z - z_0)^n, \"
                \"\\quad 0 < |z - z_0| < R"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "power_series_radius" {
        description "幂级数收敛半径：1/R = limsup |a_n|^(1/n)（Hadamard公式）"
        category "ANALYSIS"
        inputs 2 "TUPLE" "SCALAR"
        output "SCALAR"
        math_def "\\frac{1}{R} = \\limsup_{n \\to \\infty} |a_n|^{1/n}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "laurent_series_principal_part" {
        description "Laurent级数主部：提取负幂次部分 sum a_{-n} (z-z0)^{-n}"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "EXPRESSION"
        math_def "\\text{PP}(f, z_0) = \\sum_{n=1}^{\\infty} \"
                \"a_{-n} (z - z_0)^{-n}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "residue_compute" {
        description "留数计算：Res(f, z0) = a_{-1}（Laurent级数 (z-z0)^{-1} 项系数）"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "\\text{Res}(f, z_0) = a_{-1} = \"
                \"\\frac{1}{2\\pi i} \\oint_{\\gamma} f(z) \\, dz"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "pole_order" {
        description "极点阶数判定：确定孤立奇点 z0 处极点的阶数 m"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
        output "INTEGER"
        math_def "\\lim_{z \\to z_0} (z - z_0)^m f(z) \\neq 0, \"
                \"\\lim_{z \\to z_0} (z - z_0)^{m+1} f(z) = 0"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "essential_singular_check" {
        description "本性奇点判定：Laurent级数主部有无穷多项（非极点、非可去）"
        category "ANALYSIS"
        inputs 2 "FUNCTION" "SCALAR"
