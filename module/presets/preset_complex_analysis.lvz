    }

    preset "mobius_transform" {
        description "Mobius变换：T(z) = (az + b) / (cz + d)，ad - bc != 0"
        category "ANALYSIS"
        inputs 5 "SCALAR" "SCALAR" "SCALAR" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "T(z) = \\frac{az + b}{cz + d}, \\quad ad - bc \\neq 0"
