# =============================================================================
# Lv-00 Presets: Algebraic Topology Adv
# =============================================================================
#
# Auto-generated from C preset files.
#
# =============================================================================

lvz 1

presets {

    preset "at_fundamental_group" {
        description "基本群 π₁(X, x₀)：计算拓扑空间X在基点x₀处的基本群，由闭路径同伦类构成，反映空间的一维洞结构"
        category "TOPOLOGY"
        inputs 2 "TOPOLOGY" "POINT"
        output "GROUP"
        math_def "\\pi_1(X, x_0) = \\{ [\\gamma] : \\gamma: [0,1] \\to X, \\gamma(0) = \\gamma(1) = x_0 \\} / \\sim"
        complexity "O(∞)"
        constructive false
        reversible false
    }

    preset "at_covering_space" {
        description "覆盖空间：验证覆盖映射 p: Ỹ → Y，局部同胚且满足离散纤维条件"
        category "TOPOLOGY"
        inputs 2 "TOPOLOGY" "TOPOLOGY"
        output "BOOLEAN"
        math_def "p: \\tilde{Y} \\to Y, \\quad \\forall y \\in Y, \\exists U \\ni y: p^{-1}(U) = \"
                        \"\\bigsqcup_{\\alpha} V_\\alpha, V_\\alpha \\cong U"
        complexity "O(∞)"
        constructive false
        reversible false
    }

    preset "at_universal_covering" {
        description "万有覆盖空间：构造拓扑空间X的万有覆盖空间，单连通且覆盖变换群同构于基本群"
        category "TOPOLOGY"
        inputs 1 "TOPOLOGY"
        output "TOPOLOGY"
        math_def "\\tilde{X} \\to X, \\quad \\pi_1(\\tilde{X}) = 0, \\quad \\text{Aut}(\\tilde{X}/X) \\cong \\pi_1(X)"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "at_homology_group" {
        description "同调群 Hₙ(X)：计算拓扑空间X的第n维奇异同调群，反映n维洞结构"
        category "TOPOLOGY"
        inputs 2 "TOPOLOGY" "INTEGER"
        output "GROUP"
        math_def "H_n(X) = \\ker(\\partial_n) / \\operatorname{im}(\\partial_{n+1})"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "at_cohomology_group" {
        description "上同调群 Hⁿ(X)：计算拓扑空间X的上同调群，对偶于同调群，具有杯积环结构"
        category "TOPOLOGY"
        inputs 2 "TOPOLOGY" "INTEGER"
        output "GROUP"
        math_def "H^n(X) = \\ker(\\delta^n) / \\operatorname{im}(\\delta^{n-1}), \\quad \\delta^n: C^n(X) \\to C^{n+1}(X)"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "at_mayer_vietoris_sequence" {
        description "Mayer-Vietoris序列：利用空间分解 X = A ∪ B 导出同调群的长正合序列"
        category "TOPOLOGY"
        inputs 3 "TOPOLOGY" "TOPOLOGY" "TOPOLOGY"
        output "SEQUENCE"
        math_def "\\cdots \\to H_n(A \\cap B) \\to H_n(A) \\oplus H_n(B) \\to H_n(X) \\to H_{n-1}(A \\cap B) \\to \\cdots"
        complexity "O(∞)"
        constructive true
        reversible false
    }

    preset "at_exact_sequence" {
        description "正合序列：验证群同态序列是否满足 im(f_i) = ker(f_{i+1}) 的正合条件"
        category "TOPOLOGY"
        inputs 1 "SEQUENCE"
        output "BOOLEAN"
        math_def "\\operatorname{im}(f_i) = \\ker(f_{i+1}), \\quad \\forall i"
        complexity "O(∞)"
        constructive false
        reversible false
    }

    preset "at_euler_characteristic" {
        description "Euler特征数 χ(X)：计算拓扑空间X的Euler特征数，各维Betti数的交错和"
        category "TOPOLOGY"
        inputs 1 "TOPOLOGY"
        output "INTEGER"
        math_def "\\chi(X) = \\sum_{n=0}^{\\infty} (-1)^n \\operatorname{rk}(H_n(X))"
        complexity "O(∞)"
        constructive true
        reversible false
    }

}
