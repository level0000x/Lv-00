# =============================================================================
# Lv-00 Presets: Numerical
# =============================================================================
#
# Auto-generated from C preset files.
#
# =============================================================================

lvz 1

presets {

    preset "numerical_bisection" {
        description "二分法求方程 f(x)=0 的根，要求 f 在区间 [a,b] 上连续且变号"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "x_{n+1} = \\frac{a_n + b_n}{2}, \\quad f(a_n) \\cdot f(b_n) < 0"
        complexity "O(n \\log \\frac{b-a}{\\varepsilon})"
        constructive true
        reversible false
    }

    preset "numerical_newton" {
        description "牛顿法（切线法）求方程 f(x)=0 的根，需要函数及其导数"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "x_{n+1} = x_n - \\frac{f(x_n)}{f'(x_n)}"
        complexity "O(n \\log \\frac{1}{\\varepsilon})"
        constructive true
        reversible false
    }

    preset "numerical_secant" {
        description "割线法求方程 f(x)=0 的根，用差商代替导数"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "x_{n+1} = x_n - f(x_n) \\cdot \\frac{x_n - x_{n-1}}{f(x_n) - f(x_{n-1})}"
        complexity "O(n \\log \\frac{1}{\\varepsilon})"
        constructive true
        reversible false
    }

    preset "numerical_fixed_point" {
        description "不动点迭代法：将 f(x)=0 转化为 x=g(x) 进行迭代求解"
        category "NUMERICAL"
        inputs 2 "FUNCTION" "SCALAR"
        output "SCALAR"
        math_def "x_{n+1} = g(x_n), \\quad x^* = g(x^*)"
        complexity "O(n \\log \\frac{1}{\\varepsilon})"
        constructive true
        reversible false
    }

    preset "numerical_trapezoid" {
        description "复化梯形公式求定积分 ∫[a,b] f(x)dx"
        category "NUMERICAL"
        inputs 4 "FUNCTION" "SCALAR" "SCALAR" "INTEGER"
        output "SCALAR"
        math_def "T_n = \\frac{h}{2}\\left[f(a) + 2\\sum_{i=1}^{n-1} f(x_i) + f(b)\\right], \\quad h = \\frac{b-a}{n}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "numerical_simpson" {
        description "复化Simpson公式求定积分 ∫[a,b] f(x)dx"
        category "NUMERICAL"
        inputs 4 "FUNCTION" "SCALAR" "SCALAR" "INTEGER"
        output "SCALAR"
        math_def "S_n = \\frac{h}{3}\\left[f(a) + 4\\sum_{\\text{odd}} f(x_i) + \"
            \"2\\sum_{\\text{even}} f(x_i) + f(b)\\right]"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "numerical_gauss_quadrature" {
        description "高斯求积公式：利用正交多项式的零点作为求积节点"
        category "NUMERICAL"
        inputs 4 "FUNCTION" "SCALAR" "SCALAR" "INTEGER"
        output "SCALAR"
        math_def "\\int_a^b f(x)\\,dx \\approx \\sum_{i=1}^{n} A_i \\, f(x_i), \\quad x_i \\text{ \"
            \"为 Legendre 多项式零点}"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "numerical_romberg" {
        description "Romberg积分：基于Richardson外推的逐次加速积分方法"
        category "NUMERICAL"
        inputs 4 "FUNCTION" "SCALAR" "SCALAR" "INTEGER"
        output "SCALAR"
        math_def "R_{k,m} = \\frac{4^m R_{k,m-1} - R_{k-1,m-1}}{4^m - 1}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "numerical_forward_diff" {
        description "前向差分公式近似计算函数在 x 处的一阶导数"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "f'(x) \\approx \\frac{f(x+h) - f(x)}{h}, \\quad \\text{误差 } O(h)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "numerical_central_diff" {
        description "中心差分公式近似计算函数在 x 处的一阶导数"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "SCALAR" "SCALAR"
        output "SCALAR"
        math_def "f'(x) \\approx \\frac{f(x+h) - f(x-h)}{2h}, \\quad \\text{误差 } O(h^2)"
        complexity "O(1)"
        constructive true
        reversible false
    }

    preset "numerical_richardson" {
        description "Richardson外推法：通过逐步减半步长并外推消除低阶误差项"
        category "NUMERICAL"
        inputs 3 "FUNCTION" "SCALAR" "INTEGER"
        output "SCALAR"
        math_def "D_{k,m} = \\frac{4^m D_{k,m-1} - D_{k-1,m-1}}{4^m - 1}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "numerical_lagrange_interp" {
        description "Lagrange插值：给定 n+1 个数据点构造 Lagrange 插值多项式并求值"
        category "NUMERICAL"
        inputs 3 "LIST" "LIST" "SCALAR"
        output "SCALAR"
        math_def "L_n(x) = \\sum_{i=0}^{n} y_i \\prod_{\\substack{j=0 \\\\ j \\neq i}}^{n} \\frac{x - x_j}{x_i - x_j}"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "numerical_newton_interp" {
        description "Newton差商插值：利用差商表构造 Newton 插值多项式并求值"
        category "NUMERICAL"
        inputs 3 "LIST" "LIST" "SCALAR"
        output "SCALAR"
        math_def "N_n(x) = f[x_0] + \\sum_{i=1}^{n} f[x_0, \\ldots, x_i] \\prod_{j=0}^{i-1} (x - x_j)"
        complexity "O(n^2)"
        constructive true
        reversible false
    }

    preset "numerical_spline_interp" {
        description "三次样条插值：构造分段三次多项式，保证节点处二阶连续"
        category "NUMERICAL"
        inputs 3 "LIST" "LIST" "SCALAR"
        output "SCALAR"
        math_def "S_i(x) = a_i + b_i(x-x_i) + c_i(x-x_i)^2 + d_i(x-x_i)^3, \\quad x \\in [x_i, x_{i+1}]"
        complexity "O(n)"
        constructive true
        reversible false
    }

    preset "numerical_least_squares" {
        description "最小二乘拟合：给定数据点和基函数族，求最小二乘逼近"
        category "NUMERICAL"
        inputs 3 "LIST" "LIST" "FUNCTION"
        output "LIST"
        math_def "\\min_{\\{c_i\\}} \\sum_{j=1}^{m} \\left| y_j - \\sum_{i=1}^{n} c_i \\, \\varphi_i(x_j) \\right|^2"
        complexity "O(mn^2)"
        constructive true
        reversible false
    }

    preset "numerical_polynomial_fit" {
        description "多项式拟合：用最小二乘法拟合 n 次多项式"
        category "NUMERICAL"
        inputs 3 "LIST" "LIST" "INTEGER"
        output "LIST"
        math_def "\\min_{\\{a_k\\}} \\sum_{j=1}^{m} \\left| y_j - \\sum_{k=0}^{n} a_k x_j^k \\right|^2"
        complexity "O(mn^2)"
        constructive true
        reversible false
    }

    preset "numerical_euler" {
        description "显式Euler方法求解初值问题 y'=f(x,y), y(x0)=y0"
        category "NUMERICAL"
        inputs 5 "FUNCTION" "SCALAR" "SCALAR" "SCALAR" "INTEGER"
        output "LIST"
        math_def "y_{n+1} = y_n + h \\, f(x_n, y_n), \\quad h = \\frac{x_{end} - x_0}{N}"
        complexity "O(N)"
        constructive true
        reversible false
    }

    preset "numerical_rk4" {
        description "经典四阶Runge-Kutta方法求解初值问题 y'=f(x,y), y(x0)=y0"
        category "NUMERICAL"
        inputs 5 "FUNCTION" "SCALAR" "SCALAR" "SCALAR" "INTEGER"
        output "LIST"
        math_def "y_{n+1} = y_n + \\frac{h}{6}(k_1 + 2k_2 + 2k_3 + k_4)"
        complexity "O(N)"
        constructive true
        reversible false
    }

    preset "numerical_adams" {
        description "Adams-Bashforth四步显式方法求解初值问题 y'=f(x,y)"
        category "NUMERICAL"
        inputs 5 "FUNCTION" "SCALAR" "SCALAR" "SCALAR" "INTEGER"
        output "LIST"
        math_def "y_{n+1} = y_n + \\frac{h}{24}(55f_n - 59f_{n-1} + 37f_{n-2} - 9f_{n-3})"
        complexity "O(N)"
        constructive true
        reversible false
    }

    preset "numerical_gauss_elimination" {
        description "高斯消元法（列主元）求解线性方程组 Ax=b"
        category "NUMERICAL"
        inputs 2 "MATRIX" "LIST"
        output "LIST"
        math_def "Ax = b \\Rightarrow Ux = c \\Rightarrow x = U^{-1}c"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "numerical_lu_decomposition" {
        description "LU分解：将矩阵 A 分解为下三角矩阵 L 和上三角矩阵 U 的乘积"
        category "NUMERICAL"
        inputs 1 "MATRIX"
        output "TUPLE"
        math_def "A = LU, \\quad L \\text{ 为单位下三角矩阵}, \\quad U \\text{ 为上三角矩阵}"
        complexity "O(n^3)"
        constructive true
        reversible false
    }

    preset "numerical_iterative_solve" {
        description "迭代法（Jacobi/Gauss-Seidel）求解线性方程组 Ax=b"
        category "NUMERICAL"
        inputs 4 "MATRIX" "LIST" "SCALAR" "INTEGER"
        output "LIST"
        math_def "x^{(k+1)} = D^{-1}(b - (L+U)x^{(k)})"
        complexity "/* Jacobi迭代 */
            "O(n^2 \\cdot k)""
        constructive true
        reversible false
    }

    preset "numerical_eigenvalues" {
        description "QR算法计算矩阵的全部特征值"
        category "NUMERICAL"
        inputs 1 "MATRIX"
        output "LIST"
        math_def "Ax = \\lambda x, \\quad A = QR \\Rightarrow A' = RQ, \\quad \\text{迭代收敛至上三角矩阵}"
        complexity "O(n^3 \\cdot k)"
        constructive true
        reversible false
    }

    preset "numerical_svd" {
        description "奇异值分解：将矩阵分解为 A = UΣV^T"
        category "NUMERICAL"
        inputs 1 "MATRIX"
        output "TUPLE"
        math_def "A = U \\Sigma V^T, \\quad \\sigma_i = \\sqrt{\\lambda_i(A^T A)}"
        complexity "O(mn^2)"
        constructive true
        reversible false
    }

}
