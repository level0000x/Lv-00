{
  "name": "Lv00-Magic-Axiom-Pack",
  "version": "1.0.0",
  "description": "Lv-00 编程魔法公理包 - 用公理和约束定义魔法效果",
  "author": "Lv-00 Team",
  "type": "axiom-pack",
  "dependencies": {
    "Lv00Core": ">=1.0.0"
  },
  "axioms": {
    "rune": "axiom_definitions/rune_axioms.md",
    "element": "axiom_definitions/element_axioms.md",
    "casting": "axiom_definitions/casting_axioms.md",
    "domain": "axiom_definitions/domain_axioms.md"
  },
  "theorems": {
    "basic": "spell_theorems/basic_spells.md",
    "composite": "spell_theorems/composite_spells.md",
    "ultimate": "spell_theorems/ultimate_spells.md"
  },
  "elements": [
    { "name": "FIRE", "symbol": "※", "type": "fire" },
    { "name": "WATER", "symbol": "○", "type": "water" },
    { "name": "AIR", "symbol": "◇", "type": "air" },
    { "name": "EARTH", "symbol": "□", "type": "earth" },
    { "name": "ETHER", "symbol": "☆", "type": "ether" }
  ],
  "reactions": [
    { "from": "FIRE", "to": "AIR", "type": "ENHANCE", "factor": 1.2 },
    { "from": "FIRE", "to": "WATER", "type": "CONFLICT", "factor": 0.5 },
    { "from": "WATER", "to": "AIR", "type": "WEAKEN", "factor": 0.8 },
    { "from": "EARTH", "to": "AIR", "type": "CONFLICT", "factor": 0.6 },
    { "from": "WATER", "to": "EARTH", "type": "ENHANCE", "factor": 1.3 }
  ],
  "spells": [
    "Fireball",
    "IceShard",
    "Lightning",
    "EarthWall",
    "Heal",
    "Blizzard",
    "Meteor",
    "Tsunami"
  ],
  "domains": [
    "FireDomain",
    "IceDomain",
    "LightningDomain"
  ]
}
