# =============================================================================
# Lv-00 Axiom Package: Martin-Lof Dependent Type Theory
# =============================================================================
#
# Mathematical Theory: Martin-Lof Dependent Type Theory (Intuitionistic Type Theory)
# Axiomatization: Martin-Lof 1984 Intuitionistic Type Theory + Calculus of Constructions
#
# References:
#   - Wikipedia: Dependent type
#     https://en.wikipedia.org/wiki/Dependent_type
#   - Wikipedia: Intuitionistic type theory
#     https://en.wikipedia.org/wiki/Intuitionistic_type_theory
#   - Martin-Lof, P. (1984). "Intuitionistic Type Theory." Bibliopolis.
#     ISBN 88-7088-105-9.
#   - Nordstrom, B. et al. (1990). "Programming in Martin-Lof's Type Theory."
#     Oxford University Press.
#   - nLab: Martin-Lof type theory
#     https://ncatlab.org/nlab/show/Martin-L%C3%B6f+type+theory
#   - Wikipedia: Calculus of constructions
#     https://en.wikipedia.org/wiki/Calculus_of_constructions
#
# Primitive Concepts:
#   - Type (including dependent types Pi(x:A)B(x) and Sigma(x:A)B(x))
#   - Term (inhabitant of a type)
#   - Typing Judgment: Gamma |- t : A
#
# Core Axioms / Type Formers (4 type constructors + judgment forms):
#   Pi-type (dependent function type): Pi(x:A)B(x)
#   Sigma-type (dependent pair type): Sigma(x:A)B(x)
#   Identity type (propositional equality): Id_A(a, b)
#   Natural number type (inductive type): N with 0 : N and succ : N -> N
#
# Author: Lv-00 Axiom Package System
# Date: 2026-05-22
# Version: 1.0.0
# =============================================================================

axiom "dependent_type_theory" "1.0.0" {

    # =========================================================================
    # Group I: Type Formation Rules (5)
    # =========================================================================

    # Pi-type formation: given A : Type and B : A -> Type, form Pi(x:A)B(x) : Type
    # Dependent function type generalizing A -> B to families indexed by A
    template "pi_type" 2

    # Sigma-type formation: given A : Type and B : A -> Type, form Sigma(x:A)B(x) : Type
    # Dependent pair type generalizing A x B to families indexed by A
    template "sigma_type" 2

    # Identity type formation: given a : A and b : A, form Id_A(a, b) : Type
    # Propositional equality; the type of proofs that a equals b
    template "identity_type" 3

    # Natural number type: N : Type, the inductive type of natural numbers
    # Generated by 0 : N and succ : N -> N
    template "natural_number_type" 0

    # Universe type: Type_i : Type_{i+1}, cumulative hierarchy of type universes
    # Prevents Girard's paradox by stratifying types into predicative levels
    template "universe_type" 1

    # =========================================================================
    # Group II: Term Introduction Rules (5)
    # =========================================================================

    # Lambda abstraction (dependent): given b : B(x) with x : A, form lambda(x:A).b : Pi(x:A)B(x)
    # Introduction rule for Pi-types; generalizes function definition
    template "lambda_abstraction_dependent" 2

    # Pair construction (dependent): given a : A and b : B(a), form (a, b) : Sigma(x:A)B(x)
    # Introduction rule for Sigma-types; the second component depends on the first
    template "pair_dependent" 2

    # Reflexivity: given a : A, form refl(a) : Id_A(a, a)
    # Introduction rule for identity types; every element is equal to itself
    template "refl" 1

    # Zero: 0 : N, the base case of the natural numbers
    template "zero" 0

    # Successor: succ : N -> N, given n : N, form succ(n) : N
    template "successor" 1

    # =========================================================================
    # Group III: Term Elimination Rules (5)
    # =========================================================================

    # Application (dependent): given f : Pi(x:A)B(x) and a : A, form f a : B[a/x]
    # Elimination rule for Pi-types; instantiation of dependent function
    template "application_dependent" 2

    # First projection: given p : Sigma(x:A)B(x), form fst(p) : A
    template "projection_first" 1

    # Second projection: given p : Sigma(x:A)B(x), form snd(p) : B[fst(p)/x]
    # The returned type depends on the first projection
    template "projection_second" 1

    # Natural number induction (eliminator): given motive P : N -> Type,
    # base case z : P(0), and step s : Pi(n:N)P(n) -> P(succ(n)),
    # form elim_N(z, s) : Pi(n:N)P(n)
    template "induction_natural" 3

    # Path induction (J-rule): given motive C : Pi(y:A)Id_A(a,y) -> Type,
    # base case c : C(a, refl(a)), and proof p : Id_A(a, b),
    # form J(c, p) : C(b, p)
    template "path_induction" 3

    # =========================================================================
    # Group IV: Computation Rules (4)
    # =========================================================================

    # Beta reduction (dependent): (lambda(x:A).b) a ~> b[a/x]
    # Computation rule for Pi-types; substitution of argument into body
    template "beta_reduction_dependent" 2

    # Eta expansion (dependent): f ~> lambda(x:A).(f x) when x not free in f
    # Extensionality principle for dependent function types
    template "eta_expansion_dependent" 1

    # Computation rule for natural numbers: elim_N(z, s, 0) ~> z,
    # elim_N(z, s, succ(n)) ~> s(n, elim_N(z, s, n))
    template "computation_natural" 3

    # Computation rule for identity types: J(c, refl(a)) ~> c
    # The path induction principle computes on reflexivity
    template "computation_identity" 2

    # =========================================================================
    # Group V: Type Theory Metatheoretic Properties (5)
    # =========================================================================

    # Canonicity: every closed term of type N evaluates to a numeral (succ^k(0))
    # Ensures computational content of proofs involving natural numbers
    template "canonicity" 1

    # Normalization: every well-typed term has a normal form
    # Strong normalization guarantees termination of all reduction sequences
    template "normalization" 1

    # Decidable type checking: given Gamma, t, A, it is decidable whether Gamma |- t : A
    # Type checking is algorithmic via bidirectional type checking
    template "decidable_type_checking" 3

    # Undecidable type inhabitation: given A, it is undecidable whether there exists t with t : A
    # Even for dependent types, inhabitation is undecidable (Löb's theorem, Statman)
    template "undecidable_type_inhabitation" 1

    # Cumulativity: if A : Type_i then A : Type_{i+1}, universe levels are cumulative
    # Allows implicit promotion of types to higher universes
    template "cumulativity" 2

    # =========================================================================
    # Group VI: Advanced Constructions (5)
    # =========================================================================

    # Inductive family: generalization of W-types to indexed families of inductive types
    # Allows definition of types like Vec(A, n) parameterized by a length index
    template "inductive_family" 3

    # Pattern matching: structural case analysis on inductive type constructors
    # Covers each constructor with a pattern and a result expression
    template "pattern_matching" 3

    # Universe polymorphism: definitions parameterized by universe level variables
    # Allows a single definition to work across multiple universe levels
    template "universe_polymorphism" 1

    # Coercions: implicit conversions between types via type class instances
    # Enables subtyping-like behavior in a purely structural type theory
    template "coercions" 2

    # Type class: record-based dispatch for overloaded definitions
    # Structured implicit arguments resolved by proof search
    template "type_class" 2

    # =========================================================================
    # Group VII: Correspondence with Logic (4)
    # =========================================================================

    # Propositions as Types: a proposition P is represented as the type of its proofs
    # True propositions are inhabited types; false propositions are empty types
    template "propositions_as_types" 1

    # Proof relevance: two proofs of the same proposition may be non-equal
    # Unlike in classical logic, proofs are first-class mathematical objects
    template "proof_relevance" 2

    # Curry-Howard for dependent types: Pi(x:A)B(x) corresponds to forall x:A, B(x),
    # Sigma(x:A)B(x) corresponds to exists x:A, B(x), Id_A(a,b) corresponds to a = b
    template "curry_howard_dependent" 2

    # Constructive existential: Sigma(x:A)B(x) provides both witness and proof
    # Unlike classical exists, constructive exists gives an explicit witness
    template "constructive_existential" 2

    # =========================================================================
    # Known Unconstructible / Undecidable Problems (6)
    # =========================================================================

    # 1. Type inhabitation for dependent types: given a dependent type A, does there
    #    exist a closed term t : A? Undecidable by reduction from Hilbert's 10th problem
    #    and Löb's theorem. Extends the undecidability of simple type inhabitation.
    unconstructible "type_inhabitation_dependent" {
        reduces_to "undecidable"
        dependency "pi_type"
        dependency "sigma_type"
        dependency "lambda_abstraction_dependent"
        dependency "application_dependent"
        external_ref "https://en.wikipedia.org/wiki/Type_inhabitation"
        green_verified true
    }

    # 2. Type equality decidability: given types A and B, is A =_def B?
    #    Definitional equality of dependent types is undecidable in general
    #    due to dependency on term equality during type checking.
    unconstructible "type_equality_decidability" {
        reduces_to "undecidable"
        dependency "identity_type"
        dependency "pi_type"
        dependency "sigma_type"
        dependency "beta_reduction_dependent"
        external_ref "https://ncatlab.org/nlab/show/convertibility"
        green_verified true
    }

    # 3. Normalization order: given a term t, does a specific reduction strategy
    #    reach a normal form? While normalization itself holds, the order of
    #    reduction reaching normal form is undecidable.
    unconstructible "normalization_order" {
        reduces_to "undecidable"
        dependency "beta_reduction_dependent"
        dependency "normalization"
        dependency "lambda_abstraction_dependent"
        dependency "application_dependent"
        external_ref "https://en.wikipedia.org/wiki/Normalisation_property_(abstract_rewriting)"
        green_verified true
    }

    # 4. Universe consistency: is Type : Type consistent? Girard's paradox shows
    #    that Type : Type leads to inconsistency (a type-theoretic analogue of
    #    Russell's paradox). Universe hierarchy is essential for consistency.
    unconstructible "universe_consistency" {
        reduces_to "undecidable"
        dependency "universe_type"
        dependency "cumulativity"
        dependency "pi_type"
        external_ref "https://en.wikipedia.org/wiki/Girard%27s_paradox"
        green_verified true
    }

    # 5. Parametricity verification: given a term t : Pi(A:Type)F(A), does t satisfy
    #    relational parametricity? Parametricity is a metatheoretic property that
    #    cannot be internally verified in general.
    unconstructible "parametricity_verification" {
        reduces_to "undecidable"
        dependency "pi_type"
        dependency "universe_type"
        dependency "lambda_abstraction_dependent"
        dependency "application_dependent"
        external_ref "https://ncatlab.org/nlab/show/parametricity"
        green_verified true
    }

    # 6. Termination checking (general): given a term t in a dependent type theory
    #    with general recursion, does t terminate on all inputs? Undecidable by
    #    reduction from the halting problem.
    unconstructible "termination_checking_dependent" {
        reduces_to "undecidable"
        dependency "natural_number_type"
        dependency "induction_natural"
        dependency "beta_reduction_dependent"
        dependency "normalization"
        external_ref "https://en.wikipedia.org/wiki/Termination_analysis"
        green_verified true
    }

    # =========================================================================
    # Bottom Geometry & Logical Framework
    # =========================================================================

    bottom_geometry "dependent_type_theory_terms"
    negation_encoding "identity_type_to_empty_type"
    contradiction_behavior "explosion_principle"

}
