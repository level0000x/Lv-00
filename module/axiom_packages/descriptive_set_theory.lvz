# =============================================================================
# Lv-00 Axiom Package: Descriptive Set Theory
# =============================================================================
#
# Mathematical Theory: Descriptive Set Theory (DST)
#   Descriptive set theory is the study of certain classes of "well-behaved"
#   subsets of Polish spaces (complete separable metric spaces). It studies
#   the Borel hierarchy, analytic and coanalytic sets, projective sets,
#   and their regularity properties. DST bridges set theory, topology,
#   analysis, and mathematical logic.
#
# Axiomatization: Structural hierarchy + Regularity properties
#   DST is not axiomatized in the traditional sense. Instead, it studies
#   the structure of definable sets in Polish spaces through the Borel
#   hierarchy (Σ^0_α, Π^0_α, Δ^0_α) and projective hierarchy (Σ^1_n, Π^1_n, Δ^1_n).
#   Regularity properties include the property of Baire, perfect set property,
#   and measurability.
#
# References:
#   - Wikipedia: Descriptive set theory
#     https://en.wikipedia.org/wiki/Descriptive_set_theory
#   - Moschovakis, Y.N. (2009). "Descriptive Set Theory" (2nd ed.).
#     American Mathematical Society. ISBN 978-0-8218-4813-5.
#   - Kechris, A.S. (1995). "Classical Descriptive Set Theory."
#     Springer. ISBN 0-387-94374-9.
#   - Wikipedia: Polish space
#     https://en.wikipedia.org/wiki/Polish_space
#   - Wikipedia: Borel set
#     https://en.wikipedia.org/wiki/Borel_set
#   - Wikipedia: Borel hierarchy
#     https://en.wikipedia.org/wiki/Borel_hierarchy
#   - Wikipedia: Analytic set
#     https://en.wikipedia.org/wiki/Analytic_set
#   - Wikipedia: Projective set
#     https://en.wikipedia.org/wiki/Projective_set
#   - Wikipedia: Determinacy
#     https://en.wikipedia.org/wiki/Determinacy
#   - nLab: descriptive set theory
#     https://ncatlab.org/nlab/show/descriptive+set+theory
#   - Stanford Encyclopedia of Philosophy: Set Theory
#     https://plato.stanford.edu/entries/set-theory/
#
# Primitive Notions:
#   Polish space X: a complete separable metric space (metric "forgotten")
#   Borel sets: smallest σ-algebra containing open sets of X
#   Borel hierarchy: classification by countable ordinals (Σ^0_α, Π^0_α, Δ^0_α)
#   Analytic sets: continuous images of Borel sets (Σ^1_1)
#   Coanalytic sets: complements of analytic sets (Π^1_1)
#   Projective sets: defined via projection operations (Σ^1_n, Π^1_n, Δ^1_n)
#
# Core Concepts (8):
#   DST1. Polish space: second-countable, metrizable, complete metric space
#   DST2. Borel σ-algebra: generated by open sets, closed under complement/countable union
#   DST3. Borel hierarchy: Σ^0_1 = open, Π^0_α = complement of Σ^0_α,
#         Σ^0_δ (δ>1) = countable union of Π^0_λ (λ<δ), Δ^0_α = Σ^0_α ∩ Π^0_α
#   DST4. Analytic sets: Σ^1_1 = continuous images of Borel sets
#   DST5. Coanalytic sets: Π^1_1 = complements of analytic sets
#   DST6. Projective hierarchy: Σ^1_{n+1} = projection of Π^1_n subsets of X×X
#   DST7. Regularity properties: Baire property, perfect set property, Lebesgue measurability
#   DST8. Determinacy: infinite games on sets, projective determinacy axiom
#
# Author: Lv-00 Axiom Package System
# Date: 2026-05-23
# Version: 1.0.0
# =============================================================================

axiom "descriptive_set_theory" "1.0.0" {

    # =================================================================
    # Group I: Polish Spaces (6)
    # =================================================================
    # Polish spaces are the foundation of descriptive set theory.
    # They are complete separable metric spaces where the metric is
    # "forgotten" — only the topology matters.
    # =================================================================

    # A Polish space is a topological space X that is:
    #   - Second-countable (has a countable base)
    #   - Metrizable (admits a compatible metric)
    #   - Complete (the metric can be chosen to be complete)
    # Examples: R (real line), Baire space N^N, Cantor space 2^N, Hilbert cube
    # Params: space X (topological space specification)
    template "polish_space" 1

    # Baire space N^N (the space of sequences of natural numbers)
    # is a universal Polish space: every Polish space is a continuous
    # image of a closed subset of Baire space.
    # Params: none (canonical space)
    template "baire_space" 0

    # Cantor space 2^N (the space of infinite binary sequences)
    # is a universal compact Polish space: every compact Polish space
    # is a continuous image of Cantor space.
    # Params: none (canonical space)
    template "cantor_space" 0

    # Hilbert cube I^N = [0,1]^N (infinite-dimensional unit cube)
    # is a universal Polish space for G_δ subspaces.
    # Params: none (canonical space)
    template "hilbert_cube" 0

    # Every uncountable Polish space is Borel isomorphic to the Baire space.
    # This means there exists a bijection f: X → N^N such that both f
    # and f^{-1} are Borel measurable.
    # Params: Polish space X, Borel isomorphism f
    template "borel_isomorphism" 2

    # Every Polish space is homeomorphic to a G_δ subspace of the Hilbert cube.
    # This universality property allows us to study all Polish spaces
    # within a single canonical space.
    # Params: Polish space X, G_δ subspace embedding
    template "polish_as_g_delta_in_hilbert_cube" 2

    # =================================================================
    # Group II: Borel Sets and Borel Hierarchy (7)
    # =================================================================
    # Borel sets are the smallest class containing open sets and closed
    # under complement and countable union. The Borel hierarchy classifies
    # them by the complexity of their construction.
    # =================================================================

    # The Borel σ-algebra of a topological space X is the smallest
    # σ-algebra containing all open subsets of X. It is closed under:
    #   - Complementation: if A is Borel, then X\A is Borel
    #   - Countable unions: if {A_n} are Borel, then ∪_n A_n is Borel
    #   - Countable intersections (by De Morgan)
    # Params: space X, Borel σ-algebra B(X)
    template "borel_sigma_algebra" 2

    # Borel hierarchy base: Σ^0_1 = open sets
    # Every open set is declared to be at the first level of the
    # Borel hierarchy.
    # Params: space X, open set U
    template "sigma_0_1_open" 2

    # Borel hierarchy dual: Π^0_α = complement of Σ^0_α
    # A set is Π^0_α iff its complement is Σ^0_α.
    # Params: ordinal α, set A, complement relation
    template "pi_0_alpha_complement" 3

    # Borel hierarchy union: Σ^0_δ (δ>1) = countable union of Π^0_λ (λ<δ)
    # For limit ordinals δ, Σ^0_δ consists of countable unions of sets
    # from lower levels Π^0_λ where λ<δ.
    # Params: limit ordinal δ, sequence of sets {A_i}, union A
    template "sigma_0_delta_union" 3

    # Borel hierarchy intersection: Δ^0_α = Σ^0_α ∩ Π^0_α
    # A set is Δ^0_α iff it is both Σ^0_α and Π^0_α.
    # This represents sets that can be constructed in both ways.
    # Params: ordinal α, set A, Σ^0_α membership, Π^0_α membership
    template "delta_0_alpha_intersection" 4

    # Borel hierarchy structure: Σ^0_α ∪ Π^0_α ⊂ Δ^0_{α+1}
    # Every set that is Σ^0_α or Π^0_α is also Δ^0_{α+1}.
    # This shows the proper inclusion relationships in the hierarchy.
    # Params: ordinal α, set A, hierarchy level
    template "borel_hierarchy_inclusion" 3

    # Borel codes: every Borel set can be represented by a well-founded
    # labeled tree (Borel code) that describes its construction from
    # basic open sets using complement and countable union operations.
    # Params: Borel set A, Borel code tree T
    template "borel_code" 2

    # =================================================================
    # Group III: Analytic and Coanalytic Sets (5)
    # =================================================================
    # Analytic sets (Σ^1_1) are continuous images of Borel sets.
    # Coanalytic sets (Π^1_1) are their complements. These are the
    # simplest non-Borel sets in descriptive set theory.
    # =================================================================

    # Analytic set: Σ^1_1 = continuous image of Borel set
    # A subset A of a Polish space X is analytic if there exists
    # a Polish space Y, a Borel set B ⊆ Y, and a continuous function
    # f: Y → X such that A = f(B).
    # Params: space X, analytic set A, space Y, Borel set B, continuous f
    template "analytic_set_sigma_1_1" 5

    # Suslin's theorem: a set is Borel iff it is both analytic and coanalytic
    # A set A is Δ^1_1 (both Σ^1_1 and Π^1_1) iff A is Borel.
    # This is a fundamental characterization of Borel sets.
    # Params: set A, analytic status, coanalytic status, Borel status
    template "suslin_theorem" 4

    # Coanalytic set: Π^1_1 = complement of Σ^1_1
    # A set is coanalytic iff its complement is analytic.
    # Params: set A, complement relation, analytic status
    template "coanalytic_set_pi_1_1" 3

    # Analytic separation: if A, B are disjoint analytic sets,
    # then there exists a Borel set C separating them (A ⊆ C, B ∩ C = ∅)
    # This is a key property used in many proofs in DST.
    # Params: analytic set A, analytic set B, Borel separator C
    template "analytic_separation" 3

    # Coanalytic uniformization: every coanalytic subset of X×Y
    # can be uniformized by a coanalytic function (under certain conditions)
    # This is related to the selection principles in DST.
    # Params: coanalytic set R ⊆ X×Y, uniformizing function f
    template "coanalytic_uniformization" 2

    # =================================================================
    # Group IV: Projective Hierarchy (6)
    # =================================================================
    # The projective hierarchy extends the Borel and analytic/coanalytic
    # sets through projection operations. It forms the backbone of
    # classical descriptive set theory.
    # =================================================================

    # Projective hierarchy base: Σ^1_1 = analytic (already defined)
    # This establishes the foundation of the projective hierarchy.
    # Params: set A, analytic status
    template "projective_base_sigma_1_1" 2

    # Projective hierarchy dual: Π^1_n = complement of Σ^1_n
    # For any n ≥ 1, a set is Π^1_n iff its complement is Σ^1_n.
    # Params: level n, set A, complement relation
    template "projective_dual_pi_1_n" 3

    # Projective hierarchy projection: Σ^1_{n+1} = projection of Π^1_n
    # A set A ⊆ X is Σ^1_{n+1} if there exists a Π^1_n set B ⊆ X×X
    # such that A = {x ∈ X : ∃y ∈ X, (x,y) ∈ B} (projection to first coordinate).
    # Params: level n, set A, set B ⊆ X×X, projection relation
    template "projective_projection_sigma_1_n_plus_1" 4

    # Projective hierarchy intersection: Δ^1_n = Σ^1_n ∩ Π^1_n
    # A set is Δ^1_n iff it is both Σ^1_n and Π^1_n.
    # Params: level n, set A, Σ^1_n status, Π^1_n status
    template "projective_intersection_delta_1_n" 4

    # Projective hierarchy inclusion: Σ^1_n ∪ Π^1_n ⊂ Δ^1_{n+1}
    # Every set that is Σ^1_n or Π^1_n is also Δ^1_{n+1}.
    # This mirrors the structure of the Borel hierarchy.
    # Params: level n, set A, hierarchy level
    template "projective_hierarchy_inclusion" 3

    # Projective sets are closed under continuous preimages
    # If A ⊆ Y is projective and f: X → Y is continuous, then f^{-1}(A) is projective
    # of the same level. This shows the stability of the hierarchy.
    # Params: set A ⊆ Y, continuous f: X → Y, preimage f^{-1}(A)
    template "projective_continuous_preimage" 3

    # =================================================================
    # Group V: Regularity Properties (6)
    # =================================================================
    # Regularity properties are "well-behaved" properties that all Borel
    # sets satisfy, but may fail for more complex sets. They include
    # the Baire property, perfect set property, and measurability.
    # =================================================================

    # Property of Baire: a set A has the Baire property if there exists
    # an open set U such that the symmetric difference A Δ U is meager
    # (first category). All Borel sets have the Baire property.
    # Params: set A, open set U, meager set M (A Δ U = M)
    template "property_of_baire" 3

    # Perfect set property: a set A has the perfect set property if
    # either A is countable or A contains a perfect subset (nonempty
    # closed set with no isolated points). All Borel sets have this property.
    # Params: set A, countable status, perfect subset P
    template "perfect_set_property" 3

    # Lebesgue measurability: a set A ⊆ R is Lebesgue measurable if
    # for every ε > 0, there exists an open set U ⊇ A such that
    # m*(U \ A) < ε (outer measure). All Borel sets are measurable.
    # Params: set A ⊆ R, measurability condition
    template "lebesgue_measurability" 2

    # Borel regularity: every Borel set has all three regularity properties
    # (Baire property, perfect set property, Lebesgue measurability).
    # This is a fundamental theorem of classical DST.
    # Params: Borel set A, Baire property, perfect set property, measurability
    template "borel_regularity" 4

    # Analytic sets have the perfect set property
    # Every uncountable analytic set contains a perfect subset.
    # This is a key result extending the Borel case.
    # Params: analytic set A, perfect subset P
    template "analytic_perfect_set_property" 2

    # Coanalytic sets may fail regularity properties
    # There exist coanalytic sets without the Baire property,
    # without the perfect set property, or non-measurable (requires AC).
    # This shows the limits of regularity beyond the analytic level.
    # Params: coanalytic set A, regularity failure type
    template "coanalytic_regularity_failure" 2

    # =================================================================
    # Group VI: Determinacy and Infinite Games (5)
    # =================================================================
    # Determinacy is a powerful alternative to the axiom of choice.
    # It studies infinite games where players alternate choosing moves,
    # and the winner is determined by whether the resulting infinite
    # sequence belongs to a given set.
    # =================================================================

    # Infinite game G(A) on a set A ⊆ X^ω
    # Two players I and II alternate choosing elements x_0, x_1, x_2, ...
    # from a set X. Player I wins if the resulting sequence (x_n) ∈ A,
    # otherwise Player II wins.
    # Params: set A ⊆ X^ω, game G(A), winning condition
    template "infinite_game" 3

    # Determinacy: a set A is determined if one of the players has a
    # winning strategy in the game G(A). A winning strategy is a function
    # that tells the player what move to make based on the opponent's
    # previous moves.
    # Params: set A, winning strategy for player I or II
    template "determinacy" 2

    # Borel determinacy: every Borel set is determined
    # This is a deep theorem proved by Martin (1975). It requires
    # substantial set-theoretic machinery but does not require AC.
    # Params: Borel set A, determinacy status
    template "borel_determinacy" 2

    # Projective determinacy (PD): every projective set is determined
    # This is a strong axiom that cannot be proved in ZFC. It implies
    # many regularity properties for projective sets.
    # Params: projective set A, determinacy status under PD
    template "projective_determinacy" 2

    # Determinacy implies regularity properties
    # If a set A is determined, then A has the Baire property,
    # the perfect set property, and is Lebesgue measurable.
    # This shows the power of determinacy as an alternative to AC.
    # Params: determined set A, Baire property, perfect set property, measurability
    template "determinacy_regularity_consequences" 4

    # =================================================================
    # Group VII: Borel Equivalence Relations (4)
    # =================================================================
    # Borel equivalence relations are equivalence relations on Polish
    # spaces that are Borel as subsets of X×X. Their classification
    # is a major area of modern descriptive set theory.
    # =================================================================

    # Borel equivalence relation: an equivalence relation E on a Polish
    # space X such that E ⊆ X×X is a Borel set.
    # Params: Polish space X, equivalence relation E, Borel status
    template "borel_equivalence_relation" 3

    # Smooth equivalence relation: E is smooth if there exists a Borel
    # function f: X → Y to a Polish space Y such that x E y iff f(x) = f(y).
    # Smooth relations are "classifiable by countable structures."
    # Params: equivalence relation E, classifying function f
    template "smooth_equivalence_relation" 2

    # Hyperfinite equivalence relation: E is hyperfinite if it can be
    # written as an increasing union of finite Borel equivalence relations.
    # Hyperfinite relations are a natural generalization of finite relations.
    # Params: equivalence relation E, finite equivalence relations {E_n}
    template "hyperfinite_equivalence_relation" 2

    # Borel reducibility: E ≤_B F if there exists a Borel function
    # f: X → Y such that x E y iff f(x) F f(y). This defines a partial
    # order on the complexity of equivalence relations.
    # Params: equivalence relations E on X, F on Y, Borel reduction f
    template "borel_reducibility" 3

    # =================================================================
    # Known Unconstructible/Undecidable Problems
    # =================================================================

    unconstructible "projective_set_determinacy" {
        reduces_to "independent_of_ZFC"
        dependency "zfc_set_theory"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Projective_determinacy"
        green_verified true
    }

    unconstructible "analytic_set_completeness" {
        reduces_to "coanalytic"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Analytic_set"
        green_verified true
    }

    unconstructible "coanalytic_uniformization" {
        reduces_to "requires_choice_axiom"
        dependency "zfc_set_theory"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Uniformization_(set_theory)"
        green_verified true
    }

    unconstructible "projective_hierarchy_collapse" {
        reduces_to "independent_of_ZFC"
        dependency "zfc_set_theory"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Projective_hierarchy"
        green_verified true
    }

    unconstructible "borel_rank_computation" {
        reduces_to "undecidable"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Borel_hierarchy"
        green_verified true
    }

    unconstructible "wadge_degree_comparison" {
        reduces_to "undecidable"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Wadge_hierarchy"
        green_verified true
    }

    unconstructible "borel_equivalence_classification" {
        reduces_to "undecidable"
        dependency "descriptive_set_theory"
        external_ref "https://en.wikipedia.org/wiki/Borel_equivalence_relation"
        green_verified true
    }

    # =================================================================
    # Logical Framework Settings
    # =================================================================

    bottom_geometry "polish_space_borel_hierarchy"
    negation_encoding "classical_complement_in_polish_space"
    contradiction_behavior "explosion_principle"
}