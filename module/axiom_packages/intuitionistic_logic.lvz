# =============================================================================
# Lv-00 Axiom Package: Intuitionistic Propositional Logic (Heyting's Calculus)
# =============================================================================
#
# Mathematical Theory: Intuitionistic Propositional Logic (IPL)
# Axiomatization: Hilbert-style calculus by Arend Heyting (1930)
#
# References:
#   - Heyting, A. (1930). "Die formalen Regeln der intuitionistischen Logik."
#     Sitzungsberichte der Preußischen Akademie der Wissenschaften,
#     Physikalisch-Mathematische Klasse, 42-56, 57-71, 158-169.
#   - Wikipedia: Intuitionistic logic
#     https://en.wikipedia.org/wiki/Intuitionistic_logic
#   - nLab: intuitionistic logic
#     https://ncatlab.org/nlab/show/intuitionistic+logic
#   - Stanford Encyclopedia of Philosophy: Intuitionistic Logic
#     https://plato.stanford.edu/entries/logic-intuitionistic/
#   - Mendelson, E. (2015). "Introduction to Mathematical Logic," 6th ed. CRC Press.
#   - Troelstra, A.S. & van Dalen, D. (1988). "Constructivism in Mathematics."
#     North-Holland. ISBN 0-444-70266-0.
#   - Sørensen, M.H. & Urzyczyn, P. (2006). "Lectures on the Curry-Howard
#     Isomorphism." Elsevier. ISBN 0-444-52077-5.
#   - Statman, R. (1979). "Intuitionistic propositional logic is polynomial-space
#     complete." Theoretical Computer Science, 9: 67-72.
#     https://doi.org/10.1016/0304-3975(79)90006-9
#
# Core Axioms (10 Hilbert-style schemas + 1 inference rule):
#   H1 (THEN-1):     ψ → (φ → ψ)
#   H2 (THEN-2):     (χ → (φ → ψ)) → ((χ → φ) → (χ → ψ))
#   H3 (AND-1):      φ ∧ χ → φ
#   H4 (AND-2):      φ ∧ χ → χ
#   H5 (AND-3):      φ → (χ → (φ ∧ χ))
#   H6 (OR-1):       φ → φ ∨ χ
#   H7 (OR-2):       χ → φ ∨ χ
#   H8 (OR-3):       (φ → ψ) → ((χ → ψ) → ((φ ∨ χ) → ψ))
#   H9 (FALSE/EFQ):  ⊥ → φ
#   H10 (MP):        From φ → ψ and φ, infer ψ
#
# Primitive Connectives: → (implication), ∧ (conjunction), ∨ (disjunction), ⊥ (falsum)
# Defined Negation: ¬φ ≡ φ → ⊥ (Brouwer-Heyting-Kolmogorov interpretation)
#
# Key Differences from Classical Propositional Logic (CPL):
#   1. No Law of Excluded Middle: φ ∨ ¬φ is NOT a theorem
#   2. No Double Negation Elimination: ¬¬φ → φ is NOT a theorem
#   3. Negation is constructive: ¬φ means "φ leads to contradiction (⊥)"
#   4. Disjunction Property: If ⊢ φ ∨ ψ, then ⊢ φ or ⊢ ψ
#   5. Ex falso quodlibet (⊥ → φ) IS an axiom
#   6. φ → ¬¬φ IS valid (double negation introduction)
#   7. ¬¬¬φ → ¬φ IS valid (triple negation reduces to single)
#
# Algebraic Semantics: Heyting algebras
# Categorical Semantics: Cartesian closed categories (Curry-Howard correspondence)
#
# Relationship to Existing Lv-00 Packages:
#   - classical_propositional_logic: IPL is a proper subsystem of CPL
#   - boolean_algebra: Heyting algebras generalize Boolean algebras
#     (Lindenbaum-Tarski algebra of IPL is a Heyting algebra, not Boolean)
#
# Author: Lv-00 Axiom Package System
# Date: 2026-05-21
# Version: 1.0.0
# =============================================================================

axiom "intuitionistic_logic" "1.0.0" {

    # =========================================================================
    # Group I: Heyting's Hilbert-Style Core Axioms (10)
    # =========================================================================

    # H1 (THEN-1): ψ → (φ → ψ) — Weakening / "K combinator"
    template "axiom_then_1_weakening" 2

    # H2 (THEN-2): (χ → (φ → ψ)) → ((χ → φ) → (χ → ψ)) — Distribution / "S combinator"
    template "axiom_then_2_distribution" 3

    # H3 (AND-1): φ ∧ χ → φ — Conjunction left elimination
    template "axiom_and_1_elim_left" 2

    # H4 (AND-2): φ ∧ χ → χ — Conjunction right elimination
    template "axiom_and_2_elim_right" 2

    # H5 (AND-3): φ → (χ → (φ ∧ χ)) — Conjunction introduction
    template "axiom_and_3_intro" 2

    # H6 (OR-1): φ → φ ∨ χ — Disjunction left introduction
    template "axiom_or_1_intro_left" 2

    # H7 (OR-2): χ → φ ∨ χ — Disjunction right introduction
    template "axiom_or_2_intro_right" 2

    # H8 (OR-3): (φ → ψ) → ((χ → ψ) → ((φ ∨ χ) → ψ)) — Disjunction elimination
    template "axiom_or_3_elim" 3

    # H9 (FALSE/EFQ): ⊥ → φ — Ex falso quodlibet (from false, anything follows)
    template "axiom_false_efq" 1

    # H10 (MP): Modus Ponens — From φ → ψ and φ, infer ψ
    template "modus_ponens" 2

    # =========================================================================
    # Group II: Primitive Connectives (4)
    # =========================================================================

    # Implication: φ → ψ
    template "implication" 2

    # Conjunction: φ ∧ ψ
    template "conjunction" 2

    # Disjunction: φ ∨ ψ
    template "disjunction" 2

    # Falsum (constant): ⊥
    template "falsum" 0

    # =========================================================================
    # Group III: Constructive Negation (¬φ ≡ φ → ⊥) (4)
    # =========================================================================

    # Double negation introduction: φ → ¬¬φ  (always intuitionistically valid)
    template "double_negation_intro" 1

    # Triple negation reduction: ¬¬¬φ → ¬φ  (intuitionistically valid equivalence)
    template "triple_negation_reduction" 1

    # Negation introduction: (φ → ψ) → (φ → ¬ψ) → ¬φ
    template "negation_intro_schema" 3

    # Verum (truth constant): ⊤ ≡ ¬⊥ ≡ ⊥ → ⊥
    template "verum" 0

    # =========================================================================
    # Group IV: Constructive Elementary Theorems (12)
    # =========================================================================

    # Identity: φ → φ
    template "identity" 1

    # Transitivity: (φ → ψ) → ((ψ → χ) → (φ → χ))
    template "transitivity" 3

    # Conjunction commutativity: (φ ∧ ψ) → (ψ ∧ φ)
    template "conjunction_commutativity" 2

    # Conjunction associativity: (φ ∧ (ψ ∧ χ)) → ((φ ∧ ψ) ∧ χ)
    template "conjunction_associativity" 3

    # Disjunction commutativity: (φ ∨ ψ) → (ψ ∨ φ)
    template "disjunction_commutativity" 2

    # Disjunction associativity: (φ ∨ (ψ ∨ χ)) → ((φ ∨ ψ) ∨ χ)
    template "disjunction_associativity" 3

    # Conjunction-distributes-over-disjunction: φ ∧ (ψ ∨ χ) → (φ ∧ ψ) ∨ (φ ∧ χ)
    template "conj_over_disj_distribution" 3

    # Disjunction-distributes-over-conjunction: φ ∨ (ψ ∧ χ) → (φ ∨ ψ) ∧ (φ ∨ χ)
    template "disj_over_conj_distribution" 3

    # Constructive contrapositive intro: (φ → ψ) → (¬ψ → ¬φ)
    template "contrapositive_constructive_intro" 2

    # Excluded middle is NOT contradictory: ¬¬(φ ∨ ¬φ)  (intuitionistically valid!)
    template "excluded_middle_not_false" 1

    # Double negation of equivalence: ¬¬(φ ↔ ψ) intuitionistically valid
    template "double_negated_equivalence" 2

    # Modus tollens (constructive): (φ → ψ) ∧ ¬ψ → ¬φ
    template "modus_tollens_constructive" 2

    # =========================================================================
    # Group V: Derived Constructors (6)
    # =========================================================================

    # Biconditional: φ ↔ ψ ≡ (φ → ψ) ∧ (ψ → φ)
    template "biconditional" 2

    # Sheffer stroke (NAND): φ | ψ ≡ ¬(φ ∧ ψ)
    template "sheffer_stroke" 2

    # Peirce arrow (NOR): φ ↓ ψ ≡ ¬(φ ∨ ψ)
    template "peirce_arrow" 2

    # Exclusive OR: φ ⊕ ψ ≡ (φ ∨ ψ) ∧ ¬(φ ∧ ψ)
    template "exclusive_or" 2

    # Generated falsum: ¬(φ ∧ ¬φ)
    template "non_contradiction" 1

    # Subformula construction: φ[ψ/A] — substitution instance
    template "substitution" 2

    # =========================================================================
    # Group VI: Curry-Howard / Lambda Calculus Correspondence (8)
    # =========================================================================

    # K combinator: λx.λy.x corresponds to axiom_then_1_weakening
    template "ch_k_combinator" 2

    # S combinator: λx.λy.λz.(x z)(y z) corresponds to axiom_then_2_distribution
    template "ch_s_combinator" 3

    # Pair constructor: ⟨a,b⟩ corresponds to conjunction intro
    template "ch_pair" 2

    # First projection: fst(p) corresponds to AND-1
    template "ch_fst" 1

    # Second projection: snd(p) corresponds to AND-2
    template "ch_snd" 1

    # Left injection: inl(a) corresponds to OR-1
    template "ch_inl" 1

    # Right injection: inr(b) corresponds to OR-2
    template "ch_inr" 1

    # Case analysis: case(x, f, g) corresponds to OR-3 (disjunction elimination)
    template "ch_case" 3

    # =========================================================================
    # Group VII: Non-Theorems — Classical Principles NOT Provable in IPL (6)
    # These templates mark the formal boundary with classical logic.
    # They are declared as templates (for structural comparison) but their
    # constructive status is explicitly denied below as unconstructible.
    # =========================================================================

    # Law of Excluded Middle (LEM): φ ∨ ¬φ
    template "lem_boundary_marker" 1

    # Double Negation Elimination (DNE): ¬¬φ → φ
    template "dne_boundary_marker" 1

    # Peirce's Law: ((φ → ψ) → φ) → φ
    template "peirce_boundary_marker" 2

    # Classical contrapositive: (¬ψ → ¬φ) → (φ → ψ)
    template "classical_contrapositive_marker" 2

    # De Morgan's Law (failure direction): ¬(φ ∧ ψ) → (¬φ ∨ ¬ψ)
    template "de_morgan_failure_marker" 2

    # Weak Law of Excluded Middle (WLEM): ¬φ ∨ ¬¬φ
    template "wlem_boundary_marker" 1

    # =========================================================================
    # Known Unconstructible / Hard Problems in Intuitionistic Logic (7)
    # =========================================================================

    # 1. Law of Excluded Middle is NOT an IPL theorem
    unconstructible "law_of_excluded_middle_unconstructible" {
        reduces_to "lem_boundary_marker"
        dependency "axiom_or_1_intro_left"
        dependency "axiom_false_efq"
        dependency "double_negation_intro"
        external_ref "https://en.wikipedia.org/wiki/Law_of_excluded_middle"
        green_verified true
    }

    # 2. Double Negation Elimination is NOT an IPL theorem
    unconstructible "double_negation_elim_unconstructible" {
        reduces_to "dne_boundary_marker"
        dependency "axiom_false_efq"
        dependency "double_negation_intro"
        dependency "triple_negation_reduction"
        external_ref "https://en.wikipedia.org/wiki/Double_negation#Double_negation_elimination"
        green_verified true
    }

    # 3. Peirce's Law is NOT an IPL theorem
    unconstructible "peirce_law_unconstructible" {
        reduces_to "peirce_boundary_marker"
        dependency "axiom_then_1_weakening"
        dependency "axiom_then_2_distribution"
        dependency "modus_ponens"
        external_ref "https://en.wikipedia.org/wiki/Peirce%27s_law"
        green_verified true
    }

    # 4. IPL Provability (Tautology Checking): PSPACE-complete
    unconstructible "ipl_provability_pspace_complete" {
        reduces_to "sat_tautology_checking"
        dependency "axiom_then_1_weakening"
        dependency "axiom_then_2_distribution"
        dependency "modus_ponens"
        external_ref "https://en.wikipedia.org/wiki/Intuitionistic_logic#Decidability"
        green_verified true
    }

    # 5. Classical-to-intuitionistic proof translation: undecidable in general
    unconstructible "classical_proof_constructive_translation" {
        reduces_to "double_negation_translation_complexity"
        dependency "double_negation_intro"
        dependency "axiom_then_1_weakening"
        dependency "axiom_then_2_distribution"
        external_ref "https://en.wikipedia.org/wiki/Double-negation_translation"
        green_verified true
    }

    # 6. Non-interdefinability of connectives: ∨ not definable from {→,∧,⊥}
    unconstructible "disjunction_nondefinability" {
        reduces_to "connective_independence"
        dependency "axiom_or_1_intro_left"
        dependency "axiom_or_2_intro_right"
        dependency "axiom_or_3_elim"
        external_ref "https://en.wikipedia.org/wiki/Intuitionistic_logic#Non-interdefinability_of_operators"
        green_verified true
    }

    # 7. Admissibility problem: EXPTIME-complete (Rybakov 1997)
    unconstructible "admissibility_checking_exptime" {
        reduces_to "rule_admissibility_decision"
        dependency "modus_ponens"
        dependency "axiom_then_1_weakening"
        dependency "axiom_then_2_distribution"
        external_ref "https://en.wikipedia.org/wiki/Admissible_rule"
        green_verified true
    }

    # =========================================================================
    # Logical Framework Configuration
    # =========================================================================

    # Bottom geometry: Heyting-Pseudo-Boolean algebra of open sets.
    # Truth values: open sets of a topological space, forming a Heyting algebra.
    # Denial of truth is NOT assertion of falsity — it means "not in the interior."
    bottom_geometry "intuitionistic_heyting_algebra_open_topology"

    # Negation encoding: ¬φ is DEFINED as φ → ⊥ (BHK interpretation).
    # This is the SAME syntactic encoding as in classical logic, but with
    # DIFFERENT semantics — ¬φ means "a proof of φ would yield a contradiction,"
    # NOT "φ is false." Intuitionistic negation is potential, not actual.
    negation_encoding "brouwer_heyting_kolmogorov_implication_to_falsum"

    # Contradiction behavior: EXPLOSION PRINCIPLE (ex falso quodlibet).
    # IMPORTANT: Intuitionistic logic DOES accept ex falso:
    #   ⊥ → φ is an axiom (axiom_false_efq above).
    # The difference from classical logic is NOT about explosion —
    # it's about the MEANING of ⊥ and ¬: in intuitionistic logic,
    # ¬φ means "φ can be shown to lead to a contradiction," and
    # ¬¬φ does NOT imply φ. The explosion principle still holds
    # because once you have ⊥ (a proven contradiction), you CAN
    # derive anything — ex falso is constructively valid.
    contradiction_behavior "explosion_principle"

}
