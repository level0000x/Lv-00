/**
 * @file preset_basic_geometry_v2.c
 * @brief 基础几何构造预设函数块 - 重构实现
 *
 * @details 实现基础几何构造模块的所有预设函数块。
 *          采用新的模块化架构，使用统一的注册接口。
 *
 * @module BasicGeometry
 * @category PRESET_CATEGORY_CONSTRUCTION
 * @version 4.0.0
 */

/*
 * ============================================================
 * 【已弃用 - 请勿编译此文件】
 * ============================================================
 * 本文件（preset_basic_geometry_v2.c）已被统一到 preset_basic_geometry.c，
 * 当前文件仅保留作为历史参考，不应参与任何构建。
 *
 * 原因：
 *   1. preset_basic_geometry.c 和 preset_basic_geometry_v2.c 定义了同名的
 *      preset_basic_geometry_register() 函数，会导致链接时符号冲突。
 *   2. CMakeLists.txt 中已排除本文件（重命名为 .deprecated），统一使用
 *      src/preset_basic_geometry.c。
 *   3. preset_basic_geometry.c 已包含 v2 中全部 35 个预设的注册逻辑。
 *
 * 如果不慎将本文件加入编译，下面的 #error 将阻止构建并给出提示。
 * ============================================================
 */
#error "preset_basic_geometry_v2.c 已被弃用，请使用 src/preset_basic_geometry.c 替代。如果这是误操作，请从 CMakeLists.txt 中移除本文件的引用。"

#include "preset_basic_geometry.h"
#include "preset_blocks.h"

#include <string.h>

/* ============================================================
 * 预设数量定义
 * ============================================================ */

/** 基础几何模块预设函数块总数 */
#define BASIC_GEOMETRY_PRESET_COUNT 35

/* ============================================================
 * 内部辅助函数
 * ============================================================ */

/**
 * @brief 注册单个基础几何预设
 *
 * 辅助函数，用于简化预设注册过程。
 *
 * @param name 预设名称
 * @param description 描述
 * @param input_types 输入类型数组
 * @param input_count 输入数量
 * @param output_type 输出类型
 * @param math_def 数学定义
 * @param complexity 复杂度
 * @param is_constructive 是否构造性
 * @param is_reversible 是否可逆
 * @return true 注册成功
 * @return false 注册失败
 */
static bool register_basic_geometry_preset(
    const char *name,
    const char *description,
    const PresetType *input_types,
    int input_count,
    PresetType output_type,
    const char *math_def,
    const char *complexity,
    bool is_constructive,
    bool is_reversible)
{
    return preset_blocks_register_simple(
        name, description,
        PRESET_CATEGORY_CONSTRUCTION,
        input_types, input_count, output_type,
        math_def, complexity,
        is_constructive, is_reversible);
}

/**
 * @brief 简化预设注册的宏
 * 减少重复代码，提高可维护性
 */
#define REGISTER_BASIC(name, desc, inputs, in_count, output, math, comp, cons, rev) \
    do { \
        if (register_basic_geometry_preset( \
                (name), (desc), (inputs), (in_count), (output), \
                (math), (comp), (cons), (rev))) { \
            success_count++; \
        } else { \
            PRESET_ERROR_LOG("注册预设失败: %s", (name)); \
        } \
    } while (0)

/* ============================================================
 * 模块注册实现
 * ============================================================ */

bool preset_basic_geometry_register(void)
{
    int success_count = 0;

    /* ============================================================
     * 点的构造 (7个)
     * ============================================================ */

    {
        /* 通过坐标构造点 P(x, y) */
        PresetType inputs[] = {PRESET_TYPE_SCALAR, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_POINT_FROM_COORDS,
            "通过笛卡尔坐标构造点 P(x, y)",
            inputs, 2, PRESET_TYPE_POINT,
            "P(x, y) 其中 x, y 为实数坐标",
            "O(1)", true, true);
    }

    {
        /* 中点构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_MIDPOINT,
            "构造两点之间的中点 M = (A+B)/2",
            inputs, 2, PRESET_TYPE_POINT,
            "M = (A + B) / 2，即中点公式",
            "O(1)", true, false);
    }

    {
        /* 重心构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_CENTROID,
            "构造三角形的重心 G = (A+B+C)/3",
            inputs, 3, PRESET_TYPE_POINT,
            "G = (A + B + C) / 3，三条中线的交点",
            "O(1)", true, false);
    }

    {
        /* 外心构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_CIRCUMCENTER,
            "构造三角形的外心（外接圆圆心）",
            inputs, 3, PRESET_TYPE_POINT,
            "三条垂直平分线的交点，到三个顶点距离相等",
            "O(1)", true, false);
    }

    {
        /* 内心构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_INCENTER,
            "构造三角形的内心（内切圆圆心）",
            inputs, 3, PRESET_TYPE_POINT,
            "三条角平分线的交点，到三边距离相等",
            "O(1)", true, false);
    }

    {
        /* 垂心构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_ORTHOCENTER,
            "构造三角形的垂心（三条高的交点）",
            inputs, 3, PRESET_TYPE_POINT,
            "三条高的交点",
            "O(1)", true, false);
    }

    {
        /* 旁心构造 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_EXCENTER,
            "构造三角形的旁心（旁切圆圆心）",
            inputs, 3, PRESET_TYPE_POINT,
            "一条内角平分线与两条外角平分线的交点",
            "O(1)", true, false);
    }

    /* ============================================================
     * 线段操作 (3个)
     * ============================================================ */

    {
        /* 通过两点构造线段 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_SEGMENT_FROM_POINTS,
            "通过两点构造线段 AB",
            inputs, 2, PRESET_TYPE_LINE_SEGMENT,
            "线段 AB 连接点 A 和点 B",
            "O(1)", true, false);
    }

    {
        /* 垂直平分线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_PERPENDICULAR_BISECTOR,
            "构造线段的垂直平分线",
            inputs, 2, PRESET_TYPE_LINE,
            "过中点且垂直于线段的直线",
            "O(1)", true, false);
    }

    {
        /* 中垂线上的点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_POINT_ON_PERP_BISECTOR,
            "在中垂线上构造距离中点为 d 的点",
            inputs, 3, PRESET_TYPE_POINT,
            "在中垂线上距离中点为 d 的点，产生两个解",
            "O(1)", true, false);
    }

    /* ============================================================
     * 直线和射线 (5个)
     * ============================================================ */

    {
        /* 通过两点构造直线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_LINE_FROM_POINTS,
            "通过两点构造无限直线",
            inputs, 2, PRESET_TYPE_LINE,
            "通过两点的唯一确定直线",
            "O(1)", true, false);
    }

    {
        /* 平行线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_PARALLEL_LINE,
            "过点作平行于给定线段的直线",
            inputs, 3, PRESET_TYPE_LINE,
            "过点 P 且平行于线段 AB 的直线",
            "O(1)", true, false);
    }

    {
        /* 垂线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_PERPENDICULAR_LINE,
            "过点作垂直于给定线段的直线",
            inputs, 3, PRESET_TYPE_LINE,
            "过点 P 且垂直于线段 AB 的直线",
            "O(1)", true, false);
    }

    {
        /* 射线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_RAY_FROM_POINTS,
            "通过起点和方向点构造射线",
            inputs, 2, PRESET_TYPE_RAY,
            "从 O 出发经过 D 的射线",
            "O(1)", true, false);
    }

    {
        /* 角平分线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_ANGLE_BISECTOR,
            "构造角平分线",
            inputs, 3, PRESET_TYPE_LINE,
            "平分角 ABC 的直线",
            "O(1)", true, false);
    }

    /* ============================================================
     * 圆的构造 (4个)
     * ============================================================ */

    {
        /* 圆心和半径点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_CIRCLE_CENTER_RADIUS,
            "通过圆心和半径点构造圆",
            inputs, 2, PRESET_TYPE_CIRCLE,
            "圆心为 O，半径为 |OR| 的圆",
            "O(1)", true, false);
    }

    {
        /* 三点定圆 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_CIRCLE_THREE_POINTS,
            "通过三点构造外接圆",
            inputs, 3, PRESET_TYPE_CIRCLE,
            "通过不共线三点的唯一圆",
            "O(1)", true, false);
    }

    {
        /* 切线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_TANGENT_FROM_POINT,
            "从外部点向圆作切线",
            inputs, 3, PRESET_TYPE_LINE,
            "从点 P 到圆 C(O,R) 的切线，产生两条",
            "O(1)", true, false);
    }

    {
        /* 公切线 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT,
                               PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_COMMON_TANGENTS,
            "构造两圆的公切线",
            inputs, 4, PRESET_TYPE_LINE,
            "圆 C1(O1,R1) 与 C2(O2,R2) 的公切线",
            "O(1)", true, false);
    }

    /* ============================================================
     * 交点计算 (4个)
     * ============================================================ */

    {
        /* 两直线交点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, 
                               PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_LINE_INTERSECTION,
            "计算两直线的交点",
            inputs, 4, PRESET_TYPE_POINT,
            "直线 L1(P1,P2) 与 L2(P3,P4) 的交点",
            "O(1)", true, false);
    }

    {
        /* 直线与圆交点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT,
                               PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_LINE_CIRCLE_INTERSECTION,
            "计算直线与圆的交点",
            inputs, 4, PRESET_TYPE_POINT,
            "直线 L(P1,P2) 与圆 C(O,R) 的交点，0-2个解",
            "O(1)", true, false);
    }

    {
        /* 两圆交点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT,
                               PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_CIRCLE_CIRCLE_INTERSECTION,
            "计算两圆的交点",
            inputs, 4, PRESET_TYPE_POINT,
            "圆 C1(O1,R1) 与 C2(O2,R2) 的交点，0-2个解",
            "O(1)", true, false);
    }

    {
        /* 根轴 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT,
                               PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_RADICAL_AXIS,
            "计算两圆的根轴",
            inputs, 4, PRESET_TYPE_LINE,
            "到两圆切线长相等的点的轨迹",
            "O(1)", true, false);
    }

    /* ============================================================
     * 反射与对称 (3个)
     * ============================================================ */

    {
        /* 点关于直线反射 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_REFLECT_POINT_OVER_LINE,
            "点关于直线的反射（对称点）",
            inputs, 3, PRESET_TYPE_POINT,
            "点 P 关于直线 L(P1,P2) 的对称点 P'",
            "O(1)", true, true);
    }

    {
        /* 点关于点反射 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_REFLECT_POINT_OVER_POINT,
            "点关于点的中心对称",
            inputs, 2, PRESET_TYPE_POINT,
            "点 P 关于中心 O 的对称点 P'，满足 O 是 PP' 中点",
            "O(1)", true, true);
    }

    {
        /* 点关于圆的反演 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_INVERT_POINT_IN_CIRCLE,
            "点关于圆的反演（反演变换）",
            inputs, 3, PRESET_TYPE_POINT,
            "点 P 关于圆 C(O,R) 的反演点 P'，满足 |OP|·|OP'| = R²",
            "O(1)", true, true);
    }

    /* ============================================================
     * 特殊点构造 (5个)
     * ============================================================ */

    {
        /* 按比例分割 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_POINT_DIVIDE_SEGMENT,
            "按比例分割线段的点",
            inputs, 3, PRESET_TYPE_POINT,
            "点 P 在 AB 上满足 AP:PB = t:(1-t)",
            "O(1)", true, false);
    }

    {
        /* 调和共轭 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_HARMONIC_CONJUGATE,
            "构造调和共轭点",
            inputs, 3, PRESET_TYPE_POINT,
            "点 D 使得 (A,B;C,D) = -1",
            "O(1)", true, true);
    }

    {
        /* 费马点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_FERMAT_POINT,
            "构造三角形的费马点",
            inputs, 3, PRESET_TYPE_POINT,
            "到三个顶点距离之和最小的点（所有角小于120°时）",
            "O(1)", true, false);
    }

    {
        /* 拿破仑点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_NAPOLEON_POINT,
            "构造三角形的拿破仑点",
            inputs, 3, PRESET_TYPE_POINT,
            "向外作正三角形的中心构成的正三角形的中心",
            "O(1)", true, false);
    }

    {
        /* 布罗卡点 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_BROCARD_POINT,
            "构造三角形的布罗卡点",
            inputs, 3, PRESET_TYPE_POINT,
            "满足 ∠ΩAB = ∠ΩBC = ∠ΩCA 的点",
            "O(1)", true, false);
    }

    /* ============================================================
     * 多边形构造 (7个)
     * ============================================================ */

    {
        /* 正三角形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_EQUILATERAL_TRIANGLE,
            "通过一边构造正三角形",
            inputs, 2, PRESET_TYPE_POLYGON,
            "以线段 AB 为边的正三角形",
            "O(1)", true, false);
    }

    {
        /* 正方形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_SQUARE,
            "通过一边构造正方形",
            inputs, 2, PRESET_TYPE_POLYGON,
            "以线段 AB 为边的正方形",
            "O(1)", true, false);
    }

    {
        /* 正多边形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_INTEGER};
        REGISTER_BASIC(
            PRESET_REGULAR_POLYGON,
            "通过中心和顶点构造正n边形",
            inputs, 3, PRESET_TYPE_POLYGON,
            "中心为 O，一个顶点为 V 的正 n 边形",
            "O(n)", true, false);
    }

    {
        /* 平行四边形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_POINT};
        REGISTER_BASIC(
            PRESET_PARALLELOGRAM,
            "通过三点构造平行四边形",
            inputs, 3, PRESET_TYPE_POLYGON,
            "以 AB, AC 为邻边的平行四边形",
            "O(1)", true, false);
    }

    {
        /* 菱形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_RHOMBUS,
            "通过对角线构造菱形",
            inputs, 3, PRESET_TYPE_POLYGON,
            "对角线为 AB，另一条对角线一半长度为 d 的菱形",
            "O(1)", true, false);
    }

    {
        /* 矩形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_RECTANGLE,
            "通过一边和高构造矩形",
            inputs, 3, PRESET_TYPE_POLYGON,
            "一边为 AB，高为 h 的矩形",
            "O(1)", true, false);
    }

    {
        /* 梯形 */
        PresetType inputs[] = {PRESET_TYPE_POINT, PRESET_TYPE_POINT, 
                               PRESET_TYPE_POINT, PRESET_TYPE_SCALAR};
        REGISTER_BASIC(
            PRESET_TRAPEZOID,
            "通过底边、顶点和高构造梯形",
            inputs, 4, PRESET_TYPE_POLYGON,
            "底边为 AB，顶点为 C，高为 h 的梯形",
            "O(1)", true, false);
    }

    /* 检查是否所有预设都注册成功 */
    PRESET_INFO_LOG("基础几何预设注册完成: %d/%d", 
                    success_count, BASIC_GEOMETRY_PRESET_COUNT);
    
    return success_count == BASIC_GEOMETRY_PRESET_COUNT;
}

/* ============================================================
 * 模块信息接口
 * ============================================================ */

int preset_basic_geometry_count(void)
{
    return BASIC_GEOMETRY_PRESET_COUNT;
}

PresetCategory preset_basic_geometry_category(void)
{
    return PRESET_CATEGORY_CONSTRUCTION;
}

bool preset_basic_geometry_get_names(char ***out_names, int *out_count)
{
    PRESET_CHECK_NULL(out_names, error);
    PRESET_CHECK_NULL(out_count, error);
    
    /* 分配名称数组 */
    char **names = (char**)lv00_malloc(BASIC_GEOMETRY_PRESET_COUNT * sizeof(char*));
    PRESET_CHECK_NULL(names, error);
    
    /* 填充预设名称列表 */
    const char *preset_names[] = {
        /* 点的构造 */
        PRESET_POINT_FROM_COORDS,
        PRESET_MIDPOINT,
        PRESET_CENTROID,
        PRESET_CIRCUMCENTER,
        PRESET_INCENTER,
        PRESET_ORTHOCENTER,
        PRESET_EXCENTER,
        /* 线段操作 */
        PRESET_SEGMENT_FROM_POINTS,
        PRESET_PERPENDICULAR_BISECTOR,
        PRESET_POINT_ON_PERP_BISECTOR,
        /* 直线和射线 */
        PRESET_LINE_FROM_POINTS,
        PRESET_PARALLEL_LINE,
        PRESET_PERPENDICULAR_LINE,
        PRESET_RAY_FROM_POINTS,
        PRESET_ANGLE_BISECTOR,
        /* 圆的构造 */
        PRESET_CIRCLE_CENTER_RADIUS,
        PRESET_CIRCLE_THREE_POINTS,
        PRESET_TANGENT_FROM_POINT,
        PRESET_COMMON_TANGENTS,
        /* 交点计算 */
        PRESET_LINE_INTERSECTION,
        PRESET_LINE_CIRCLE_INTERSECTION,
        PRESET_CIRCLE_CIRCLE_INTERSECTION,
        PRESET_RADICAL_AXIS,
        /* 反射与对称 */
        PRESET_REFLECT_POINT_OVER_LINE,
        PRESET_REFLECT_POINT_OVER_POINT,
        PRESET_INVERT_POINT_IN_CIRCLE,
        /* 特殊点构造 */
        PRESET_POINT_DIVIDE_SEGMENT,
        PRESET_HARMONIC_CONJUGATE,
        PRESET_FERMAT_POINT,
        PRESET_NAPOLEON_POINT,
        PRESET_BROCARD_POINT,
        /* 多边形构造 */
        PRESET_EQUILATERAL_TRIANGLE,
        PRESET_SQUARE,
        PRESET_REGULAR_POLYGON,
        PRESET_PARALLELOGRAM,
        PRESET_RHOMBUS,
        PRESET_RECTANGLE,
        PRESET_TRAPEZOID,
    };
    
    int count = sizeof(preset_names) / sizeof(preset_names[0]);
    
    for (int i = 0; i < count; i++) {
        names[i] = lv00_strdup(preset_names[i]);
        if (names[i] == NULL) {
            /* 释放已分配的内存 */
            for (int j = 0; j < i; j++) {
                lv00_free(names[j]);
            }
            lv00_free(names);
            return false;
        }
    }
    
    *out_names = names;
    *out_count = count;
    return true;
    
error:
    return false;
}
