# Lv-00 EditorConfig
# https://editorconfig.org
# 统一跨编辑器代码风格配置

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{py}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
